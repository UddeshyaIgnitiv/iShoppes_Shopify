{% doc %}
  @prompt
    best seller carousel
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bestseller-carousel-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    font-family: inherit;
  }

  .ai-bestseller-carousel__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-bestseller-carousel__header-{{ ai_gen_id }} {
    text-align: left;
    margin-bottom: 30px;
    padding-left: 5px;
  }

  .ai-bestseller-carousel__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 500;
  }

  .ai-bestseller-carousel__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 5px 0 0;
  }

  .ai-bestseller-carousel__wrapper-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-bestseller-carousel__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.product_gap }}px;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 20px 5px 40px 5px; /* Added padding for shadow */
  }

  .ai-bestseller-carousel__track-{{ ai_gen_id }}::-webkit-scrollbar {
    display: none;
  }

  .ai-bestseller-carousel__product-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - {{ block.settings.product_gap }}px * ({{ block.settings.products_per_row_desktop | minus: 1 }})) / {{ block.settings.products_per_row_desktop }});
    min-width: 250px;
    position: relative;
  }

  .ai-bestseller-carousel__product-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
    padding: 25px;
    position: relative;
    box-sizing: border-box;
  }

  .ai-bestseller-carousel__product-card-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  }

  .ai-bestseller-carousel__card-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 20px;
    width: 100%;
  }

  .ai-bestseller-carousel__info-left-{{ ai_gen_id }} {
    flex: 1;
    padding-right: 15px;
  }

  .ai-bestseller-carousel__info-right-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    min-width: max-content;
  }

  .ai-bestseller-carousel__vendor-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.product_title_color }};
    margin-bottom: 5px;
    display: block;
    line-height: 1.2;
  }

  .ai-bestseller-carousel__product-title-{{ ai_gen_id }} {
    font-size: 14px;
    color: #666;
    margin: 0;
    font-weight: 400;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-bestseller-carousel__arrow-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
    color: #000;
    transition: transform 0.3s ease;
  }
  
  .ai-bestseller-carousel__product-card-{{ ai_gen_id }}:hover .ai-bestseller-carousel__arrow-icon-{{ ai_gen_id }} {
    transform: translateX(3px);
  }

  .ai-bestseller-carousel__price-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_size }}px;
    color: {{ block.settings.price_color }}; /* Blue in design: #0066cc */
    font-weight: 600;
  }

  .ai-bestseller-carousel__image-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    margin: 20px 0 40px;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
  }

  .ai-bestseller-carousel__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 80%;
    padding-bottom: 80%; /* Square aspect ratio relative to width */
  }

  .ai-bestseller-carousel__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply; /* Helps blend white backgrounds if image has one */
  }

  .ai-bestseller-carousel__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f9f9f9;
    border-radius: 8px;
  }

  .ai-bestseller-carousel__placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.2;
  }

  .ai-bestseller-carousel__actions-{{ ai_gen_id }} {
    display: flex;
    justify-content: flex-end;
    margin-top: auto;
  }

  .ai-bestseller-carousel__wishlist-btn-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 5px;
    color: #000;
    transition: transform 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-bestseller-carousel__wishlist-btn-{{ ai_gen_id }}:hover {
    transform: scale(1.1);
  }

  .ai-bestseller-carousel__nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 10px;
  }

  .ai-bestseller-carousel__nav-button-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_background }};
    color: {{ block.settings.nav_button_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-bestseller-carousel__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_background }};
  }

  .ai-bestseller-carousel__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-bestseller-carousel__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #666;
  }

  .ai-bestseller-carousel__empty-state-{{ ai_gen_id }} svg {
    width: 100px;
    height: 100px;
    margin-bottom: 20px;
    opacity: 0.3;
  }

  @media screen and (max-width: 768px) {
    .ai-bestseller-carousel__product-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.product_gap }}px * ({{ block.settings.products_per_row_mobile | minus: 1 }})) / {{ block.settings.products_per_row_mobile }});
    }

    .ai-bestseller-carousel__title-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .ai-bestseller-carousel__product-card-{{ ai_gen_id }} {
        padding: 15px;
    }
    
    .ai-bestseller-carousel__vendor-{{ ai_gen_id }} {
        font-size: 14px;
    }
    
    .ai-bestseller-carousel__product-title-{{ ai_gen_id }} {
        font-size: 12px;
    }
  }
{% endstyle %}

<bestseller-carousel-{{ ai_gen_id }} class="ai-bestseller-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bestseller-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-bestseller-carousel__header-{{ ai_gen_id }}">
        <h2 class="ai-bestseller-carousel__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% if block.settings.subheading != blank %}
          <p class="ai-bestseller-carousel__subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if block.settings.collection != blank and block.settings.collection.products.size > 0 %}
      <div class="ai-bestseller-carousel__wrapper-{{ ai_gen_id }}">
        <div class="ai-bestseller-carousel__track-{{ ai_gen_id }}" data-carousel-track>
          {% for product in block.settings.collection.products limit: block.settings.products_to_show %}
            <div class="ai-bestseller-carousel__product-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-bestseller-carousel__product-card-{{ ai_gen_id }}">
                
                <div class="ai-bestseller-carousel__card-header-{{ ai_gen_id }}">
                    <div class="ai-bestseller-carousel__info-left-{{ ai_gen_id }}">
                        <span class="ai-bestseller-carousel__vendor-{{ ai_gen_id }}">{{ product.vendor }}</span>
                        <h3 class="ai-bestseller-carousel__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                    </div>
                    <div class="ai-bestseller-carousel__info-right-{{ ai_gen_id }}">
                        <div class="ai-bestseller-carousel__arrow-icon-{{ ai_gen_id }}">
                           <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12"></line>
                                <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                        </div>
                        <div class="ai-bestseller-carousel__price-{{ ai_gen_id }}">
                            {{ product.price | money_without_trailing_zeros }}
                        </div>
                    </div>
                </div>

                <div class="ai-bestseller-carousel__image-container-{{ ai_gen_id }}">
                  <div class="ai-bestseller-carousel__image-wrapper-{{ ai_gen_id }}">
                    {% if product.featured_image %}
                      <img
                        src="{{ product.featured_image | image_url: width: 600 }}"
                        alt="{{ product.featured_image.alt | escape }}"
                        class="ai-bestseller-carousel__image-{{ ai_gen_id }}"
                        loading="lazy"
                        width="600"
                        height="600"
                      >
                    {% else %}
                      <div class="ai-bestseller-carousel__placeholder-{{ ai_gen_id }}">
                        {{ 'product-1' | placeholder_svg_tag }}
                      </div>
                    {% endif %}
                  </div>
                </div>
                
                <div class="ai-bestseller-carousel__actions-{{ ai_gen_id }}">
                    <button class="ai-bestseller-carousel__wishlist-btn-{{ ai_gen_id }}" type="button" aria-label="Add to wishlist">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                        </svg>
                    </button>
                </div>

              </a>
            </div>
          {% endfor %}
        </div>

        {% if block.settings.show_navigation %}
          <div class="ai-bestseller-carousel__nav-{{ ai_gen_id }}">
            <button
              class="ai-bestseller-carousel__nav-button-{{ ai_gen_id }}"
              data-carousel-prev
              aria-label="Previous products"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button
              class="ai-bestseller-carousel__nav-button-{{ ai_gen_id }}"
              data-carousel-next
              aria-label="Next products"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        {% endif %}
      </div>
    {% else %}
      <div class="ai-bestseller-carousel__empty-state-{{ ai_gen_id }}">
        {{ 'product-1' | placeholder_svg_tag }}
        <p>Select a collection to display bestselling products</p>
      </div>
    {% endif %}
  </div>
</bestseller-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class BestsellerCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('[data-carousel-track]');
        this.prevButton = this.querySelector('[data-carousel-prev]');
        this.nextButton = this.querySelector('[data-carousel-next]');
      }

      connectedCallback() {
        if (!this.track) return;

        this.setupNavigation();
        this.updateButtonStates();
        
        this.track.addEventListener('scroll', () => {
          this.updateButtonStates();
        });
        
        // Wishlist visual toggle
        this.querySelectorAll('.ai-bestseller-carousel__wishlist-btn-{{ ai_gen_id }}').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                e.stopPropagation();
                const svg = btn.querySelector('svg');
                if (btn.classList.contains('active')) {
                     btn.classList.remove('active');
                     svg.style.fill = 'none';
                     svg.style.stroke = 'currentColor';
                } else {
                     btn.classList.add('active');
                     svg.style.fill = 'currentColor';
                     svg.style.stroke = 'currentColor';
                }
            });
        });
      }

      setupNavigation() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => this.scroll('prev'));
        }
        
        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => this.scroll('next'));
        }
      }

      scroll(direction) {
        const scrollAmount = this.track.offsetWidth * 0.8;
        const currentScroll = this.track.scrollLeft;
        
        if (direction === 'prev') {
          this.track.scrollTo({
            left: currentScroll - scrollAmount,
            behavior: 'smooth'
          });
        } else {
          this.track.scrollTo({
            left: currentScroll + scrollAmount,
            behavior: 'smooth'
          });
        }
      }

      updateButtonStates() {
        if (!this.prevButton || !this.nextButton) return;

        const isAtStart = this.track.scrollLeft <= 0;
        const isAtEnd = this.track.scrollLeft + this.track.offsetWidth >= this.track.scrollWidth - 1;

        this.prevButton.disabled = isAtStart;
        this.nextButton.disabled = isAtEnd;
      }
    }

    customElements.define('bestseller-carousel-{{ ai_gen_id }}', BestsellerCarousel{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Bestseller carousel",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "RECOMMENDED"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 20,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "products_per_row_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "label": "Products per row (desktop)",
      "default": 4
    },
    {
      "type": "select",
      "id": "products_per_row_mobile",
      "label": "Products per row (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "product_gap",
      "min": 10,
      "max": 40,
      "step": 5,
      "label": "Gap between products",
      "unit": "px",
      "default": 30
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "color",
      "id": "nav_button_background",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "nav_button_color",
      "label": "Button icon color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "nav_button_hover_background",
      "label": "Button hover background",
      "default": "#333333"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#666666"
    },
    {
      "type": "color",
      "id": "product_title_color",
      "label": "Product Vendor/Title color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "price_color",
      "label": "Price color",
      "default": "#0066cc"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "range",
      "id": "subheading_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Subheading size",
      "default": 16
    },
    {
      "type": "range",
      "id": "price_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Price size",
      "default": 16
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 50
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Card border radius",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Bestseller carousel"
    }
  ]
}
{% endschema %}
