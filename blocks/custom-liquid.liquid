


{% assign custom_liquid = block.settings.custom_liquid | strip %}
{% if custom_liquid != blank %}
  <div>
    {{ block.settings.custom_liquid }}
  </div>
{% endif %}

{% schema %}
{
  "name": "t:names.custom_liquid",
  "tag": null,
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:settings.custom_liquid",
      "info": "t:info.custom_liquid"
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_liquid",
      "category": "t:categories.custom"
    }
  ]
}
{% endschema %}
