
<div class="product-meta-specs spacing-style" style="padding-bottom: 1rem; font-size: 1rem;">
  <div class="meta-row" style="margin-bottom: 0.25rem;">
    <span class="meta-label" style="font-weight: bold;">Made In:</span> <span class="meta-value">{{ product.metafields.custom.country_of_origin | default: '' }}</span>
  </div>
  <div class="meta-row" style="margin-bottom: 0.25rem;">
    <span class="meta-label" style="font-weight: bold;">SKU #:</span> <span class="meta-value">{{ product.selected_or_first_available_variant.sku | default: '' }}</span>
  </div>
  {% if product.selected_or_first_available_variant.option1 and product.selected_or_first_available_variant.option1 != 'Default Title' %}
  <div class="meta-row" style="margin-bottom: 1rem;">
    <span class="meta-label" style="font-weight: bold;">Size:</span> <span class="meta-value">{{ product.selected_or_first_available_variant.option1 | default: '' }}</span>
  </div>
  {%  endif %}
  <div class="meta-description">
    {% if product.description != blank %}
      {{ product.description }}
    {% endif %}
  </div>

</div>
{% schema %}
{
  "name": "Product Meta Specs",
  "settings": [],
  "presets": [
    {
      "name": "Product Meta Specs"
    }
  ]
}
{% endschema %}
