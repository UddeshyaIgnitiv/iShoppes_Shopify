<!doctype html>
<html
  class="no-js{% if request.design_mode %} shopify-design-mode{% endif %}"
  lang="{{ request.locale.iso_code }}"
>
  <head>
    {%- render 'stylesheets' -%}

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {% comment %} This a way to wait for main content to load when navigating to a new page so that the view transitions can work consistently {% endcomment %}
    <link
      rel="expect"
      href="#MainContent"
      blocking="render"
      id="view-transition-render-blocker"
    >
    <link rel="stylesheet" href="https://unpkg.com/flickity@2/dist/flickity.min.css">
    <script src="https://unpkg.com/flickity@2/dist/flickity.pkgd.min.js" defer></script>

    {%- render 'meta-tags' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-schemes' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}
  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}
    <div id="header-group">
      {% sections 'header-group' %}
    </div>

    <script
      src="{{ 'critical.js' | asset_url }}"
      type="module"
      async
      blocking="render"
    ></script>

    <main
      id="MainContent"
      class="content-for-layout"
      role="main"
      data-page-transition-enabled="{{ settings.page_transition_enabled }}"
      data-product-transition="{{ settings.transition_to_main_product }}"
      data-template="{{ template }}"
    >
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'search-modal' %}
    {% render 'popup-newsletter' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}
    <script>
      document.querySelectorAll('.terminal-select-btn').forEach(el => {
        el.addEventListener('click', function () {
          document.getElementById('terminal-selection-div').style.display = 'block';
        });
    });
    document.querySelectorAll('.modal-close-dep').forEach(el => {
      el.addEventListener('click', function () {
        document.getElementById('terminal-selection-div').style.display = 'none';
      });
    });
    
    </script>
    <script>
    const API_BASE = 'https://ignitiv.axiomconsulting.in';
    const airportSelect = document.getElementById('airportselect');
    const airlineSelect = document.getElementById('airlineselect');
    const flightSelect = document.getElementById('flightselect');
    const destinationSelect = document.getElementById('destinationselect');

    function resetSelect(select, placeholder = '--') {
        select.innerHTML = `<option value="">${placeholder}</option>`;
        select.disabled = true;
    }

    function populateSelect(select, items, valueKey, labelKey) {
        resetSelect(select);
        items.forEach(item => {
            const opt = document.createElement('option');
            opt.value = item[valueKey];
            opt.textContent = item[labelKey];
            select.appendChild(opt);
        });
        select.disabled = false;
    }

    // Load airlines when airport changes
    airportSelect.addEventListener('change', async () => {
        resetSelect(airlineSelect);
        resetSelect(flightSelect);
        resetSelect(destinationSelect);

        if (!airportSelect.value) return;

        const res = await fetch(`${API_BASE}/airports/${airportSelect.value}/airlines`);
        const airlines = await res.json();

        populateSelect(airlineSelect, airlines, 'id', 'airline_name');
    });

    // Load flights when airline changes
    airlineSelect.addEventListener('change', async () => {
        resetSelect(flightSelect);
        resetSelect(destinationSelect);
    
        if (!airlineSelect.value || !airportSelect.value) return;
    
        const res = await fetch(
            `${API_BASE}/airlines/${airlineSelect.value}/terminals/${airportSelect.value}/flights`
        );
    
        const flights = await res.json();
        populateSelect(flightSelect, flights, 'id', 'flight_number');
    });

    // Load destinations when flight changes
    flightSelect.addEventListener('change', async () => {
        resetSelect(destinationSelect);

        if (!flightSelect.value) return;

        const res = await fetch(`${API_BASE}/flights/${flightSelect.value}/destinations`);
        const destinations = await res.json();

        populateSelect(destinationSelect, destinations, 'id', 'name');
    });

    // Departure time validation
    const dateInput = document.getElementById('departuredate');
    const hoursSelect = document.getElementById('departurehours');
    const minsSelect = document.getElementById('departureminutes');
    const meridiemSelect = document.getElementById('departuremeridiem');
    const errorBox = document.getElementById('departureDateError');
    const form = document.querySelector('#terminal-selection-div form');

    function parseMinutes(val) {
        if (!val) return 0;
        return parseInt(val.replace('min_', ''), 10);
    }

    function getDepartureDateTime() {
        if (!dateInput.value || !hoursSelect.value || !meridiemSelect.value) {
            return null;
        }

        let hrs = parseInt(hoursSelect.value, 10);
        const mins = parseMinutes(minsSelect.value);

        // Convert to 24hr format
        if (meridiemSelect.value === 'PM' && hrs !== 12) hrs += 12;
        if (meridiemSelect.value === 'AM' && hrs === 12) hrs = 0;

        const dt = new Date(dateInput.value);
        dt.setHours(hrs, mins, 0, 0);

        return dt;
    }

    function validateDepartureTime() {
        const departureDT = getDepartureDateTime();
        errorBox.style.display = 'none';

        if (!departureDT) return true;

        const now = new Date();
        const diff = departureDT - now;
        const hoursUntilDeparture = diff / (1000 * 60 * 60);

        // Must be between 2-72 hours from now
        if (hoursUntilDeparture < 2 || hoursUntilDeparture > 72) {
            errorBox.textContent = 'Ordering is available for flights departing in 2 hours from order placement and up to 72 hours.';
            errorBox.style.display = 'block';
            return false;
        }

        return true;
    }

    // Check validation on field changes
    [dateInput, hoursSelect, minsSelect, meridiemSelect].forEach(el => {
        el.addEventListener('change', validateDepartureTime);
    });

    form.addEventListener('submit', function(e) {
        if (!validateDepartureTime()) {
            e.preventDefault();
        }
    });

    // Save in cookies and reload
    function setCookie(name, value, hrs = 24) {
        const d = new Date();
        d.setTime(d.getTime() + (hrs * 60 * 60 * 1000));
        document.cookie = name + "=" + encodeURIComponent(value) + ";expires=" + d.toUTCString() + ";path=/";
    }

    form.addEventListener('submit', function(e) {
        if (!validateDepartureTime()) return;

        e.preventDefault();

        // Save departure details to cookies
        setCookie('departure_date', dateInput.value);
        setCookie('departure_hours', hoursSelect.value);
        setCookie('departure_minutes', minsSelect.value);
        setCookie('departure_meridiem', meridiemSelect.value);

        window.location.reload();
    });
    </script>
    <script>
      (function () {
        try {
          function setCookie(name, value, hrs = 24) {
            try {
              const d = new Date();
              d.setTime(d.getTime() + hrs * 60 * 60 * 1000);
              document.cookie = name + "=" + encodeURIComponent(value) + ";expires=" + d.toUTCString() + ";path=/";
            } catch (e) {}
          }

          function getCookie(name) {
            try {
              const match = document.cookie.match(new RegExp('(^| )' + name + '=([^;]+)'));
              return match ? decodeURIComponent(match[2]) : null;
            } catch (e) {
              return null;
            }
          }
          
          //SAVE DATA TO SHOPIFY CART
          function saveToShopifyCart(properties) {
            try {
              fetch('/cart/update.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  attributes: properties
                })
              });
            } catch (e) {}
          }

          function collectDepartureData() {
            try {
              return {
                Airport: airportSelect?.options[airportSelect.selectedIndex]?.text || '',
                Airline: airlineselect?.options[airlineselect.selectedIndex]?.text || '',
                Flight: flightselect?.options[flightselect.selectedIndex]?.text || '',
                Destination: destinationselect?.options[destinationselect.selectedIndex]?.text || '',
                DepartureDate: departuredate?.value || '',
                DepartureTime: `${departurehours?.value || ''}:${departureminutes?.value || ''} ${departuremeridiem?.value || ''}`,
                Seat: seatno?.value || ''
              };
            } catch (e) {
              return {};
            }
          }

          const form = document.querySelector('#terminal-selection-div form');

          if (form) {
            form.addEventListener('submit', function () {
              try {
                const data = collectDepartureData();

                Object.keys(data).forEach(key => {
                  if (data[key]) setCookie(key, data[key], 48);
                });

                saveToShopifyCart(data);

              } catch (e) {}
            });
          }

          function updateHeaderTerminalInfo() {
            try {
              const airport = getCookie('Airport');
              if (!airport) return;

              const container = document.querySelector('.header-terminalInfoDefault.terminal-select-btn');
              if (!container) return;

              const img = container.querySelector('img');
              if (img) img.remove();

              let label = container.querySelector('.airport-label');
              if (!label) {
                label = document.createElement('span');
                label.className = 'airport-label';
                label.style.fontWeight = '600';
                container.appendChild(label);
              }

              label.textContent = airport;
            } catch (e) {}
          }

          (function () {
            let raf = null;

            const observer = new MutationObserver(() => {
              cancelAnimationFrame(raf);
              raf = requestAnimationFrame(updateHeaderTerminalInfo);
            });

            observer.observe(document.documentElement, {
              childList: true,
              subtree: true
            });

            document.addEventListener('DOMContentLoaded', function () {
              updateHeaderTerminalInfo();
            });
          })();

          {% comment %} document.addEventListener('DOMContentLoaded', updateHeaderTerminalInfo); {% endcomment %}

        } catch (e) {
          // Absolute fail-safe
          console.warn('Departure script skipped safely');
        }
      })();
      </script>
  </body>
</html>
