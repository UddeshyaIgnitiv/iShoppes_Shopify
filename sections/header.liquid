<script type="text/javascript">
// ===== MOBILE FUNCTIONALITY ONLY =====
const mobileNavToggles = document.querySelectorAll('.mobile-nav-toggle');
const navOverlay = document.querySelector('.nav-overlay');
const searchToggle = document.querySelector('.mobile-search-toggle');
const searchBar = document.querySelector('.mobile-search-bar');
const searchClose = document.querySelector('.search-close');

// Menu Toggle - Connect bottom row menu button to header drawer
if (mobileNavToggles.length > 0) {
  mobileNavToggles.forEach(toggle => {
    toggle.addEventListener('click', function(e) {
      e.preventDefault();
      // Try to find the header-drawer custom element first
      const headerDrawer = document.querySelector('header-drawer');
      if (headerDrawer && typeof headerDrawer.toggle === 'function') {
        headerDrawer.toggle();
      } else {
        // Fallback to clicking the summary if component not upgraded yet
        const headerDrawerSummary = document.querySelector('#Details-menu-drawer-container summary');
        if (headerDrawerSummary) {
          headerDrawerSummary.click();
        }
      }
    });
  });
}

// Search Toggle
if (searchToggle && searchBar) {
  searchToggle.addEventListener('click', function() {
    searchBar.style.display = 'block';
    setTimeout(() => {
      const searchInput = searchBar.querySelector('input');
      if (searchInput) searchInput.focus();
    }, 100);
  });
}

if (searchClose) {
  searchClose.addEventListener('click', function() {
    searchBar.style.display = 'none';
  });
}

// Close search when clicking outside
document.addEventListener('click', function(event) {
  if (searchBar && searchBar.style.display === 'block') {
    if (!searchBar.contains(event.target) && 
        event.target !== searchToggle && 
        !searchToggle.contains(event.target)) {
      searchBar.style.display = 'none';
    }
  }
});

// Escape key to close search
document.addEventListener('keydown', function(event) {
  if (event.key === 'Escape') {
    if (searchBar && searchBar.style.display === 'block') {
      searchBar.style.display = 'none';
    }
  }
});

// Sync the mobile nav toggle state with the header drawer state
const headerDrawerDetails = document.querySelector('#Details-menu-drawer-container');
if (headerDrawerDetails && mobileNavToggles.length > 0) {
  headerDrawerDetails.addEventListener('toggle', function() {
    const isOpen = this.open;
    mobileNavToggles.forEach(toggle => {
      toggle.setAttribute('aria-expanded', isOpen);
    });
    
    // Update overlay
    if (navOverlay) {
      if (isOpen) {
        navOverlay.classList.add('active');
      } else {
        navOverlay.classList.remove('active');
      }
    }
  });
}

// Close drawer when clicking on overlay
if (navOverlay) {
  navOverlay.addEventListener('click', function() {
    const headerDrawerDetails = document.querySelector('#Details-menu-drawer-container');
    if (headerDrawerDetails && headerDrawerDetails.open) {
      // Check if we can use close method on component
      const headerDrawer = document.querySelector('header-drawer');
      if (headerDrawer && typeof headerDrawer.close === 'function') {
        headerDrawer.close();
      } else {
        headerDrawerDetails.removeAttribute('open');
      }
    }
  });
}

// Departure form validation for required fields
const getFieldMessage = (fieldEl) => {
  if (!fieldEl) return null;
  const fieldRoot = fieldEl.closest('.field-root-b-C');
  if (!fieldRoot) return null;
  return fieldRoot.querySelector('.message-root-6k6');
};

const setError = (messageEl, message) => {
  if (!messageEl) return;
  messageEl.textContent = message || '';
  messageEl.style.color = message ? 'rgb(255, 77, 79)' : '';
  if (messageEl.id === 'departureDateError') {
    messageEl.style.display = message ? 'block' : 'none';
  }
};

const isSelectValueInvalid = (value) => {
  if (!value) return true;
  const normalized = value.trim().toLowerCase();
  return normalized === '--' || normalized.startsWith('select');
};

const resetDepartureForm = (departureForm) => {
  if (!departureForm) return;

  const messages = departureForm.querySelectorAll('.message-root-6k6');
  messages.forEach(messageEl => setError(messageEl, ''));

  const departureDateError = departureForm.querySelector('#departureDateError');
  if (departureDateError) {
    setError(departureDateError, '');
  }

  const selectFields = departureForm.querySelectorAll('select');
  selectFields.forEach(selectEl => {
    if (selectEl.options.length > 0) {
      selectEl.selectedIndex = 0;
    }
  });

  const textInputs = departureForm.querySelectorAll('input[type="text"], input[type="date"]');
  textInputs.forEach(inputEl => {
    inputEl.value = '';
  });

  const toggleInputs = departureForm.querySelectorAll('input[type="checkbox"], input[type="radio"]');
  toggleInputs.forEach(inputEl => {
    inputEl.checked = false;
  });
};

const validateDepartureForm = (departureForm) => {
  if (!departureForm) return true;

  let hasErrors = false;
  const airportSelect = departureForm.querySelector('#airportselect');
  const airlineSelect = departureForm.querySelector('#airlineselect');
  const flightSelect = departureForm.querySelector('#flightselect');
  const destinationSelect = departureForm.querySelector('#destinationselect');
  const departureDate = departureForm.querySelector('#departuredate');
  const departureHours = departureForm.querySelector('#departurehours');
  const departureMinutes = departureForm.querySelector('#departureminutes');
  const departureMeridiem = departureForm.querySelector('#departuremeridiem');
  const departureDateError = departureForm.querySelector('#departureDateError');

  if (airportSelect) {
    const messageEl = getFieldMessage(airportSelect);
    if (isSelectValueInvalid(airportSelect.value)) {
      setError(messageEl, 'Airport is required.');
      hasErrors = true;
    } else {
      setError(messageEl, '');
    }
  }

  if (airlineSelect) {
    const messageEl = getFieldMessage(airlineSelect);
    if (isSelectValueInvalid(airlineSelect.value)) {
      setError(messageEl, 'Airline is required.');
      hasErrors = true;
    } else {
      setError(messageEl, '');
    }
  }

  if (flightSelect) {
    const messageEl = getFieldMessage(flightSelect);
    if (isSelectValueInvalid(flightSelect.value)) {
      setError(messageEl, 'Flight is required.');
      hasErrors = true;
    } else {
      setError(messageEl, '');
    }
  }

  if (destinationSelect) {
    const messageEl = getFieldMessage(destinationSelect);
    if (isSelectValueInvalid(destinationSelect.value)) {
      setError(messageEl, 'Destination is required.');
      hasErrors = true;
    } else {
      setError(messageEl, '');
    }
  }

  if (departureDate) {
    const messageEl = departureDateError || getFieldMessage(departureDate);
    if (!departureDate.value) {
      setError(messageEl, 'Departure date is required.');
      hasErrors = true;
    } else {
      setError(messageEl, '');
    }
  }

  if (departureHours || departureMinutes || departureMeridiem) {
    const timeMessageEl =
      getFieldMessage(departureHours) ||
      getFieldMessage(departureMinutes) ||
      getFieldMessage(departureMeridiem);
    const hoursInvalid = departureHours && !departureHours.value;
    const minutesInvalid = departureMinutes && !departureMinutes.value;
    if (hoursInvalid || minutesInvalid) {
      setError(timeMessageEl, 'Departure time is required.');
      hasErrors = true;
    } else {
      setError(timeMessageEl, '');
    }
  }

  return !hasErrors;
};

document.addEventListener(
  'submit',
  function(event) {
    const form = event.target && event.target.closest('.account-form');
    if (!form) return;
    if (!validateDepartureForm(form)) {
      event.preventDefault();
      event.stopPropagation();
    }
  },
  true
);

document.addEventListener('change', function(event) {
  const fieldEl = event.target;
  if (!fieldEl || !fieldEl.closest('.account-form')) return;
  const messageEl =
    fieldEl.id === 'departuredate'
      ? fieldEl.closest('.account-form').querySelector('#departureDateError') || getFieldMessage(fieldEl)
      : getFieldMessage(fieldEl);
  setError(messageEl, '');
});

document.addEventListener(
  'reset',
  function(event) {
    const form = event.target && event.target.closest('.account-form');
    if (!form) return;
    window.setTimeout(() => resetDepartureForm(form), 0);
  },
  true
);
</script>

