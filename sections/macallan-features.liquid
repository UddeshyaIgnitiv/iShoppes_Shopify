{% schema %}
{
  "name": "Macallan Features",
  "tag": "section",
  "class": "macallan-features-section",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "feature_row",
      "name": "Feature Row",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Feature Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Description of the feature goes here."
        },
        {
          "type": "select",
          "id": "layout",
          "label": "Image Position",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Macallan Features",
      "blocks": [
        {
          "type": "feature_row",
          "settings": {
            "layout": "left",
            "heading": "SHERRY SEASONED OAK CASK",
            "text": "The exceptional oak casks are meticulously seasoned with the finest sherry from Jerez de la Frontera, Spain. Once perfectly matured, they embark on a tranquil journey to Speyside, Scotland, where they are then filled with the new make spirit."
          }
        },
        {
          "type": "feature_row",
          "settings": {
            "layout": "right",
            "heading": "NATURAL COLOUR",
            "text": "As the whisky ages in The Macallan's sherry seasoned oak casks, they take on a spectrum of natural hues and tones that deepen with age."
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% style %}
  .macallan-features-section {
    background-color: {{ section.settings.bg_color }};
  }

  .macallan-feature-row {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    min-height: 500px; /* Ensure substantial height */
  }

  .macallan-feature-row.layout-right {
    flex-direction: row-reverse;
  }

  .macallan-feature-image {
    flex: 0 0 50%;
    width: 50%;
    position: relative;
    min-height: 400px;
  }

  .macallan-feature-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: absolute;
    top: 0;
    left: 0;
  }

  .macallan-feature-content {
    flex: 0 0 50%;
    width: 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 80px;
    box-sizing: border-box;
  }

  .macallan-feature-text-wrapper {
    max-width: 450px;
    text-align: center;
  }

  .macallan-feature-heading {
    font-family: "NewFrank", sans-serif;
    font-size: 24px;
    font-weight: 700;
    text-transform: uppercase;
    color: #111;
    margin: 0 0 30px 0;
    letter-spacing: 0.5px;
    line-height: 1.2;
  }

  .macallan-feature-description {
    font-family: "NewFrank", sans-serif;
    font-size: 16px;
    line-height: 1.6;
    color: #333;
    text-align: left; /* Text description is left aligned in the image somewhat, but usually blocks like this center everything. Looking at image closely: Heading is centered relative to text block, text block is justified or left aligned. Let's stick to left for paragraph, but the wrapper is centered in the 50% block. */
  }

  .featured-macallan-colour-collection {
    padding-left:40px;
    padding-right:40px;
  }

  @media screen and (max-width: 1024px) {
    .macallan-feature-content {
        padding: 40px;
    }
    .macallan-feature-heading {
        font-size: 20px;
    }
  }

  @media screen and (max-width: 768px) {
    .macallan-feature-row, 
    .macallan-feature-row.layout-right {
      flex-direction: column;
    }
    
    .macallan-feature-image,
    .macallan-feature-content {
      flex: 0 0 100%;
      width: 100%;
    }
    
    .macallan-feature-image {
      height: 350px;
      min-height: 350px;
    }
    
    .macallan-feature-content {
      padding: 50px 20px;
      min-height: auto;
    }
    .featured-macallan-colour-collection {
      padding-left:0px;
      padding-right:0px;
    }
  }
{% endstyle %}

<div class="featured-macallan-colour-collection" style="padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;">
  {% for block in section.blocks %}
    <div class="macallan-feature-row layout-{{ block.settings.layout }}" {{ block.shopify_attributes }}>
      
      <div class="macallan-feature-image">
        {% if block.settings.image != blank %}
          <img
            src="{{ block.settings.image | image_url: width: 1500 }}"
            alt="{{ block.settings.heading | escape }}"
            loading="lazy"
            width="1500"
            height="1000"
          >
        {% else %}
           <div style="background-color: #f4f4f4; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: #999;">
             <p>Select Image</p>
           </div>
        {% endif %}
      </div>

      <div class="macallan-feature-content">
        <div class="macallan-feature-text-wrapper">
          {% if block.settings.heading != blank %}
            <h2 class="macallan-feature-heading">{{ block.settings.heading }}</h2>
          {% endif %}
          
          {% if block.settings.text != blank %}
            <div class="macallan-feature-description">
              {{ block.settings.text | newline_to_br }}
            </div>
          {% endif %}
        </div>
      </div>

    </div>
  {% endfor %}
</div>