{% schema %}
{
  "name": "New Arrivals",
  "tag": "section",
  "class": "new-arrivals",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Product Tag",
      "default": "New Arrivals",
      "info": "Products with this tag will be displayed"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Maximum products to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "New Arrivals",
      "category": "Custom",
      "blocks": []
    }
  ]
}
{% endschema %}

{% style %}
  .new-arrivals {
    padding: 10px 20px;
    background: #fff;
  }
  .new-arrivals h2 {
    font-size: 28px;
    font-weight: 500;
    margin-bottom: 30px;
    margin-left: 20px;
    text-transform: uppercase;
  }
  .product-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    justify-content: center;
  }
  .card {
    background: #fff;
    width: 320px;
    position: relative;
    transition: 0.3s ease;
    padding: 15px 30px;
    box-shadow: 0 0 20px 0 rgba(6, 0, 0, 0.08);
    border-radius: 30px;
    min-height: 475px;
    padding-bottom: 90px;
  }
  .card:hover {
    transform: translateY(-5px);
  }
  .card a {
    text-decoration: none;
    color: inherit;
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }
  .vendor {
    font-weight: 600;
    font-size: 18px;
  }
  .product-details {
    display: flex;
    justify-content: space-between;
  }
  .subtitle {
    font-size: 14px;
    color: #555;
    margin-bottom: 6px;
  }
  .price {
    color: #007bff;
    font-weight: 500;
    font-size: 14px;
    margin-bottom: 15px;
  }
  .card img {
    display: block;
    max-width: 100%;
    max-height: 200px;
    height: 200px;
    width: 300px;
    min-height: 200px;
    object-fit: contain;
    margin: 0 auto;
  }
  .arrow {
    font-size: 18px;
    color: #111;
  }
  .wishlist {
    position: absolute;
    bottom: 0px;
    right: 24px;
    font-size: 40px;
    color: #111;
    cursor: pointer;
  }
  .no-products-message {
    text-align: center;
    padding: 40px;
    color: #666;
    font-size: 18px;
  }
{% endstyle %}

<section class="new-arrivals">
  <div class="page-width">
    <h2>{{ section.settings.heading }}</h2>
    {% comment %} Get products with the specified tag {% endcomment %}
    {% assign tag_to_filter = section.settings.tag | default: 'new arrivals' %}
    {% assign product_limit = section.settings.product_limit | default: 4 %}
    
    {% assign tagged_products = '' | split: '' %}
    
    {% comment %} Try to find a collection with the handle of the tag first {% endcomment %}
    {% assign collection_handle = tag_to_filter | handleize %}
    {% assign target_collection = collections[collection_handle] %}
    
    {% if target_collection != blank and target_collection.products.size > 0 %}
      {% assign tagged_products = target_collection.products %}
    {% else %}
      {% comment %} Fallback: Filter all products by tag {% endcomment %}
      {% for product in collections.all.products %}
        {% if product.tags contains tag_to_filter %}
          {% assign tagged_products = tagged_products | push: product %}
        {% endif %}
        {% if tagged_products.size >= product_limit %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% endif %}
    
    <div class="product-grid">
      {% if tagged_products.size == 0 %}
        {% comment %} Fallback to manually added products if no tagged products found {% endcomment %}
        {% if section.blocks.size == 0 %}
          <div class="no-products-message">
            <p>No products found with the "{{ tag_to_filter }}" tag. Please add the tag to some products.</p>
            <p><small>Debug: Using tag "{{ tag_to_filter }}", limit {{ product_limit }}</small></p>
          </div>
        {% else %}
          {% comment %} Display manually added products as fallback {% endcomment %}
          {%- for block in section.blocks -%}
            {%- assign product = all_products[block.settings.product] -%}
            {% if product != blank %}
              <div class="card" {{ block.shopify_attributes }}>
                <a href="{{ product.url }}">
                  <div class="card-header">
                    <div class="vendor">{{ product.vendor | default: "Brand" }}</div>
                    <div class="arrow">→</div>
                  </div>
                  <div class="product-details">
                    <div class="subtitle">{{ product.title }}</div>
                    <div class="price">{{ product.price | money }}</div>
                  </div>
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 300 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      width="300"
                      height="200"
                      loading="lazy"
                    >
                  {% else %}
                    <div style="width: 300px; height: 200px; background: #f5f5f5; display: flex; align-items: center; justify-content: center;">
                      No image
                    </div>
                  {% endif %}
                </a>
                <div class="wishlist">♡</div>
              </div>
            {% endif %}
          {%- endfor -%}
        {% endif %}
      {% else %}
        {% comment %} Display tagged products {% endcomment %}
        {% for product in tagged_products limit: product_limit %}
          <div class="card">
            <a href="{{ product.url }}">
              <div class="card-header">
                <div class="vendor">{{ product.vendor | default: "Brand" }}</div>
                <div class="arrow">→</div>
              </div>
              <div class="product-details">
                <div class="subtitle">{{ product.title }}</div>
                <div class="price">{{ product.price | money }}</div>
              </div>
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 300 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  width="300"
                  height="200"
                  loading="lazy"
                >
              {% else %}
                <div style="width: 300px; height: 200px; background: #f5f5f5; display: flex; align-items: center; justify-content: center;">
                  No image
                </div>
              {% endif %}
            </a>
            <div class="wishlist">♡</div>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>