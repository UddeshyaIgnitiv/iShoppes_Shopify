{% schema %}
{
  "name": "New Arrivals",
  "tag": "section",
  "class": "new-arrivals",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Product Tag",
      "default": "New Arrivals",
      "info": "Products with this tag will be displayed"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Maximum products to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "New Arrivals",
      "category": "Custom",
      "blocks": []
    }
  ]
}
{% endschema %}

{% style %}
  .new-arrivals {
    padding: 10px 20px;
    background: #fff;
  }
  .new-arrivals h2 {
    font-size: 28px;
    font-weight: 500;
    margin-bottom: 30px;
    margin-left: 20px;
    text-transform: uppercase;
  }
  .product-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    justify-content: center;
  }
  @media screen and (max-width: 800px) {
    .product-grid {
      display: flex !important;
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 1rem;
      scrollbar-width: none;
      -ms-overflow-style: none;
      gap: 1rem;
      justify-content: flex-start;
    }
    .product-grid::-webkit-scrollbar {
      display: none;
    }
    .product-grid > * {
      scroll-snap-align: start;
    }
    @media screen and (max-width: 599px) {
      .product-grid > * {
        flex: 0 0 100% !important;
        width: 100% !important;
        min-width: 100% !important;
        max-width: 100% !important;
      }
    }
    @media screen and (min-width: 600px) and (max-width: 800px) {
      .product-grid > * {
        flex: 0 0 calc((100% - 2rem) / 3) !important;
        width: auto !important;
        min-width: 0 !important;
        max-width: none !important;
      }
    }
    .card {
      width: 100%;
    }
    .new-arrivals h2 {
      text-align: center;
    }
  }

  /* place injected wishlist wrapper above card link */
  [class^="Vtl-WishlistIcon__Wrapper--Id-"] {
    position: absolute;
    bottom: 10px;
    right: 10px;
    z-index: 50;
  }

  /* if your <a> covers the card, keep it under the wishlist */
  .card > a.card-link {
    position: relative;
    z-index: 1;
  }

  /* ensure the injected button can receive clicks */
  .Vtl-WishlistButton__WishlistIconButton,
  .Vtl-WishlistButton__WishlistIconButton * {
    pointer-events: auto;
    position: initial !important;
  }
  .card {
    background: #fff;
    width: 320px;
    position: relative;
    transition: 0.3s ease;
    padding: 15px 30px;
    box-shadow: 0 0 20px 0 rgba(6, 0, 0, 0.08);
    border-radius: 30px;
    min-height: 400px;
    padding-bottom: 90px;
  }
  .card:hover {
    transform: translateY(-5px);
  }
  .card a {
    text-decoration: none;
    color: inherit;
  }
  .card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }
  .vendor {
    font-weight: 600;
    font-size: 18px;
  }
  .product-details {
    display: flex;
    justify-content: space-between;
  }
  .subtitle {
    font-size: 14px;
    color: #555;
    margin-bottom: 6px;
  }
  .price {
    color: #007bff;
    font-weight: 500;
    font-size: 14px;
    margin-bottom: 15px;
  }
  .card img {
    display: block;
    max-width: 100%;
    max-height: 200px;
    height: 200px;
    width: 300px;
    min-height: 200px;
    object-fit: contain;
    margin: 0 auto;
  }
  .arrow {
    font-size: 18px;
    color: #111;
  }
  .no-products-message {
    text-align: center;
    padding: 40px;
    color: #666;
    font-size: 18px;
  }
  .mobile-dots-container {
    display: none;
    justify-content: center;
    gap: 8px;
    margin-top: 15px;
  }
  .mobile-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #ccc;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: background-color 0.3s;
  }
  .mobile-dot.active {
    background-color: #333;
    width: 20px;
    border-radius: 4px;
  }
  @media screen and (max-width: 800px) {
    .mobile-dots-container {
      display: flex;
    }
  }

  /* Desktop Slider Styles */
  .product-grid.slider-active {
    flex-wrap: nowrap;
    overflow-x: auto;
    justify-content: flex-start;
    scroll-snap-type: x mandatory;
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE/Edge */
  }
  
  .product-grid.slider-active::-webkit-scrollbar {
    display: none;
  }

  .product-grid.slider-active .card {
    flex: 0 0 calc((100% - 90px) / 4); /* 30px gap * 3 = 90px */
    width: auto;
    min-width: 0;
    scroll-snap-align: start;
  }

  @media screen and (max-width: 800px) {
    .product-grid.slider-active .card {
      flex: 0 0 calc((100% - 60px) / 3); /* 30px gap * 2 = 60px */
    }
  }

  .slider-controls-desktop {
    display: none;
    justify-content: flex-start;
    gap: 12px;
    margin-top: 20px;
    padding-left: 20px;
  }

  .slider-active ~ .slider-controls-desktop {
    display: flex;
  }

  .slider-btn {
    background: transparent;
    border: 1px solid #000;
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    color: #000;
    padding: 0;
    z-index: 2;
  }
  
  .slider-btn:hover {
    background: #000;
    color: #fff;
  }
  
  .slider-btn svg {
    width: 24px;
    height: 24px;
  }

  @media screen and (max-width: 800px) {
    .slider-controls-desktop {
      display: none !important;
    }
  }
{% endstyle %}

<section class="new-arrivals">
  <div class="page-width">
    <h2>{{ section.settings.heading }}</h2>
    
    {% comment %} Get products with the specified tag {% endcomment %}
    {% assign tag_to_filter = section.settings.tag | default: 'new arrivals' %}
    {% assign product_limit = section.settings.product_limit | default: 4 %}
    
    {% assign tagged_products = '' | split: '' %}
    
    {% comment %} Try to find a collection with the handle of the tag first {% endcomment %}
    {% assign collection_handle = tag_to_filter | handleize %}
    {% assign target_collection = collections[collection_handle] %}
    
    {% if target_collection != blank and target_collection.products.size > 0 %}
      {% assign tagged_products = target_collection.products %}
    {% else %}
      {% comment %} Fallback: Filter all products by tag {% endcomment %}
      {% for product in collections.all.products %}
        {% if product.tags contains tag_to_filter %}
          {% assign tagged_products = tagged_products | push: product %}
        {% endif %}
        {% if tagged_products.size >= product_limit %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% endif %}

    {% liquid
      assign display_limit = section.settings.product_limit
      assign actual_count = 0
      if tagged_products.size > 0
        assign actual_count = tagged_products.size
      else
        assign actual_count = section.blocks.size
      endif
      
      assign show_count = actual_count
      if actual_count > display_limit
        assign show_count = display_limit
      endif

      assign enable_slider = false
      if show_count > 4
        assign enable_slider = true
      endif
    %}
    
    <div class="product-grid {% if enable_slider %}slider-active{% endif %}" id="NewArrivals-{{ section.id }}">
      {% if tagged_products.size == 0 %}
        {% comment %} Fallback to manually added products if no tagged products found {% endcomment %}
        {% if section.blocks.size == 0 %}
          <div class="no-products-message">
            <p>No products found with the "{{ tag_to_filter }}" tag. Please add the tag to some products.</p>
            <p><small>Debug: Using tag "{{ tag_to_filter }}", limit {{ product_limit }}</small></p>
          </div>
        {% else %}
          {% comment %} Display manually added products as fallback {% endcomment %}
          {%- for block in section.blocks -%}
            {%- assign product = all_products[block.settings.product] -%}
            {% if product != blank %}
              <div class="card" {{ block.shopify_attributes }} data-index="{{ forloop.index0 }}">
                <a href="{{ product.url }}">
                  <div class="card-header">
                    <div class="vendor">{{ product.vendor | default: "Brand" }}</div>
                    <div class="arrow">→</div>
                  </div>
                  <div class="product-details">
                    <div class="subtitle">{{ product.title }}</div>
                    <div class="price">{{ product.price | money }}</div>
                  </div>
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 300 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      width="300"
                      height="200"
                      loading="lazy"
                    >
                  {% else %}
                    <div style="height: 200px; display: flex; align-items: center; justify-content: center;">
                      No image
                    </div>
                  {% endif %}
                </a>
                <div class="Vtl-WishlistIcon__Wrapper--Id-{{ product.id }}-{{ product.handle }}"></div>
                <!--<div class="wishlist">
                  <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-icon-P1l">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                  </svg>
                </div>-->
              </div>
            {% endif %}
          {%- endfor -%}
        {% endif %}
      {% else %}
        {% comment %} Display tagged products {% endcomment %}
        {% for product in tagged_products limit: product_limit %}
          <div class="card" data-index="{{ forloop.index0 }}">
            <a href="{{ product.url }}">
              <div class="card-header">
                <div class="vendor">{{ product.vendor | default: "Brand" }}</div>
                <div class="arrow">→</div>
              </div>
              <div class="product-details">
                <div class="subtitle">{{ product.title }}</div>
                <div class="price">{{ product.price | money }}</div>
              </div>
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 300 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  width="300"
                  height="200"
                  loading="lazy"
                >
              {% else %}
                <div style="height: 200px; display: flex; align-items: center; justify-content: center;">
                  No image
                </div>
              {% endif %}
            </a>
            <div class="Vtl-WishlistIcon__Wrapper--Id-{{ product.id }}-{{ product.handle }}"></div>
            <!--<div class="wishlist">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon-icon-P1l">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </div>-->
          </div>
        {% endfor %}
      {% endif %}
    </div>

    <div class="slider-controls-desktop" id="Controls-{{ section.id }}">
        <button class="slider-btn slider-prev" type="button" aria-label="Previous">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button class="slider-btn slider-next" type="button" aria-label="Next">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
    </div>
    
    <div class="mobile-dots-container">
      {% if tagged_products.size > 0 %}
        {% for product in tagged_products limit: product_limit %}
          <button class="mobile-dot {% if forloop.first %}active{% endif %}" aria-label="Go to slide {{ forloop.index }}"></button>
        {% endfor %}
      {% elsif section.blocks.size > 0 %}
         {%- for block in section.blocks -%}
            <button class="mobile-dot {% if forloop.first %}active{% endif %}" aria-label="Go to slide {{ forloop.index }}"></button>
         {%- endfor -%}
      {% endif %}
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", function() {
        const container = document.querySelector('#NewArrivals-{{ section.id }}');
        const dots = document.querySelectorAll('#NewArrivals-{{ section.id }} ~ .mobile-dots-container .mobile-dot');
        let autoplayInterval;
        let resizeTimeout;
        
        if (container && dots.length > 0) {
          
          function getGap() {
             const style = window.getComputedStyle(container);
             const gap = parseInt(style.gap) || 16;
             return gap;
          }

          function getMaxIndex() {
             // Calculate how many items are fully visible
             const card = container.querySelector('.card');
             if (!card) return dots.length - 1;
             
             const cardWidth = card.offsetWidth;
             const containerWidth = container.clientWidth;
             const gap = getGap();
             
             // Rough estimate of visible items
             // The container width is roughly (visibleItems * cardWidth) + ((visibleItems - 1) * gap)
             // Solving for visibleItems: (W + gap) / (cw + gap)
             const visibleItems = Math.round((containerWidth + gap) / (cardWidth + gap));
             
             return Math.max(0, dots.length - visibleItems);
          }

          function updateDotsVisibility() {
            // Only apply this logic for tablet/mobile slider view
            if (window.innerWidth <= 800) {
              const maxIndex = getMaxIndex();
              
              dots.forEach((dot, index) => {
                if (index > maxIndex) {
                  dot.style.display = 'none';
                } else {
                  dot.style.display = ''; 
                }
              });
            } else {
               // Desktop view - reset (though container is hidden via CSS usually)
               dots.forEach((dot) => {
                 dot.style.display = ''; 
               });
            }
          }

          function setActiveDot(index) {
             let maxIndex = dots.length - 1;
             if (window.innerWidth <= 800) {
                maxIndex = getMaxIndex();
             }
             
             // Clamp index
             if (index > maxIndex) index = maxIndex;
             
             dots.forEach((dot, i) => {
               if (i === index) {
                 dot.classList.add('active');
               } else {
                 dot.classList.remove('active');
               }
             });
          }

          container.addEventListener('scroll', function() {
             const scrollLeft = container.scrollLeft;
             const card = container.querySelector('.card');
             if (!card) return;
             
             const cardWidth = card.offsetWidth;
             const gap = getGap();
             const index = Math.round(scrollLeft / (cardWidth + gap));
             
             setActiveDot(index);
          });
          
          dots.forEach((dot, i) => {
            dot.addEventListener('click', function() {
              const card = container.querySelector('.card');
              if (!card) return;
              
              const cardWidth = card.offsetWidth;
              const gap = getGap();
              const targetScrollLeft = i * (cardWidth + gap);
              container.scrollTo({ left: targetScrollLeft, behavior: 'smooth' });
              resetAutoplay();
            });
          });

          // Autoplay functionality
          function startAutoplay() {
            // Mobile/Tablet Autoplay
            if (window.innerWidth <= 800) {
              autoplayInterval = setInterval(() => {
                const scrollLeft = container.scrollLeft;
                const card = container.querySelector('.card');
                if (!card) return;
                
                const cardWidth = card.offsetWidth;
                const gap = getGap();
                
                let currentIndex = Math.round(scrollLeft / (cardWidth + gap));
                let maxIndex = getMaxIndex();
                let nextIndex = currentIndex + 1;
                
                if (nextIndex > maxIndex) {
                  nextIndex = 0;
                }
                
                const targetScrollLeft = nextIndex * (cardWidth + gap);
                container.scrollTo({
                  left: targetScrollLeft,
                  behavior: 'smooth'
                });
              }, 3000); // 3 seconds interval
            } 
            // Desktop Autoplay (if slider is active)
            else if (container.classList.contains('slider-active')) {
               autoplayInterval = setInterval(() => {
                 const card = container.querySelector('.card');
                 const cardWidth = card ? card.offsetWidth : 320;
                 const gap = 30; // 30px gap from CSS for desktop
                 const maxScrollLeft = container.scrollWidth - container.clientWidth;
                 
                 // If near end, scroll to start, else scroll next
                 if (container.scrollLeft >= maxScrollLeft - 10) { // Tolerance
                   container.scrollTo({ left: 0, behavior: 'smooth' });
                 } else {
                   container.scrollBy({ left: (cardWidth + gap), behavior: 'smooth' });
                 }
               }, 3000); 
            }
          }

          function resetAutoplay() {
            clearInterval(autoplayInterval);
            startAutoplay();
          }
          
          // Initial setup
          updateDotsVisibility();
          startAutoplay();

          // Pause on interaction
          container.addEventListener('touchstart', () => clearInterval(autoplayInterval));
          container.addEventListener('touchend', () => resetAutoplay());
          container.addEventListener('mouseenter', () => clearInterval(autoplayInterval));
          container.addEventListener('mouseleave', () => resetAutoplay());
          
          window.addEventListener('resize', () => {
             clearInterval(autoplayInterval);
             clearTimeout(resizeTimeout);
             resizeTimeout = setTimeout(() => {
               updateDotsVisibility();
               startAutoplay();
             }, 200);
          });

          // Desktop Slider Navigation
          const desktopControls = document.getElementById('Controls-{{ section.id }}');
          if (desktopControls && container.classList.contains('slider-active')) {
            const prevBtn = desktopControls.querySelector('.slider-prev');
            const nextBtn = desktopControls.querySelector('.slider-next');

            if (prevBtn && nextBtn) {
               prevBtn.addEventListener('click', () => {
                 clearInterval(autoplayInterval);
                 const card = container.querySelector('.card');
                 const cardWidth = card ? card.offsetWidth : 320;
                 const gap = 30;
                 container.scrollBy({ left: -(cardWidth + gap), behavior: 'smooth' });
                 startAutoplay();
               });

               nextBtn.addEventListener('click', () => {
                 clearInterval(autoplayInterval);
                 const card = container.querySelector('.card');
                 const cardWidth = card ? card.offsetWidth : 320;
                 const gap = 30;
                 
                 const maxScrollLeft = container.scrollWidth - container.clientWidth;
                 if (container.scrollLeft >= maxScrollLeft - 10) {
                    container.scrollTo({ left: 0, behavior: 'smooth' });
                 } else {
                    container.scrollBy({ left: (cardWidth + gap), behavior: 'smooth' });
                 }
                 startAutoplay();
               });
               
               desktopControls.addEventListener('mouseenter', () => clearInterval(autoplayInterval));
               desktopControls.addEventListener('mouseleave', () => resetAutoplay());
            }
          }
        }
      });
    </script>
  </div>
</section>