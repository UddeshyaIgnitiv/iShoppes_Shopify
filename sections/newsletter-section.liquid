{% schema %}
{
  "name": "Newsletter Section",
  "tag": "section",
  "class": "newsletter-section",
  "enabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "GET IN TOUCH"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Sign up for our newsletter and promotions."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "SUBSCRIBE"
    },
    {
      "type": "color",
      "id": "background_start",
      "label": "Background Gradient Start",
      "default": "#343333"
    },
    {
      "type": "color",
      "id": "background_end",
      "label": "Background Gradient End",
      "default": "#060000"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "subtext_color",
      "label": "Subtext Color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "input_border_color",
      "label": "Input Border Color",
      "default": "#cccccc"
    },
    {
      "type": "color",
      "id": "input_text_color",
      "label": "Input Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "input_placeholder_color",
      "label": "Placeholder Text Color",
      "default": "#aaaaaa"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "button_hover_bg",
      "label": "Button Hover Background",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "button_shadow_color",
      "label": "Button Glow/Shadow Color",
      "default": "rgba(255,255,255,0.2)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "default": 30,
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "default": 30,
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Newsletter Section"
    }
  ]
}
{% endschema %}

{% style %}
  .newsletter-section {
    background: linear-gradient(to right, {{ section.settings.background_start }}, {{ section.settings.background_end }});
    color: {{ section.settings.heading_color }};
    text-align: center;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .newsletter-section h2 {
    font-size: 32px;
    margin-bottom: 10px;
    color: {{ section.settings.heading_color }};
    font-weight: 500;
  }

  .newsletter-section p {
    font-size: 16px;
    color: {{ section.settings.subtext_color }};
  }

  .newsletter-section form {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .newsletter-section input[type="email"] {
    background: transparent;
    border: none;
    border-bottom: 2px solid {{ section.settings.input_border_color }};
    color: {{ section.settings.input_text_color }};
    font-size: 16px;
    padding: 10px;
    width: 500px;
    max-width: 90%;
    margin-bottom: 30px;
    text-align: left;
    border-radius:0;
  }

  .newsletter-section input[type="email"]::placeholder {
    color: {{ section.settings.input_placeholder_color }};
  }

  .newsletter-section button {
    display: inline-block;
    background-color: {{ section.settings.button_bg }};
    color: {{ section.settings.button_text_color }};
    font-size: 18px;
    padding: 15px 50px;
    font-weight: 500;
    border-radius: 50px;
    border: 1px solid #2c2c2c;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0px 0px 0px 8px {{ section.settings.button_shadow_color }};
    cursor: pointer;
  }

  .newsletter-section button:hover {
    background-color: {{ section.settings.button_hover_bg }};
    box-shadow: 0px 0px 0px 8px rgba(6, 0, 0, 0.1);
  }

  .newsletter-message {
    margin-top: 20px;
    padding: 15px;
    border-radius: 5px;
  }

  .newsletter-success {
    background-color: rgba(76, 175, 80, 0.2);
    color: #4caf50;
  }

  .newsletter-error {
    background-color: rgba(244, 67, 54, 0.2);
    color: #f44336;
  }
  #newsletter-popup {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: white;
    width: 90%;
    max-width: 420px;
    padding: 25px 30px;
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
    z-index: 10000;
    font-family: Arial, sans-serif;
  }
  #newsletter-popup p {
    text-align: left;
    font-size: 14px;
    color: #000;
    margin-bottom: 20px;
  }
  #newsletter-popup h2 {
    text-align: center;
    margin-bottom: 10px;

    font-size: 22px;
    font-weight: 700;
  }
  #popup-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    z-index: 9999;
  }
   #popup-close {
    position: absolute;
    right: 18px;
    top: 18px;
    font-size: 22px;
    cursor: pointer;
    color: #555;
  }
{% endstyle %}
<section class="newsletter-section">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.subtext }}</p>
  
  {% form 'customer', class: 'contact-form' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <input type="email" name="contact[email]" placeholder="Email" required>
    <button type="submit">{{ section.settings.button_text }}</button>
    
    {% if form.posted_successfully? %}
      <div id="popup-overlay"></div>
      <div id="newsletter-popup">
      <div id="popup-close">&times;</div>
      <div id="popup-message">
        <h4 style="margin:25px 0 45px 0;color:#000000;">Thanks for subscribing!</h4>
        <p style="margin:15px;font-size:16px;">Check your email for a confirmation message.</p>
      </div>
      </div>
    {% elsif form.errors %}
      <div class="newsletter-message newsletter-error">
        <p>{{ form.errors | default_errors }}</p>
      </div>
    {% endif %}
  {% endform %}
  

 <script>
document.addEventListener("DOMContentLoaded", function () {
  function closePopup() {
    document.getElementById("popup-overlay").style.display = "none";
    document.getElementById("newsletter-popup").style.display = "none";
  }

  document.getElementById("popup-close").onclick = closePopup;
  document.getElementById("popup-overlay").onclick = closePopup;
});
</script>

</section>
