{% schema %}
{
  "name": "Official Stores",
  "tag": "section",
  "class": "official-stores",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "OFFICIAL STORES"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width (px)",
      "min": 50,
      "max": 400,
      "step": 10,
      "default": 200
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo Height (px)",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 120
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "label": "Spacing Between Logos (px)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "hover_effect",
      "label": "Enable Logo Hover Effect (scale & opacity)",
      "default": true
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "\"View All\" Link URL",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "\"View All\" Text",
      "default": "View All →"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Brand Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "brand_logo",
          "label": "Upload Brand Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Official Stores",
      "category": "Custom"
    }
  ]
}
{% endschema %}

{% style %}
  .official-stores {
    padding: 20px;
    background: {{ section.settings.background_color }};
  }

  .official-stores h2 {
    font-size: 28px;
    font-weight: 500;
    margin-bottom: 30px;
    margin-left: 10px;
    color: #0a1f33;
  }

  .official-stores-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: {{ section.settings.logo_spacing }}px;
  }

  .official-stores-logos a {
    display: inline-block;
    transition: all 0.3s ease;
  }

  .official-stores-logos img {
    width: {{ section.settings.logo_width }}px;
    height: {{ section.settings.logo_height }}px;
    object-fit: contain;
    transition: all 0.3s ease;
  }

  {% if section.settings.hover_effect %}
    .official-stores-logos a:hover img {
      transform: scale(1.05);
      opacity: 0.9;
    }
  {% endif %}

  /* "View All" link */
  .official-stores-view-all {
    text-align: right;
    margin-top: 15px;
    margin-right: 10px;
  }

  .official-stores-view-all a {
    color: #0a1f33;
    font-weight: 500;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: all 0.3s ease;
  }

  .official-stores-view-all a:hover {
    text-decoration: underline;
  }

  /* ===== Mobile Slider ===== */
  @media screen and (max-width: 768px) {
    .official-stores-logos {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      gap: 20px;
      padding-bottom: 15px;
    }

    .official-stores-logos::-webkit-scrollbar {
      display: none;
    }

    .official-stores-logos a {
      flex: 0 0 80%;
      scroll-snap-align: center;
    }

    .official-stores-logos img {
      width: 100%;
      height: auto;
    }
  }
{% endstyle %}

<section class="official-stores">
  <div class="page-width">
    {% if section.settings.title != blank %}
      <h2>{{ section.settings.title }}</h2>
    {% endif %}

    <div class="official-stores-logos">
      {% for block in section.blocks %}
        {% if block.settings.brand_logo != blank %}
          <a href="{{ block.settings.link | default: '#' }}" target="_blank" {{ block.shopify_attributes }}>
            <img 
              src="{{ block.settings.brand_logo | image_url: width: section.settings.logo_width }}" 
              alt="Brand Logo"
              loading="lazy">
          </a>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.view_all_link != blank %}
      <div class="official-stores-view-all">
        <a href="{{ section.settings.view_all_link }}">{{ section.settings.view_all_text }}</a>
      </div>
    {% endif %}
  </div>
</section>

{% javascript %}
  /* Auto-scroll effect on mobile */
  document.addEventListener('DOMContentLoaded', function() {
    const container = document.querySelector('.official-stores-logos');
    if (window.innerWidth < 768 && container) {
      let scrollAmount = 0;
      const slideTimer = setInterval(function() {
        container.scrollBy({ left: 250, behavior: 'smooth' });
        scrollAmount += 250;
        if (scrollAmount >= container.scrollWidth - container.clientWidth) {
          container.scrollTo({ left: 0, behavior: 'smooth' });
          scrollAmount = 0;
        }
      }, 2500);
    }
  });
{% endjavascript %}
