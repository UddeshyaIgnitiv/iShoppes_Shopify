{% schema %}
{
  "name": "Official Stores",
  "tag": "section",
  "class": "official-stores",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "OFFICIAL STORES"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width (px)",
      "min": 50,
      "max": 400,
      "step": 10,
      "default": 200
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo Height (px)",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 120
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "label": "Spacing Between Logos (px)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "hover_effect",
      "label": "Enable Logo Hover Effect (scale & opacity)",
      "default": true
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Logo Alignment",
      "default": "center",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" },
        { "value": "space-between", "label": "Space Between" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Brand Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "brand_logo",
          "label": "Upload Brand Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Official Stores",
      "category": "Custom"
    }
  ]
}
{% endschema %}

{% style %}
  .official-stores {
    padding: 20px;
    background: {{ section.settings.background_color }};
    text-align: left;
  }

  .official-stores h2 {
    font-size: 28px;
    font-weight: 500;
    margin-bottom: 40px;
    margin-left:20px;
    color: #0a1f33;
  }

  .official-stores-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: {{ section.settings.alignment }};
    gap: {{ section.settings.logo_spacing }}px;
  }

  .official-stores-logos a {
    display: inline-block;
    transition: all 0.3s ease;
  }

  .official-stores-logos img {
    width: {{ section.settings.logo_width }}px;
    height: {{ section.settings.logo_height }}px;
    object-fit: contain;
    transition: all 0.3s ease;
  }

  {% if section.settings.hover_effect %}
    .official-stores-logos a:hover img {
      transform: scale(1.05);
      opacity: 0.9;
    }
  {% endif %}

  /* Responsive adjustments */
  @media screen and (max-width: 768px) {
    .official-stores-logos {
      justify-content: center;
      gap: 20px;
    }
    .official-stores-logos img {
      width: 150px;
      height: auto;
    }
  }
{% endstyle %}

<section class="official-stores">
  <div class="page-width">
    {% if section.settings.title != blank %}
      <h2>{{ section.settings.title }}</h2>
    {% endif %}
    <div class="official-stores-logos">
      {% for block in section.blocks %}
        {% if block.settings.brand_logo != blank %}
          <a href="{{ block.settings.link | default: '#' }}" target="_blank" {{ block.shopify_attributes }}>
            <img 
              src="{{ block.settings.brand_logo | image_url: width: section.settings.logo_width }}" 
              alt="Brand Logo"
              loading="lazy">
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
