{% schema %}
{
  "name": "Official Stores",
  "tag": "section",
  "class": "official-stores",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "OFFICIAL STORES"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link",
      "default": "#"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View All Text",
      "default": "View All →"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width (px)",
      "min": 50,
      "max": 400,
      "step": 10,
      "default": 200
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo Height (px)",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 120
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "label": "Spacing Between Logos (px)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "hover_effect",
      "label": "Enable Logo Hover Effect (scale & opacity)",
      "default": true
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Logo Alignment",
      "default": "center",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" },
        { "value": "space-between", "label": "Space Between" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Brand Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "brand_logo",
          "label": "Upload Brand Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Official Stores",
      "category": "Custom"
    }
  ]
}
{% endschema %}

{% style %}
  .official-stores {
    padding: 20px;
    background: {{ section.settings.background_color }};
    text-align: left;
  }

  .official-stores h2 {
    font-size: 28px;
    font-weight: 500;
    margin-bottom: 40px;
    margin-left: 20px;
    color: #0a1f33;
  }

  /* Desktop grid layout */
  .official-stores-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: {{ section.settings.alignment }};
    gap: {{ section.settings.logo_spacing }}px;
  }

  .official-stores-logos a {
    display: inline-block;
    transition: all 0.3s ease;
  }

  .official-stores-logos img {
    width: {{ section.settings.logo_width }}px;
    height: {{ section.settings.logo_height }}px;
    object-fit: contain;
    transition: all 0.3s ease;
  }

  {% if section.settings.hover_effect %}
    .official-stores-logos a:hover img {
      transform: scale(1.05);
      opacity: 0.9;
    }
  {% endif %}

  /* Footer container below slider for dots and view all */
  .official-stores-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 15px 20px 0 20px;
  }

  /* Flickity dots styling */
  .flickity-page-dots {
    margin: 0;
    padding: 0;
    display: flex;
    list-style: none;
  }
  .flickity-page-dots li {
    background: #ccc;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 8px;
    opacity: 1;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }
  .flickity-page-dots .is-selected {
    background: #0a1f33;
  }

  .official-stores-view-all a {
    color: #0a1f33;
    font-weight: 600;
    text-decoration: none;
    font-size: 16px;
  }
  .official-stores-view-all a:hover {
    text-decoration: underline;
  }

  /* Mobile slider */
  @media screen and (max-width: 768px) {
    /* Hide desktop flex on mobile */
    .official-stores-logos {
      display: block;
    }

    /* Carousel cell style */
    .official-stores-logos .carousel-cell {
      width: 80vw !important;
      margin-right: 10px;
    }

    .official-stores-logos img {
      width: 100% !important;
      height: auto !important;
      max-height: {{ section.settings.logo_height }}px;
      object-fit: contain;
    }

    /* Footer container with dots left and view all right */
    .official-stores-footer {
      margin-left: 20px;
      margin-right: 20px;
    }
  }
{% endstyle %}

<section class="official-stores">
  <div class="page-width">
    {% if section.settings.title != blank %}
      <h2>{{ section.settings.title }}</h2>
    {% endif %}

    <div class="official-stores-logos">
      {% for block in section.blocks %}
        {% if block.settings.brand_logo != blank %}
          <a
            href="{{ block.settings.link | default: '#' }}"
            target="_blank"
            {{ block.shopify_attributes }}
            class="carousel-cell"
          >
            <img
              src="{{ block.settings.brand_logo | image_url: width: section.settings.logo_width }}"
              alt="Brand Logo"
              loading="lazy"
            />
          </a>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.view_all_link != blank %}
      <div class="official-stores-footer">
        <div class="flickity-page-dots-container"></div>
        <div class="official-stores-view-all">
          <a href="{{ section.settings.view_all_link }}">{{ section.settings.view_all_text }}</a>
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    var logosContainer = document.querySelector('.official-stores-logos');

    function initFlickity() {
      if (window.innerWidth <= 768 && logosContainer) {
        if (!logosContainer.classList.contains('flickity-enabled')) {
          var flkty = new Flickity(logosContainer, {
            cellAlign: 'center',
            contain: true,
            pageDots: true,
            prevNextButtons: false,
            autoPlay: 2500,
            wrapAround: true,
            pauseAutoPlayOnHover: true,
            adaptiveHeight: true,
            draggable: true,
            selectedAttraction: 0.025,
            friction: 0.3,
          });

          // Move Flickity dots into custom container
          var dots = logosContainer.querySelector('.flickity-page-dots');
          var dotsContainer = document.querySelector('.flickity-page-dots-container');
          if (dots && dotsContainer) {
            dotsContainer.appendChild(dots);
          }
        }
      }
    }

    initFlickity();

    window.addEventListener('resize', function () {
      location.reload();  // Reload on resize for simplicity
    });
  });
{% endjavascript %}
