{% schema %}
{
  "name": "Official Stores",
  "tag": "section",
  "class": "official-stores",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "OFFICIAL STORES"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link",
      "default": "/"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width (px)",
      "min": 50,
      "max": 400,
      "step": 10,
      "default": 200
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo Height (px)",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 120
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "label": "Spacing Between Logos (px)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "hover_effect",
      "label": "Enable Logo Hover Effect (scale & opacity)",
      "default": true
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Logo Alignment",
      "default": "center",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" },
        { "value": "space-between", "label": "Space Between" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Brand Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "brand_logo",
          "label": "Upload Brand Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Official Stores",
      "category": "Custom"
    }
  ]
}
{% endschema %}

{% style %}
  .official-stores {
    padding: 20px;
    background: {{ section.settings.background_color }};
    text-align: left;
  }

  .official-stores h2 {
    font-size: 28px;
    font-weight: 500;
    margin-bottom: 40px;
    margin-left: 20px;
    color: #0a1f33;
  }

  /* Container for logos and controls on mobile */
  .official-stores-mobile-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 20px 30px 20px;
  }

  .official-stores-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: {{ section.settings.alignment }};
    gap: {{ section.settings.logo_spacing }}px;
  }

  .official-stores-logos a {
    display: inline-block;
    transition: all 0.3s ease;
  }

  .official-stores-logos img {
    width: {{ section.settings.logo_width }}px;
    height: {{ section.settings.logo_height }}px;
    object-fit: contain;
    transition: all 0.3s ease;
  }

  {% if section.settings.hover_effect %}
    .official-stores-logos a:hover img {
      transform: scale(1.05);
      opacity: 0.9;
    }
  {% endif %}

  /* Flickity page dots container */
  .flickity-page-dots-container {
    display: flex;
    align-items: center;
  }

  /* Position dots left, View All link right on mobile */
  .mobile-controls {
    display: none;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    margin: 0 20px 10px 20px;
  }

  .flickity-page-dots {
    margin: 0;
  }

  .flickity-page-dots li {
    width: 12px;
    height: 12px;
    margin: 0 5px;
  }

  .flickity-page-dots .is-selected {
    background: #333;
  }

  .view-all-link {
    font-weight: 500;
    font-size: 16px;
    color: #0a1f33;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .view-all-link svg {
    margin-left: 5px;
    width: 16px;
    height: 16px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }

  /* Responsive styles */
  @media screen and (max-width: 768px) {
    .official-stores-logos {
      flex-wrap: nowrap;
      overflow: hidden;
      gap: 0;
    }

    .official-stores-logos a {
      margin-right: 10px;
      flex: 0 0 auto;
    }

    .official-stores-logos img {
      width: 150px !important;
      height: auto !important;
    }

    .official-stores {
      padding-bottom: 0;
    }

    /* Show mobile controls */
    .mobile-controls {
      display: flex;
    }
  }
{% endstyle %}

<section class="official-stores">
  <div class="page-width">
    {% if section.settings.title != blank %}
      <h2>{{ section.settings.title }}</h2>
    {% endif %}

    <!-- Mobile controls: dots left, view all right -->
    <div class="mobile-controls">
      <div class="flickity-page-dots-container"></div>
      <a href="{{ section.settings.view_all_link }}" class="view-all-link" target="_blank" rel="noopener">
        View All
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </a>
    </div>

    <div class="official-stores-logos">
      {% for block in section.blocks %}
        {% if block.settings.brand_logo != blank %}
          <a href="{{ block.settings.link | default: '#' }}" target="_blank" {{ block.shopify_attributes }}>
            <img 
              src="{{ block.settings.brand_logo | image_url: width: section.settings.logo_width }}" 
              alt="Brand Logo"
              loading="lazy">
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    var logosContainer = document.querySelector('.official-stores-logos');
    var dotsContainer = document.querySelector('.flickity-page-dots-container');
    var flkty;

    function initFlickity() {
      if (window.innerWidth <= 768 && logosContainer) {
        if (!logosContainer.classList.contains('flickity-enabled')) {
          flkty = new Flickity(logosContainer, {
            cellAlign: 'left',
            contain: true,
            pageDots: true,
            prevNextButtons: false,
            wrapAround: true,
            draggable: true,
            adaptiveHeight: true,
            friction: 0.05,
            selectedAttraction: 0.015,
          });

          // Move Flickity dots into our container
          var dots = logosContainer.querySelector('.flickity-page-dots');
          if (dots && dotsContainer) {
            dotsContainer.appendChild(dots);
          }

          // Smooth continuous auto scroll
          let scrollX = 0;
          let speed = 0.5; // pixels per frame

          function animate() {
            scrollX += speed;
            if (scrollX >= flkty.slideableWidth) {
              scrollX = 0;
            }
            flkty.x = -scrollX;
            flkty.positionSlider();
            requestAnimationFrame(animate);
          }

          animate();
        }
      }
    }

    initFlickity();

    window.addEventListener('resize', function () {
      location.reload();
    });
  });
{% endjavascript %}
