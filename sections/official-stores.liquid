{% schema %}
{
  "name": "Official Stores",
  "tag": "section",
  "class": "official-stores",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "OFFICIAL STORES"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link",
      "default": "/"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width (px)",
      "min": 50,
      "max": 400,
      "step": 10,
      "default": 200
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo Height (px)",
      "min": 50,
      "max": 300,
      "step": 10,
      "default": 120
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "label": "Spacing Between Logos (px)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "hover_effect",
      "label": "Enable Logo Hover Effect (scale & opacity)",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Brand Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "brand_logo",
          "label": "Upload Brand Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Official Stores",
      "category": "Custom"
    }
  ]
}
{% endschema %}

{% style %}
  .official-stores {
    padding: 20px;
    background: {{ section.settings.background_color }};
    text-align: left;
  }

  .official-stores h2 {
    font-size: 28px;
    font-weight: 500;
    margin-bottom: 40px;
    margin-left: 20px;
    color: #0a1f33;
  }

  /* Container for logos and controls on mobile */
  .official-stores-mobile-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 20px 30px 20px;
  }

  .official-stores-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: {{ section.settings.logo_spacing }}px;
    width: 100%; /* Ensure full width for slider */
  }

  /* When Flickity is enabled, remove flex display */
  .official-stores-logos.flickity-enabled {
    display: block;
  }

  .official-stores-logos a {
    display: inline-block;
    transition: all 0.3s ease;
    /* Desktop Calculation */
    flex: 0 0 calc(25% - {{ section.settings.logo_spacing | times: 0.75 }}px);
    max-width: calc(25% - {{ section.settings.logo_spacing | times: 0.75 }}px);
  }

  /* Flickity cells should be full width on mobile */
  .official-stores-logos.flickity-enabled .flickity-cell {
    width: 100%;
    margin-right: 0;
  }

  .official-stores-logos img {
    width: 100%;
    height: {{ section.settings.logo_height }}px;
    object-fit: contain;
    transition: all 0.3s ease;
  }

  {% if section.settings.hover_effect %}
    .official-stores-logos a:hover img {
      transform: scale(1.05);
      opacity: 0.9;
    }
  {% endif %}

  /* Flickity page dots container */
  .flickity-page-dots-container {
    display: flex;
    align-items: center;
  }

  /* Position dots left, View All link right on mobile */
  .mobile-controls {
    display: none;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    margin: 0 20px 10px 20px;
  }

  .flickity-page-dots {
    position: static;
    margin: 0;
    display: flex;
  }

  .flickity-page-dots li {
    width: 8px;
    height: 8px;
    margin: 0 4px;
    background: #ddd;
    border-radius: 50%;
    list-style: none;
  }

  .flickity-page-dots li.is-selected {
    background: #333;
  }

  .view-all-link {
    font-weight: 500;
    font-size: 16px;
    color: #0a1f33;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
  }

  .view-all-link svg {
    margin-left: 5px;
    width: 16px;
    height: 16px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
  }

  /* Focus outline fix */
  .official-stores-logos.flickity-enabled:focus {
    outline: none;
  }

  /* Responsive styles */
  @media screen and (max-width: 768px) {
    .official-stores-logos {
       display: block; /* Important for Flickity */
       gap: 0; /* Gap handled by flickity logic */
    }

    .official-stores-logos a {
      /* Reset flex for slider */
      flex: none; 
      max-width: 100%;
      margin-right: 0;
      width: 100%; /* 1 slide per view */
      display: block;
      opacity: 1 !important; /* Ensure visible */
    }

    .official-stores-logos.flickity-enabled a {
      width: 100%;
    }

    .official-stores-logos img {
      width: 100% !important;
      height: auto !important;
      max-height: 120px;
      margin: 0 auto;
      display: block;
    }

    .official-stores {
      padding-bottom: 0;
    }

    /* Show mobile controls */
    .mobile-controls {
      display: flex;
    }

    /* Ensure viewport handles height */
    .official-stores-logos .flickity-viewport {
      min-height: 140px;
    }

    /* Flickity cell styling */
    .official-stores-logos .flickity-cell {
      width: 100%;
    }
  }
{% endstyle %}

<section class="official-stores">
  <div class="page-width">
    {% if section.settings.title != blank %}
      <h2>{{ section.settings.title }}</h2>
    {% endif %}

    

    <div class="official-stores-logos" id="official-stores-logos-{{ section.id }}">
      {% for block in section.blocks %}
        {% if block.settings.brand_logo != blank %}
          <a href="{{ block.settings.link | default: '#' }}" target="_blank" {{ block.shopify_attributes }}>
            <img 
              src="{{ block.settings.brand_logo | image_url: width: 400 }}" 
              alt="{{ block.settings.brand_logo.alt | escape }}"
              loading="lazy"
              width="400"
              height="{{ section.settings.logo_height }}">
          </a>
        {% endif %}
      {% endfor %}
    </div>
    <div class="mobile-controls">
      <div class="flickity-page-dots-container" id="flickity-dots-{{ section.id }}"></div>
      <a href="{{ section.settings.view_all_link }}" class="view-all-link" target="_blank" rel="noopener">
        View All
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </a>
    </div>
  </div>
</section>

<script>
  (function() {
    const sectionId = '{{ section.id }}';
    const logosContainer = document.getElementById('official-stores-logos-' + sectionId);
    const dotsContainer = document.getElementById('flickity-dots-' + sectionId);
    let flkty = null;

    if (!logosContainer) return;

    function initFlickity() {
      // Wait for Flickity to be available
      if (typeof Flickity === 'undefined') {
        setTimeout(initFlickity, 100);
        return;
      }

      const isMobile = window.innerWidth <= 768;
      
      // 1. If Mobile and Not Initialized -> Start Slider
      if (isMobile && logosContainer && !logosContainer.classList.contains('flickity-enabled')) {
        // Destroy any existing instance first
        const existingFlkty = Flickity.data(logosContainer);
        if (existingFlkty) {
          existingFlkty.destroy();
        }
        
        flkty = new Flickity(logosContainer, {
          cellAlign: 'center',
          contain: true,
          pageDots: true,
          prevNextButtons: false,
          wrapAround: true,
          autoPlay: 3000,
          pauseAutoPlayOnHover: false,
          imagesLoaded: true,
          percentPosition: false,
          cellSelector: 'a',
          adaptiveHeight: true
        });

        // Move dots to custom container after initialization
        setTimeout(function() {
          const dots = logosContainer.querySelector('.flickity-page-dots');
          if (dots && dotsContainer) {
            dotsContainer.innerHTML = '';
            dotsContainer.appendChild(dots);
          }
        }, 100);

      // 2. If Desktop and Initialized -> Destroy Slider
      } else if (!isMobile && logosContainer && logosContainer.classList.contains('flickity-enabled')) {
        if (flkty) {
          flkty.destroy();
          flkty = null;
        } else {
          // Fallback if flkty var is lost but element has class
          const existingFlkty = Flickity.data(logosContainer);
          if (existingFlkty) {
            existingFlkty.destroy();
          }
        }
      }
    }

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFlickity);
    } else {
      // DOM already loaded
      initFlickity();
    }

    // Re-initialize on resize with debounce
    let resizeTimeout;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(initFlickity, 250);
    });

    // Also try initializing when window is fully loaded (fixes image height issues)
    window.addEventListener('load', initFlickity);
  })();
</script>