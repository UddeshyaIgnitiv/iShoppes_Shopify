{% schema %}
{
  "name": "Official Stores",
  "tag": "section",
  "class": "official-stores",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "OFFICIAL STORES"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View All Link",
      "default": "#"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "logo_spacing",
      "label": "Spacing Between Logos (px)",
      "min": 10,
      "max": 100,
      "step": 5,
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "hover_effect",
      "label": "Enable Logo Hover Effect (scale & opacity)",
      "default": true
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Logo Alignment",
      "default": "center",
      "options": [
        { "value": "flex-start", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "flex-end", "label": "Right" },
        { "value": "space-between", "label": "Space Between" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Brand Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "brand_logo",
          "label": "Upload Brand Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    {
      "name": "Official Stores",
      "category": "Custom"
    }
  ]
}
{% endschema %}

{% style %}
.official-stores {
  padding: 20px;
  background: {{ section.settings.background_color }};
  text-align: left;
}

.official-stores h2 {
  font-size: 28px;
  font-weight: 500;
  margin-bottom: 30px;
  margin-left: 20px;
  color: #0a1f33;
}

/* --- Logo container --- */
.official-stores-logos {
  display: flex;
  flex-wrap: wrap;
  justify-content: {{ section.settings.alignment }};
  align-items: center;
  gap: {{ section.settings.logo_spacing }}px;
}

.official-stores-logos a {
  display: flex !important;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  height: 150px !important;
  box-sizing: border-box;
}

.official-stores-logos img {
  max-height: 100%;
  width: auto;
  object-fit: contain;
  transition: all 0.3s ease;
}

{% if section.settings.hover_effect %}
.official-stores-logos a:hover img {
  transform: scale(1.05);
  opacity: 0.9;
}
{% endif %}

/* Ensure Flickity slides align vertically */
.flickity-slider {
  display: flex;
  align-items: center;
}

/* --- Dots container --- */
.flickity-page-dots-container {
  display: flex;
  align-items: center;
}

/* Mobile controls */
.mobile-controls {
  display: none;
  width: 100%;
  justify-content: space-between;
  align-items: center;
  margin: 0 20px 10px 20px;
}

/* Dot size & color */
.flickity-page-dots li {
  width: 14px !important;
  height: 14px !important;
  border-radius: 50%;
  background: #bbb;
  margin: 0 4px !important;
}

.flickity-page-dots li.is-selected {
  background: #0a1f33;
}

/* View all link */
.view-all-link {
  font-weight: 500;
  font-size: 16px;
  color: #0a1f33;
  text-decoration: none;
  display: inline-flex;
  align-items: center;
}

.view-all-link svg {
  margin-left: 5px;
  width: 16px;
  height: 16px;
  stroke: currentColor;
  stroke-width: 2;
  fill: none;
}

/* --- Mobile styles --- */
@media screen and (max-width: 768px) {
  .official-stores-logos {
    flex-wrap: nowrap;
    overflow: hidden;
    gap: 0;
    height: 150px !important;
  }

  .official-stores-logos a {
    flex: 0 0 auto;
    height: 150px !important;
    margin-right: 10px;
  }

  .official-stores-logos img {
    max-height: 100% !important;
    width: auto !important;
  }

  .mobile-controls {
    display: flex;
  }

  /* Larger dots for mobile */
  .flickity-page-dots li {
    width: 20px !important;
    height: 20px !important;
    margin: 0 6px !important;
  }
}
{% endstyle %}

<section class="official-stores">
  <div class="page-width">
    {% if section.settings.title != blank %}
      <h2>{{ section.settings.title }}</h2>
    {% endif %}

    <!-- Mobile: dots left, view all right -->
    <div class="mobile-controls">
      <div class="flickity-page-dots-container"></div>
      <a href="{{ section.settings.view_all_link }}" class="view-all-link" target="_blank" rel="noopener">
        View All
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </a>
    </div>

    <div class="official-stores-logos">
      {% for block in section.blocks %}
        {% if block.settings.brand_logo != blank %}
          <a href="{{ block.settings.link | default: '#' }}" target="_blank" {{ block.shopify_attributes }}>
            <img 
              src="{{ block.settings.brand_logo | image_url: width: 300 }}" 
              alt="Brand Logo"
              loading="lazy">
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% javascript %}
document.addEventListener('DOMContentLoaded', function () {
  var logosContainer = document.querySelector('.official-stores-logos');
  var dotsContainer = document.querySelector('.flickity-page-dots-container');

  if (window.innerWidth <= 768 && logosContainer) {
    var flkty = new Flickity(logosContainer, {
      cellAlign: 'left',
      contain: true,
      pageDots: true,
      prevNextButtons: false,
      wrapAround: true,
      freeScroll: true,
      friction: 0.1,
      selectedAttraction: 0.02,
      adaptiveHeight: false
    });

    var dots = logosContainer.querySelector('.flickity-page-dots');
    if (dots && dotsContainer) {
      dotsContainer.appendChild(dots);
    }
  }

  window.addEventListener('resize', function () {
    location.reload();
  });
});
{% endjavascript %}
