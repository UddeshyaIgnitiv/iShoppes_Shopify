<style>
  /* Overlay */
  #popup-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    z-index: 9999;
  }

  /* Popup Box */
  #newsletter-popup {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: white;
    width: 90%;
    max-width: 420px;
    padding: 25px 30px;
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
    z-index: 10000;
    display: none;
    font-family: Arial, sans-serif;
  }

  /* Close Button */
  #popup-close {
    position: absolute;
    right: 18px;
    top: 18px;
    font-size: 22px;
    cursor: pointer;
    color: #555;
  }

  #newsletter-popup h2 {
    text-align: center;
    margin-bottom: 10px;
    font-size: 22px;
    font-weight: 700;
  }

  #newsletter-popup p {
    text-align: center;
    font-size: 14px;
    color: #555;
    margin-bottom: 20px;
    line-height: 1.5;
  }

  /* Input Fields */
  .popup-input {
    width: 100%;
    padding: 12px;
    margin: 8px 0;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 15px;
    box-sizing: border-box;
  }

  /* Button */
  #popup-submit {
    width: 100%;
    padding: 14px;
    background: #3a48d4;
    color: white;
    border: none;
    font-size: 16px;
    border-radius: 6px;
    cursor: pointer;
    margin-top: 12px;
    font-weight: 600;
  }

  #popup-submit:hover {
    opacity: 0.9;
  }

  #popup-no-thanks {
    margin-top: 15px;
    text-align: center;
    color: #8a8a8a;
    font-size: 14px;
    cursor: pointer;
  }

  #popup-small-text {
    margin-top: 12px;
    font-size: 11px;
    color: #777;
    text-align: center;
    line-height: 1.4;
  }

  /* Message Box */
  #popup-message {
    margin-top: 15px;
    padding: 12px;
    border-radius: 6px;
    text-align: center;
    font-size: 14px;
    display: none;
  }

  #popup-message.success {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  #popup-message.error {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }
</style>

<!-- Overlay -->
<div id="popup-overlay"></div>

<!-- Popup -->
<div id="newsletter-popup">
  <div id="popup-close">&times;</div>

  <h2>FIRST TIME OFFER!</h2>
  <p>
    Receive 10% off on your first order before you takeoff!  
    Join our list and we'll send your special offer and exclusive promotions.
  </p>

  <form id="popup-form">
    <input type="text" id="popup-name" class="popup-input" placeholder="Name" required>
    <input type="email" id="popup-email" name="contact[email]" class="popup-input" placeholder="Email" required>
    <input type="hidden" name="form_type" value="customer">
    <input type="hidden" name="utf8" value="✓">
    <input type="hidden" name="contact[tags]" value="newsletter,popup">

    <button type="submit" id="popup-submit">GET MY 10% OFFER</button>
  </form>

  <div id="popup-message"></div>

  <div id="popup-no-thanks">NO, THANKS</div>

  <div id="popup-small-text">
    *Offer will arrive via email within 24 hours.  
    You can unsubscribe anytime.
  </div>
</div>

<script>
  function setCookie(name, value, days) {
    const d = new Date();
    d.setTime(d.getTime() + (days * 24 * 60 * 60 * 1000));
    let expires = "expires=" + d.toUTCString();
    document.cookie = name + "=" + value + ";" + expires + ";path=/";
  }

  function getCookie(name) {
    let cname = name + "=";
    let decoded = decodeURIComponent(document.cookie);
    let ca = decoded.split(';');
    for (let i = 0; i < ca.length; i++) {
      let c = ca[i].trim();
      if (c.indexOf(cname) === 0) return c.substring(cname.length, c.length);
    }
    return "";
  }

  function showPopup() {
    document.getElementById("popup-overlay").style.display = "block";
    document.getElementById("newsletter-popup").style.display = "block";
  }

  function closePopup() {
    document.getElementById("popup-overlay").style.display = "none";
    document.getElementById("newsletter-popup").style.display = "none";
    setCookie("popup_shown", "yes", 30);
  }

  function showMessage(message, type) {
    const messageBox = document.getElementById("popup-message");
    messageBox.textContent = message;
    messageBox.className = type;
    messageBox.style.display = "block";
  }

  document.addEventListener("DOMContentLoaded", function () {
    const alreadyShown = getCookie("popup_shown");

    if (!alreadyShown) {
      setTimeout(showPopup, 5000);
    }
  });

  document.getElementById("popup-close").onclick = closePopup;
  document.getElementById("popup-no-thanks").onclick = closePopup;
  document.getElementById("popup-overlay").onclick = closePopup;

  // Form submission
  document.getElementById("popup-form").addEventListener("submit", function (e) {
    e.preventDefault();

    const name = document.getElementById("popup-name").value.trim();
    const email = document.getElementById("popup-email").value.trim();

    if (!name || !email) {
      showMessage("Please enter both name and email.", "error");
      return;
    }

    // Disable submit button
    const submitBtn = document.getElementById("popup-submit");
    submitBtn.disabled = true;
    submitBtn.textContent = "SUBMITTING...";

    // Create form data
    const formData = new URLSearchParams();
    formData.append('form_type', 'customer');
    formData.append('utf8', '✓');
    formData.append('contact[tags]', 'newsletter,popup');
    formData.append('contact[name]', name);
    formData.append('contact[email]', email);

    fetch('/contact#contact_form', {
      method: 'POST',
      headers: { 
        'Content-Type': 'application/x-www-form-urlencoded',
      },
      body: formData.toString()
    })
    .then(response => {
      if (response.ok) {
        showMessage("Thank you! Your 10% offer is on the way.", "success");
        document.getElementById("popup-form").reset();
        setTimeout(closePopup, 3000);
      } else {
        showMessage("Something went wrong. Please try again.", "error");
      }
    })
    .catch(() => {
      showMessage("Network error. Please try again.", "error");
    })
    .finally(() => {
      submitBtn.disabled = false;
      submitBtn.textContent = "GET MY 10% OFFER";
    });
  });
</script>
