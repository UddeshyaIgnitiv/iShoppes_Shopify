<style>
  /* Overlay */
  #popup-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    z-index: 9999;
  }

  /* Popup Box */
  #newsletter-popup {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: white;
    width: 90%;
    max-width: 420px;
    padding: 25px 30px;
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.25);
    z-index: 10000;
    display: none;
    font-family: Arial, sans-serif;
  }

  /* Close Button */
  #popup-close {
    position: absolute;
    right: 18px;
    top: 18px;
    font-size: 22px;
    cursor: pointer;
    color: #555;
  }

  #newsletter-popup h2 {
    text-align: center;
    margin-bottom: 10px;
    font-size: 22px;
    font-weight: 700;
  }

  #newsletter-popup p {
    text-align: center;
    font-size: 14px;
    color: #555;
    margin-bottom: 20px;
    line-height: 1.5;
  }

  /* Input Fields */
  .popup-input {
    width: 100%;
    padding: 12px;
    margin: 8px 0;
    border: 1px solid #ccc;
    border-radius: 6px;
    font-size: 15px;
  }

  /* Button */
  #popup-submit {
    width: 100%;
    padding: 14px;
    background: #3a48d4;
    color: white;
    border: none;
    font-size: 16px;
    border-radius: 6px;
    cursor: pointer;
    margin-top: 12px;
    font-weight: 600;
  }

  #popup-submit:hover {
    opacity: 0.9;
  }

  #popup-no-thanks {
    margin-top: 15px;
    text-align: center;
    color: #8a8a8a;
    font-size: 14px;
    cursor: pointer;
  }

  #popup-small-text {
    margin-top: 12px;
    font-size: 11px;
    color: #777;
    text-align: center;
    line-height: 1.4;
  }
</style>

<!-- Overlay -->
<div id="popup-overlay"></div>

<!-- Popup -->
<div id="newsletter-popup">
  <div id="popup-close">&times;</div>

  <h2>FIRST TIME OFFER!</h2>
  <p>
    Receive 10% off on your first order before you takeoff!  
    Join our list and we'll send your special offer and exclusive promotions.
  </p>

  <input type="text" id="popup-name" class="popup-input" placeholder="Name">
  <input type="email" id="popup-email"  name="contact[email]" class="popup-input" placeholder="Email">

  <button id="popup-submit">GET MY 10% OFFER</button>

  <div id="popup-no-thanks">NO, THANKS</div>

  <div id="popup-small-text">
    *Offer will arrive via email within 24 hours.  
    You can unsubscribe anytime.
  </div>
</div>

<script>

  function setCookie(name, value, days) {
    const d = new Date();
    d.setTime(d.getTime() + (days * 24 * 60 * 60 * 1000));
    let expires = "expires=" + d.toUTCString();
    document.cookie = name + "=" + value + ";" + expires + ";path=/";
  }

  function getCookie(name) {
    let cname = name + "=";
    let decoded = decodeURIComponent(document.cookie);
    let ca = decoded.split(';');
    for (let i = 0; i < ca.length; i++) {
      let c = ca[i].trim();
      if (c.indexOf(cname) === 0) return c.substring(cname.length, c.length);
    }
    return "";
  }

  function showPopup() {
    document.getElementById("popup-overlay").style.display = "block";
    document.getElementById("newsletter-popup").style.display = "block";
  }

  function closePopup() {
    document.getElementById("popup-overlay").style.display = "none";
    document.getElementById("newsletter-popup").style.display = "none";
    setCookie("popup_shown", "yes", 30); // Prevent showing again for 30 days
  }


  document.addEventListener("DOMContentLoaded", function () {
    const alreadyShown = getCookie("popup_shown");

    if (!alreadyShown) {
      // Show after 5 seconds
      setTimeout(showPopup, 5000);
    }
  });


  document.getElementById("popup-close").onclick = closePopup;
  document.getElementById("popup-no-thanks").onclick = closePopup;
  document.getElementById("popup-overlay").onclick = closePopup;

  // On submit
  document.getElementById("popup-submit").onclick = function () {
    const name = document.getElementById("popup-name").value.trim();
    const email = document.getElementById("popup-email").value.trim();

    if (!name || !email) {
      alert("Please enter both name and email.");
      return;
    }

    // Save subscriber to Shopify
    fetch('/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: `form_type=customer&contact[name]=${name}&contact[email]=${email}`
    })
      .then(() => {
        alert("Thank you! Your 10% offer is on the way.");
        closePopup();
      })
      .catch(() => {
        alert("Something went wrong. Please try again.");
      });
  };


// for sending email using Klaviyo
  document.getElementById("subscribeBtn").addEventListener("click", async () => {
    const email = document.getElementById("emailInput").value;
    const msgBox = document.getElementById("klaviyo-msg");

    if (!email) {
      msgBox.innerText = "Please enter an email.";
      msgBox.style.color = "red";
      return;
    }

    const payload = {
      data: {
        type: "subscription",
        attributes: {
          list_id: "",   // OPTIONAL: Only if you want to add to a specific Klaviyo list
          profiles: [{ email: email }]
        }
      }
    };

    try {
      const response = await fetch("https://a.klaviyo.com/api/profile-subscriptions/?company_id=YOUR_KLAVIYO_PUBLIC_API_KEY", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "revision": "2024-07-15"
        },
        body: JSON.stringify(payload)
      });

      if (response.ok) {
        msgBox.innerText = "Successfully subscribed!";
        msgBox.style.color = "green";
        document.getElementById("emailInput").value = "";
      } else {
        msgBox.innerText = "Failed to subscribe. Try again.";
        msgBox.style.color = "red";
      }
    } catch (error) {
      msgBox.innerText = "Network error.";
      msgBox.style.color = "red";
    }
  });
</script>
