{% schema %}
{
  "name": "Recommended Products",
  "tag": "section",
  "class": "recommended-products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "RECOMMENDED"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "Product Tag",
      "default": "recommended",
      "info": "Products with this tag will be displayed"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Maximum products to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Recommended Products",
      "category": "Custom",
      "blocks": []
    }
  ]
}
{% endschema %}

{% style %}
  .recommended-products {
    padding: 40px 20px;
    background: #fff;
    text-align: center;
  }
  .recommended-products h2 {
    font-size: 28px;
    font-weight: 700;
    margin-bottom: 40px;
    text-transform: uppercase;
    color: #111;
    letter-spacing: 1px;
  }
  .recommended-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    justify-content: center;
    max-width: 1200px;
    margin: 0 auto;
  }
  .recommended-card {
    background: #fff;
    width: 350px;
    transition: 0.3s ease;
    padding: 20px;
    text-align: center;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .recommended-card:hover {
    transform: translateY(-5px);
  }
  .recommended-card a {
    text-decoration: none;
    color: inherit;
    width: 100%;
  }
  .recommended-card img {
    display: block;
    max-width: 100%;
    height: auto;
    width: 100%;
    object-fit: contain;
    margin-bottom: 20px;
  }
  .recommended-vendor {
    font-size: 18px;
    font-weight: 700;
    color: #111;
    margin-bottom: 8px;
    line-height: 1.3;
  }
  .recommended-title {
    font-size: 18px;
    font-weight: 700;
    color: #111;
    margin-bottom: 15px;
    line-height: 1.3;
  }
  .recommended-price {
    font-size: 16px;
    color: #111;
    font-weight: 400;
  }
  .no-products-message {
    padding: 20px;
    color: #666;
  }
{% endstyle %}

<section class="recommended-products">
  <div class="page-width">
    <h2>{{ section.settings.heading }}</h2>
    
    {% assign tag_to_filter = section.settings.tag | default: 'recommended' %}
    {% assign product_limit = section.settings.product_limit | default: 3 %}
    
    {% assign tagged_products = '' | split: '' %}
    
    {% assign collection_handle = tag_to_filter | handleize %}
    {% assign target_collection = collections[collection_handle] %}
    
    {% if target_collection != blank and target_collection.products.size > 0 %}
      {% assign tagged_products = target_collection.products %}
    {% else %}
      {% for product in collections.all.products %}
        {% if product.tags contains tag_to_filter %}
          {% assign tagged_products = tagged_products | push: product %}
        {% endif %}
        {% if tagged_products.size >= product_limit %}
          {% break %}
        {% endif %}
      {% endfor %}
    {% endif %}
    
    <div class="recommended-grid">
      {% if tagged_products.size == 0 %}
        {% if section.blocks.size == 0 %}
          <div class="no-products-message">
            <p>No products found with the "{{ tag_to_filter }}" tag or manually added.</p>
          </div>
        {% else %}
          {%- for block in section.blocks -%}
            {%- assign product = all_products[block.settings.product] -%}
            {% if product != blank %}
              <div class="recommended-card" {{ block.shopify_attributes }}>
                <a href="{{ product.url }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 400 }}"
                      alt="{{ product.featured_image.alt | escape }}"
                      width="400"
                      height="400"
                      loading="lazy"
                    >
                  {% else %}
                    <div style="height: 300px; display: flex; align-items: center; justify-content: center; background: #f9f9f9; margin-bottom: 20px;">
                      No image
                    </div>
                  {% endif %}
                  
                  <div class="recommended-vendor">{{ product.vendor }}</div>
                  <div class="recommended-title">{{ product.title }}</div>
                  <div class="recommended-price">{{ product.price | money_without_trailing_zeros }}</div>
                </a>
              </div>
            {% endif %}
          {%- endfor -%}
        {% endif %}
      {% else %}
        {% for product in tagged_products limit: product_limit %}
          <div class="recommended-card">
            <a href="{{ product.url }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 400 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  width="400"
                  height="400"
                  loading="lazy"
                >
              {% else %}
                <div style="height: 300px; display: flex; align-items: center; justify-content: center; background: #f9f9f9; margin-bottom: 20px;">
                  No image
                </div>
              {% endif %}
              
              <div class="recommended-vendor">{{ product.vendor }}</div>
              <div class="recommended-title">{{ product.title }}</div>
              <div class="recommended-price">{{ product.price | money_without_trailing_zeros }}</div>
            </a>
          </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>