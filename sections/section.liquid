{% assign contact_email = block.settings.contact_email | default: "dutyfree@ishoppes.com" %}
{% assign contact_address = block.settings.contact_address | default: "540 Rockaway Avenue, Valley Stream, NY 11581" %}

<div class="footer-layout">
    <ul class="footer-accordion">
        {% comment %}
        If you need dynamic accordion data, you can add it to block settings
        {% for item in block.settings.accordion_data %}
            <li class="footer-accordion-item">
                <div class="footer-accordion-toggle">
                    <span>{{ item.heading }}</span>
                    <span>+</span>
                </div>
                <div class="footer-accordion-content">
                    {{ item.content }}
                </div>
            </li>
        {% endfor %}
        {% endcomment %}
    </ul>

    <div class="footer-item">
        <ul>
            <li>Customer Service</li>
            <li><a href="/pages/faq">Pre-order FAQs</a></li>
            <li><a href="/pages/duty-free-allowance">Duty Free Allowances</a></li>
            <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
            <li><a href="/pages/term">Terms</a></li>
        </ul>
    </div>
    <div class="footer-item">
        <ul>
            <li>About Us</li>
            <li><a href="/pages/about-us">About Us</a></li>
            <li><a href="/pages/location">Locations</a></li>
            <li><a href="/pages/career">Careers</a></li>
        </ul>
    </div>
    <div class="footer-item">
        <ul>
            <li><a href="/perks">iShoppes Perks</a></li>
        </ul>
    </div>
    <div class="footer-item">
        <ul class="footer-accept">
            <li>We Accept</li>
            <li class="cards-accept">
                <span><img src="{{ 'visa.png' | asset_url }}" alt="Visa card" loading="lazy"></span>
                <span><img src="{{ 'master.png' | asset_url }}" alt="Master card" loading="lazy"></span>
                <span><img src="{{ 'https://cdn.shopify.com/s/files/1/0725/3553/9901/files/discover-icon.svg?v=1762497902' | asset_url }}" alt="Discover card" loading="lazy"></span>
                <span><img src="{{ 'amex.png' | asset_url }}" alt="Amex card" loading="lazy"></span>
                <span><img src="{{ 'unionpay.png' | asset_url }}" alt="Union pay card" loading="lazy"></span>
            </li>
            <li>&nbsp;</li>
            <li class="contact">Contact us</li>
            <li><a href="mailto:{{ contact_email }}">{{ contact_email }}</a></li>
            <li>Address: {{ contact_address }}</li>
        </ul>
    </div>
</div>

<style>
.footer-layout {
    display: grid;
    grid-template-columns: 0.7fr 0.4fr 0.5fr 1.4fr;
    column-gap: 1rem;
    background-color: #f0f2f2;
    padding: 2.5rem;
    justify-items: center;
    height: 296.17px;
}

.footer-item {
    display: inline-block;
    color: #000000;
    font-size: 1rem;
}

.footer-item ul li:nth-child(1),
.footer-item ul li.contact {
    padding-bottom: 1rem;
    font-size: 22px;
    font-weight: 500;
}

.footer-item ul li {
    padding-bottom: 7px;
    font-weight: 500;
    font-size: 16px;
    line-height: 130%;
}

.footer-item ul li a {
    text-decoration: none;
    color: inherit;
}

.footer-item ul li a:hover {
    text-decoration: underline;
}

.cards-accept span {
    display: inline-block;
    font-size: 18px;
    font-weight: 500;
    padding-right: 1rem;
}

.cards-accept span img {
    width: 42.3px;
    height: 26px;
}

.footer-accordion {
    display: none;
}

@media (max-width: 600px) {
    .footer-item {
        display: none;
    }

    .footer-layout {
        grid-template-columns: 1fr;
        padding: 20px;
        height: auto;
    }

    .footer-accordion {
        width: 100%;
        display: block;
        font-size: 22px;
        font-weight: 500;
    }

    .footer-accordion-item {
        list-style: none;
    }

    .footer-accordion-toggle {
        cursor: pointer;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
    }
}
</style>