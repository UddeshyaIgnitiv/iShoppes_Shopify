            <li><a href="mailto:{{ contact_email }}">{{ contact_email }}</a></li>
            <li>Address: {{ contact_address }}</li>
        </ul>
    </div>
</div>

<style>
.footer-layout {
    display: grid;
    grid-template-columns: 0.7fr 0.4fr 0.5fr 1.4fr;
    column-gap: 1rem;
    background-color: #f0f2f2;
    padding: 2.5rem;
    justify-items: center;
    min-height: 296.17px;
}

.footer-item {
    display: inline-block;
    color: #000000;
    font-size: 1rem;
}

.footer-heading {
    padding-bottom: 1rem;
    font-size: 22px;
    font-weight: 900;
}

.footer-item ul li {
    padding-bottom: 7px;
    {% comment %} font-weight: 500; {% endcomment %}
    font-size: 16px;
    line-height: 130%;
}

.footer-item ul li a {
    text-decoration: none;
    color: inherit;
}

.footer-item ul li a:hover {
    text-decoration: underline;
}

.cards-accept span {
    display: inline-block;
    font-size: 18px;
    font-weight: 500;
    padding-right: 1rem;
}

.cards-accept span img {
    width: 42.3px;
    height: 26px;
}

.footer-links {
    padding-left: 0;
    margin-left: 0;
    list-style: none;
}

/* Accordion Styles */
.footer-accordion {
    display: none;
    width: 100%;
    padding: 0;
    margin: 0;
}

.footer-accordion-item {
    list-style: none;
    border-bottom: 1px solid #ddd;
}

.footer-accordion-toggle {
    cursor: pointer;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 0;
    font-size: 18px;
    font-weight: 500;
    color: #000000;
}

.accordion-icon {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Right-pointing arrow (closed state) */
.footer-accordion-toggle .accordion-icon::before {
    content: "";
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background-color: white;
    border-radius: 50%;
    font-size: 12px;
    color: black;
    transition: all 0.3s ease;
    background-image: url('{{ "icon-right.svg" | asset_url }}');
}

/* Down arrow (open state) */
.footer-accordion-toggle.active .accordion-icon::before {
    content: "";
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    background-color: white;
    border-radius: 50%;
    font-size: 12px;
    color: black;
    transition: all 0.3s ease;
    background-image: url('{{ "icon-down.svg" | asset_url }}');

}

.footer-accordion-content {
    display: none;
    padding-bottom: 1rem;
}

.footer-accordion-content.active {
    display: block;
}

.cards-accept-mobile {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
}

.cards-accept-mobile span img {
    width: 35px;
    height: 22px;
}

.contact{
    font-weight:900;
}

/* Mobile Styles */
@media (max-width: 768px) {
    .footer-layout {
        grid-template-columns: 1fr;
        padding: 20px;
        min-height: auto;
    }

    .desktop-view {
        display: none !important;
    }

    .footer-accordion {
        display: block;
    }

    .footer-accordion-content .footer-links {
        padding-left: 0;
    }

    .footer-accordion-content .footer-links li {
        padding: 0.5rem 0;
        border: none;
    }

    .footer-accordion-content .footer-links li:first-child {
        padding-top: 0;
    }
}

/* Desktop Styles */
@media (min-width: 769px) {
    .footer-accordion {
        display: none !important;
    }

    .desktop-view {
        display: inline-block !important;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const accordionToggles = document.querySelectorAll('.footer-accordion-toggle');
    
    accordionToggles.forEach(toggle => {
        toggle.addEventListener('click', function() {
            const content = this.nextElementSibling;
            const isActive = this.classList.contains('active');
            
            // Close all accordion items first
            accordionToggles.forEach(otherToggle => {
                otherToggle.classList.remove('active');
                otherToggle.nextElementSibling.classList.remove('active');
            });
            
            // If clicking on a closed item, open it
            if (!isActive) {
                this.classList.add('active');
                content.classList.add('active');
            }
        });
    });
});
</script>