    <!-- Desktop Layout -->
    <div class="footer-item desktop-view">
        <ul class="footer-links">
            <li class="footer-heading">Customer Service</li>
            <li><a href="/pages/faq">Pre-order FAQs</a></li>
            <li><a href="/pages/duty-free-allowance">Duty Free Allowances</a></li>
            <li><a href="/pages/privacy-policy">Privacy Policy</a></li>
            <li><a href="/pages/term">Terms</a></li>
        </ul>
    </div>
    <div class="footer-item desktop-view">
        <ul class="footer-links">
            <li class="footer-heading">About Us</li>
            <li><a href="/pages/about-us">About Us</a></li>
            <li><a href="/pages/location">Locations</a></li>
            <li><a href="/pages/career">Careers</a></li>
        </ul>
    </div>
    <div class="footer-item desktop-view">
        <ul class="footer-links">
            <li class="footer-heading"><a href="/perks">iShoppes Perks</a></li>
        </ul>
    </div>
    <div class="footer-item desktop-view">
        <ul class="footer-accept footer-links">
            <li class="footer-heading">We Accept</li>
            <li class="cards-accept">
                <span><img src="{{ 'icon-visa.svg' | asset_url }}" alt="Visa card" loading="lazy"></span>
                <span><img src="{{ 'icon-master.svg' | asset_url }}" alt="Master card" loading="lazy"></span>
                <span><img src="{{ 'icon-discover.svg' | asset_url }}" alt="Discover card" loading="lazy"></span>
                <span><img src="{{ 'icon-amex.svg' | asset_url }}" alt="Amex card" loading="lazy"></span>
