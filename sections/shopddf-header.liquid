{% liquid
  assign menu_links = section.settings.menu.links
%}

<header class="shopddf-header">
  <div class="shopddf-header__top">
    <a class="shopddf-header__logo" href="{{ routes.root_url }}">
      {% if section.settings.logo != blank %}
        <img
          src="{{ section.settings.logo | image_url: width: 400 }}"
          alt="{{ section.settings.logo.alt | default: shop.name }}"
          loading="lazy"
          width="{{ section.settings.logo.width }}"
          height="{{ section.settings.logo.height }}"
          {% comment %} style="width: {{ section.settings.logo_width }}px;" {% endcomment %}
          style="width:320px"
        >
      {% else %}
        <span class="shopddf-header__logo-text">{{ shop.name }}</span>
      {% endif %}
    </a>

    
  </div>

  {% if menu_links != blank %}
    <nav class="shopddf-header__nav" aria-label="Main menu">
      <ul class="shopddf-header__menu">
        {% for link in menu_links %}
          <li class="shopddf-header__menu-item{% if link.links != blank %} has-children{% endif %}">
            <a class="shopddf-header__menu-link" href="{{ link.url }}">
              {{ link.title }}
              {% if link.links != blank %}
                <span class="shopddf-header__caret" aria-hidden="true">
                  {{ 'icon-caret.svg' | inline_asset_content }}
                </span>
              {% endif %}
            </a>
            {% if link.links != blank %}
              <ul class="shopddf-header__submenu">
                {% for child in link.links %}
                  <li>
                    <a href="{{ child.url }}">{{ child.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
  <div class="shopddf-header__icons">
      {% if section.settings.show_search %}
        <a class="shopddf-header__icon" href="{{ routes.search_url }}" aria-label="Search">
          {{ 'icon-search.svg' | inline_asset_content }}
        </a>
      {% endif %}
      {% if section.settings.show_account and shop.customer_accounts_enabled %}
        <a class="shopddf-header__icon" href="{{ routes.account_url }}" aria-label="Account">
          {{ 'icon-account.svg' | inline_asset_content }}
        </a>
      {% endif %}
      {% if section.settings.show_cart %}
        <a class="shopddf-header__icon shopddf-header__icon--cart" href="{{ routes.cart_url }}" aria-label="Cart">
          {% render 'cart-icon-component' %}
          {% if cart.item_count > 0 %}
            <span class="shopddf-header__cart-count">{{ cart.item_count }}</span>
          {% endif %}
        </a>
      {% endif %}
    </div>
    </nav>
  {% endif %}
</header>

{% stylesheet %}
  .shopddf-header {
    background: #ffffff;
    border-bottom: 1px solid #efefef;
  }

  .shopddf-header__top {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 38px 32px;
    background: #ffffff;
  }

  .shopddf-header__logo img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .shopddf-header__logo-text {
    font-weight: 600;
    color: #0b0b0b;
    font-size: 20px;
    letter-spacing: 0.2px;
  }

  .shopddf-header__icons {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .shopddf-header__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    color: #0b0b0b;
    position: relative;
  }

  .shopddf-header__icon svg {
    width: 22px;
    height: 22px;
  }

  .shopddf-header__cart-count {
    position: absolute;
    top: -2px;
    right: -4px;
    min-width: 16px;
    height: 16px;
    border-radius: 999px;
    background: #0b0b0b;
    color: #ffffff;
    font-size: 10px;
    line-height: 16px;
    text-align: center;
    padding: 0 4px;
  }

  .shopddf-header__nav {
    background: #0b0b0b;
  }

  .shopddf-header__menu {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    list-style: none;
    margin: 0;
    padding: 10px 20px;
  }

  .shopddf-header__menu-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #ffffff;
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .shopddf-header__caret svg {
    width: 10px;
    height: 10px;
  }

  .shopddf-header__menu-item {
    position: relative;
  }

  .shopddf-header__submenu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 180px;
    background: #ffffff;
    list-style: none;
    padding: 10px 0;
    margin: 0;
    border: 1px solid #e6e6e6;
    display: none;
    z-index: 20;
  }

  .shopddf-header__submenu a {
    display: block;
    padding: 8px 16px;
    color: #0b0b0b;
    text-decoration: none;
    font-size: 13px;
  }

  .shopddf-header__menu-item:hover .shopddf-header__submenu {
    display: block;
  }

  @media (max-width: 768px) {
    .shopddf-header__top {
      padding: 12px 16px;
    }

    .shopddf-header__nav {
      display: none;
    }

    .shopddf-header__logo img {
      max-height: 34px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ShopDDF Header",
  "tag": "section",
  "class": "shopddf-header-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 160
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart icon",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "ShopDDF Header"
    }
  ]
}
{% endschema %}
