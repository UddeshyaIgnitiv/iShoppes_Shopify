<section class="shopddf-home shopddf-page-section">
  <div class="shopddf-home__hero">
    {% if section.settings.hero_image != blank %}
      <picture>
        {% if section.settings.hero_image_mobile != blank %}
          <source media="(max-width: 768px)" srcset="{{ section.settings.hero_image_mobile | image_url: width: 900 }}">
        {% endif %}
        <img
          src="{{ section.settings.hero_image | image_url: width: 1600 }}"
          alt="{{ section.settings.hero_image.alt | default: section.settings.hero_heading }}"
          loading="lazy"
          width="{{ section.settings.hero_image.width }}"
          height="{{ section.settings.hero_image.height }}"
        >
      </picture>
    {% else %}
      <div class="shopddf-home__hero-placeholder"></div>
    {% endif %}
  </div>

  {% if section.settings.hero_heading != blank or section.settings.hero_text != blank %}
    <div class="shopddf-home__welcome">
      {% if section.settings.hero_heading != blank %}
        <h2>{{ section.settings.hero_heading }}</h2>
      {% endif %}
      {% if section.settings.hero_text != blank %}
        <div class="shopddf-home__welcome-text">{{ section.settings.hero_text }}</div>
      {% endif %}
    </div>
  {% endif %}

  <div class="shopddf-home__cards">
    {% for block in section.blocks %}
      <article class="shopddf-home__card" {{ block.shopify_attributes }}>
        <a class="shopddf-home__card-link" href="{{ block.settings.link }}">
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 900 }}"
              alt="{{ block.settings.image.alt | default: block.settings.title }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'shopddf-home__card-placeholder' }}
          {% endif %}
          {% comment %} <h3>{{ block.settings.title }}</h3> {% endcomment %}
          {% if block.settings.subtext != blank %}
            <h1 class="shopddf-home__card-subtext">{{ block.settings.subtext }}</h1>
          {% endif %}
        </a>
      </article>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .shopddf-page-section {
    padding-left: 45px !important;
    padding-right: 45px !important;
  }
  
  .shopddf-home__welcome {
    background: #d6d6d6;
    text-align: center;
    padding: 24px 16px;
  }
  .shopddf-home__welcome h2:after, .shopddf-home__welcome h2:before {
    content: " ";
    display: block;
    border-bottom: 1px solid #217CFE;
    border-top: 1px solid #217CFE;
    height: 5px;
  }
  .shopddf-home__welcome h2 {
    text-align: center;
    font-size: 30px;
    font-weight: 300;
    color: #222;
    letter-spacing: 1px;
    text-transform: uppercase;
    display: grid;
    grid-template-columns: 1fr max-content 1fr;
    grid-gap: 20px;
    align-items: center;
    padding: 30px 24px 0px 24px;
  }

  .shopddf-home__welcome-text {
    /* max-width: 860px; */
    margin: 0 auto;
    font-size: 1rem;
    line-height: 130%;
    text-align: justify;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  .shopddf-home__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    padding: 12px;
  }

  .shopddf-home__card {
    background: #f1f1f1;
    border: 1px solid #efefef;
    text-align: center;
    text-decoration: none;
  }
  .shopddf-home__card-subtext {
    color: #000;
    text-transform: uppercase;
    font-size: 20px;
    font-weight: bold;
    text-align: center;
    margin: 0;
    height: 70px;
    vertical-align: middle;
    padding: 17px;
    line-height: 20px;
  }
  .shopddf-home__card img {
    display: block;
    width: 100%;
    height: 600px;
    object-fit: cover;
  }

  .shopddf-home__card-placeholder {
    display: block;
    width: 100%;
    height: 600px;
    background: #f2f2f2;
  }

  .shopddf-home__card h3 {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 10px 8px 4px;
  }

  .shopddf-home__card p {
    font-size: 11px;
    color: #4a4a4a;
    margin: 0 8px 10px;
  }

  .shopddf-home__card-link {
    display: inline-block;
    margin-bottom: 12px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: underline;
    color: #0b0b0b;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .shopddf-home__cards {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ShopDDF Home Page",
  "tag": "section",
  "class": "shopddf-home-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image (desktop)"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Hero image (mobile)"
    },
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Welcome heading",
      "default": "Welcome"
    },
    {
      "type": "richtext",
      "id": "hero_text",
      "label": "Welcome text",
      "default": "<p>We offer a diverse selection of iconic beauty products, carefully curated by our seasoned buyers to bring you the epitome of luxury from across the globe.</p>"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Winter Specials"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Only for duty free liquor and tobacco tax exempt diplomats"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "View details"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ShopDDF Home Page",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
