<section class="shopddf-retailstore shopddf-page-section">
  <div class="shopddf-retailstore__intro">
    {% if section.settings.heading != blank %}
      <h2 class="shopddf-retailstore__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.body_text != blank %}
      <div class="shopddf-retailstore__text">{{ section.settings.body_text }}</div>
    {% endif %}
  </div>

  {% assign gallery_blocks = section.blocks | where: "type", "gallery_image" %}
  {% if gallery_blocks.size > 0 %}
    <div class="shopddf-retailstore__gallery">
      {% for block in gallery_blocks %}
        <figure class="shopddf-retailstore__gallery-item" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 900 }}"
              alt="{{ block.settings.image.alt | default: section.settings.heading }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'shopddf-retailstore__gallery-placeholder' }}
          {% endif %}
        </figure>
      {% endfor %}
    </div>
  {% endif %}

  {% assign hours_rows_value = section.settings.hours_rows | strip %}
  {% if section.settings.hours_image != blank or section.settings.hours_heading != blank or hours_rows_value != blank or section.settings.hours_text != blank %}
    <div class="shopddf-retailstore__hours">
      <div class="shopddf-retailstore__hours-media">
        {% if section.settings.hours_image != blank %}
          <img
            src="{{ section.settings.hours_image | image_url: width: 800 }}"
            alt="{{ section.settings.hours_image.alt | default: section.settings.hours_heading }}"
            loading="lazy"
            width="{{ section.settings.hours_image.width }}"
            height="{{ section.settings.hours_image.height }}"
          >
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'shopddf-retailstore__hours-placeholder' }}
        {% endif %}
      </div>
      <div class="shopddf-retailstore__hours-content">
        {% if section.settings.hours_heading != blank %}
          <h3 class="shopddf-retailstore__hours-heading">{{ section.settings.hours_heading }}</h3>
        {% endif %}
        {% if hours_rows_value != blank %}
          <ul class="shopddf-retailstore__hours-list">
            <li class="shopddf-retailstore__hours-row">
              <span class="shopddf-retailstore__hours-day">Monday</span>
              <span class="shopddf-retailstore__hours-time">10:00AM - 5:00PM</span>
            </li>
            <li class="shopddf-retailstore__hours-row">
              <span class="shopddf-retailstore__hours-day">Tuesday</span>
              <span class="shopddf-retailstore__hours-time">10:00AM - 5:00PM</span>
            </li>
            <li class="shopddf-retailstore__hours-row">
              <span class="shopddf-retailstore__hours-day">Wednesday</span>
              <span class="shopddf-retailstore__hours-time">10:00AM - 5:00PM</span>
            </li>
            <li class="shopddf-retailstore__hours-row">
              <span class="shopddf-retailstore__hours-day">Thursday</span>
              <span class="shopddf-retailstore__hours-time">10:00AM - 5:00PM</span>
            </li>
            <li class="shopddf-retailstore__hours-row">
              <span class="shopddf-retailstore__hours-day">Friday</span>
              <span class="shopddf-retailstore__hours-time">10:00AM - 5:00PM</span>
            </li>
            <li class="shopddf-retailstore__hours-row">
              <span class="shopddf-retailstore__hours-day">Saturday & Sunday</span>
              <span class="shopddf-retailstore__hours-time">Closed</span>
            </li>
          </ul>
        {% elsif section.settings.hours_text != blank %}
          <div class="shopddf-retailstore__hours-text">{{ section.settings.hours_text }}</div>
        {% endif %}
      </div>
    </div>
  {% endif %}

  {% assign feature_blocks = section.blocks | where: "type", "feature" %}
  {% if feature_blocks.size > 0 %}
    <div class="shopddf-retailstore__features">
      {% for block in feature_blocks %}
        <article class="shopddf-retailstore__feature" {{ block.shopify_attributes }}>
          {% if block.settings.title != blank %}
            <div>
              <h3>{{ block.settings.title }}</h3>
            </div>
          {% endif %}
          <div class="shopddf-retailstore_feature_body">
            <div class="shopddf-retailstore__feature-icon">
              {% if block.settings.icon != blank %}
                <img
                  src="{{ block.settings.icon | image_url: width: 180 }}"
                  alt="{{ block.settings.icon.alt | default: block.settings.title }}"
                  loading="lazy"
                  width="{{ block.settings.icon.width }}"
                  height="{{ block.settings.icon.height }}"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'shopddf-retailstore__feature-placeholder' }}
              {% endif %}
            </div>
            {% if block.settings.text != blank %}
              <p>{{ block.settings.text }}</p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}

  {% assign store_meta = shop.metafields.custom.shopddf_retails_stores.value %}
  {% if store_meta == blank %}
    {% assign store_meta = shop.metafields.shopddf_retails_stores.value %}
  {% endif %}
  {% assign store_item = store_meta %}
  {% if store_meta != blank and store_meta.first != blank %}
    {% assign store_item = store_meta.first %}
  {% endif %}
  {% assign store_title = store_item.store_title | default: store_item.storeTitle %}
  {% assign store_address = store_item.address %}
  {% assign store_phone = store_item.phone %}
  {% assign store_email = store_item.email %}
  {% assign store_hours = store_item.storeHours | default: store_item.store_hours %}
  {% assign store_map_url = store_item.map | default: store_item.map_url %}
  {% assign has_store_meta = false %}
  {% if store_title != blank or store_address != blank or store_phone != blank or store_email != blank or store_hours != blank or store_map_url != blank %}
    {% assign has_store_meta = true %}
  {% endif %}

  {% assign contact_blocks = section.blocks | where: "type", "contact_card" %}
  {% if has_store_meta or contact_blocks.size > 0 or section.settings.contact_heading != blank or section.settings.map_url != blank %}
    <div class="shopddf-retailstore__contact">
      {% if store_title != blank or section.settings.contact_heading != blank %}
        <div class="shopddf-retailstore__contact-bar">
          <h3>{{ store_title | default: section.settings.contact_heading }}</h3>
        </div>
      {% endif %}
      {% if has_store_meta %}
        <div class="shopddf-retailstore__contact-grid">
          {% if store_address != blank %}
            <article class="shopddf-retailstore__contact-card">
              <h4 class="shopddf-retailstore__contact-title">Address</h4>
              <p class="shopddf-retailstore__contact-text">{{ store_address | newline_to_br }}</p>
            </article>
          {% endif %}
          {% if store_phone != blank %}
            <article class="shopddf-retailstore__contact-card">
              <h4 class="shopddf-retailstore__contact-title">Phone</h4>
              <p class="shopddf-retailstore__contact-text">{{ store_phone }}</p>
            </article>
          {% endif %}
          {% if store_email != blank %}
            <article class="shopddf-retailstore__contact-card">
              <h4 class="shopddf-retailstore__contact-title">Email</h4>
              <p class="shopddf-retailstore__contact-text">{{ store_email }}</p>
            </article>
          {% endif %}
          {% if store_hours != blank %}
            <article class="shopddf-retailstore__contact-card">
              <h4 class="shopddf-retailstore__contact-title">Store Hours</h4>
              <p class="shopddf-retailstore__contact-text">{{ store_hours | newline_to_br }}</p>
            </article>
          {% endif %}
        </div>
      {% elsif contact_blocks.size > 0 %}
        <div class="shopddf-retailstore__contact-grid">
          {% for block in contact_blocks %}
            <article class="shopddf-retailstore__contact-card" {{ block.shopify_attributes }}>
              {% if block.settings.icon != blank %}
                <div class="shopddf-retailstore__contact-icon">
                  <img
                    src="{{ block.settings.icon | image_url: width: 120 }}"
                    alt="{{ block.settings.icon.alt | default: block.settings.title }}"
                    loading="lazy"
                    width="{{ block.settings.icon.width }}"
                    height="{{ block.settings.icon.height }}"
                  >
                </div>
              {% endif %}
              {% if block.settings.title != blank %}
                <h4 class="shopddf-retailstore__contact-title">{{ block.settings.title }}</h4>
              {% endif %}
              {% if block.settings.text != blank %}
                <p class="shopddf-retailstore__contact-text">{{ block.settings.text }}</p>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      {% endif %}
      {% assign map_url_value = store_map_url | default: section.settings.map_url %}
      {% if map_url_value != blank %}
        <div class="shopddf-retailstore__map">
          <iframe
            src="{{ map_url_value }}"
            loading="lazy"
            allowfullscreen
            referrerpolicy="no-referrer-when-downgrade"
            title="{{ store_title | default: section.settings.contact_heading | default: section.settings.heading }}"
            style="height: {{ section.settings.map_height | default: 320 }}px;"
          ></iframe>
        </div>
      {% endif %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .shopddf-retailstore_feature_body {
    float: left;
    width: 100%;
    text-align: center;
    background-image: url('{{ "dd-aboutus-bb.png" | asset_url }}');
    background-position: top center;
    min-height: 305px;
    padding-top: 30px;
  }
  .shopddf-page-section {
    padding-left: 45px !important;
    padding-right: 45px !important;
  }

  .shopddf-retailstore {
    padding-top: 10px;
    padding-bottom: 28px;
  }

  .shopddf-retailstore__intro {
    /* max-width: 980px; */
    margin: 0 auto 24px;
  }

  .shopddf-retailstore__heading {
    font-size: 28px;
    font-weight: 500;
    text-transform: uppercase;
    color: #222;
    letter-spacing: 0.04em;
    border-bottom: 1px solid #d6d6d6;
    padding-bottom: 10px;
    margin: 0 0 16px;
  }

  .shopddf-retailstore__text {
    font-size: 14px;
    line-height: 1.6;
    color: #4a4a4a;
  }

  .shopddf-retailstore__text p {
    margin: 0 0 12px;
  }

  .shopddf-retailstore__gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 16px 0 26px;
  }

  .shopddf-retailstore__gallery-item {
    margin: 0;
    overflow: hidden;
  }

  .shopddf-retailstore__gallery-item img,
  .shopddf-retailstore__gallery-placeholder {
    display: block;
    width: 100%;
    height: 210px;
    object-fit: cover;
    transition: transform 0.35s ease, filter 0.35s ease;
  }

  .shopddf-retailstore__gallery-placeholder {
    background: #f2f2f2;
  }

  .shopddf-retailstore__gallery-item:hover img,
  .shopddf-retailstore__gallery-item:focus-within img {
    transform: scale(1.05);
    filter: saturate(1.05);
  }

  .shopddf-retailstore__hours {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 1px;
    align-items: stretch;
    margin: 10px 0 26px;
    /* border: 1px solid #e0e0e0; */
  }

  .shopddf-retailstore__hours-media img,
  .shopddf-retailstore__hours-placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 240px;
    object-fit: cover;
  }

  .shopddf-retailstore__hours-content {
    padding: 18px 16px 14px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #f7f7f7;
  }

  .shopddf-retailstore__hours-heading {
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 10px;
    color: #222;
    font-size: 30px;
    line-height: 32px;
    margin: 20px 0 8px;
    font-weight: 500;
  }

  .shopddf-retailstore__hours-list {
    list-style: none;
    padding: 0;
    margin: 0;
    /* border: 1px solid #e1e1e1; */
    background: #fff;
    text-transform: uppercase;
  }

  .shopddf-retailstore__hours-row {
    display: flex;
    align-items: center;
    /* justify-content: space-between; */
    padding: 8px 12px;
    font-size: 14px;
    color: #222;
  }

  .shopddf-retailstore__hours-row:nth-child(odd) {
    background: #ededed;
  }

  .shopddf-retailstore__hours-row:nth-child(even) {
    background: #f7f7f7;
  }

  .shopddf-retailstore__hours-day {
    font-weight: 700;
    font-size: 1.3rem;
    width: 280px;
  }

  .shopddf-retailstore__hours-time {
    font-weight: 500;
    font-size: 16px;
    color: #333;
  }

  .shopddf-retailstore__features {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .shopddf-retailstore__feature {
    border: 1px solid #e6e6e6;
    padding: 18px 14px 20px;
    text-align: center;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    background-color: #f9f9f9;
  }

  .shopddf-retailstore__feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }

  .shopddf-retailstore__feature-icon img,
  .shopddf-retailstore__feature-placeholder {
    width: 56px;
    height: 56px;
    object-fit: contain;
  }

  .shopddf-retailstore__feature h3 {
    font-size: 17px;
    text-align: center;
    font-weight: bold;
    text-transform: uppercase;
    margin-top: 20px;
    margin-bottom: 30px;
  }

  .shopddf-retailstore__feature p {
    font-size: 14px;
    line-height: 25px;
    text-align: justify;
    padding: 0;
  }

  .shopddf-retailstore__feature:hover {
    background: #123b6c;
    border-color: #0f2f56;
    color: #fff;
  }

  .shopddf-retailstore__feature:hover h3,
  .shopddf-retailstore__feature:hover p {
    color: #fff;
  }

  .shopddf-retailstore__feature:hover img {
    filter: brightness(0) invert(1);
  }

  .shopddf-retailstore__contact {
    margin: 26px 0 0;
  }

  .shopddf-retailstore__contact-bar {
    background: #1f2b33;
    color: #fff;
    padding: 10px 18px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 14px;
  }

  .shopddf-retailstore__contact-bar h3 {
    margin: 0;
    font-size: 14px;
    font-weight: 600;
  }

  .shopddf-retailstore__contact-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    background: #fff;
    padding: 14px;
  }

  .shopddf-retailstore__contact-card {
    background: #203038;
    color: #fff;
    text-align: center;
    padding: 26px 18px;
    min-height: 180px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .shopddf-retailstore__contact-icon img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    margin-bottom: 10px;
    filter: brightness(0) invert(1);
  }

  .shopddf-retailstore__contact-title {
    margin: 4px 0 6px;
    font-size: 16px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .shopddf-retailstore__contact-text {
    margin: 0;
    font-size: 14px;
    color: #e6eef2;
  }

  .shopddf-retailstore__map {
    border: 1px solid #e0e0e0;
    border-top: 0;
  }

  .shopddf-retailstore__map iframe {
    width: 100%;
    border: 0;
    display: block;
  }

  @media (max-width: 990px) {
    .shopddf-retailstore__gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .shopddf-retailstore__features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .shopddf-retailstore__hours {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .shopddf-page-section {
      padding-left: 24px !important;
      padding-right: 24px !important;
    }

    .shopddf-retailstore__gallery {
      grid-template-columns: 1fr;
    }
    .shopddf-retailstore__hours-day {
      width: 170px;
    }
    .shopddf-retailstore__hours-heading {
      font-size: 26px;
    }
  }

  @media (max-width: 600px) {
    .shopddf-retailstore__features {
      grid-template-columns: 1fr;
    }

    .shopddf-retailstore__contact-grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
