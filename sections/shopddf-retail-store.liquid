<section class="shopddf-retailstore shopddf-page-section">
  <div class="shopddf-retailstore__intro">
    {% if section.settings.heading != blank %}
      <h2 class="shopddf-retailstore__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.body_text != blank %}
      <div class="shopddf-retailstore__text">{{ section.settings.body_text }}</div>
    {% endif %}
  </div>

  {% assign gallery_blocks = section.blocks | where: "type", "gallery_image" %}
  {% if gallery_blocks.size > 0 %}
    <div class="shopddf-retailstore__gallery">
      {% for block in gallery_blocks %}
        <figure class="shopddf-retailstore__gallery-item" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 900 }}"
              alt="{{ block.settings.image.alt | default: section.settings.heading }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'shopddf-retailstore__gallery-placeholder' }}
          {% endif %}
        </figure>
      {% endfor %}
    </div>
  {% endif %}

  {% assign feature_blocks = section.blocks | where: "type", "feature" %}
  {% if feature_blocks.size > 0 %}
    <div class="shopddf-retailstore__features">
      {% for block in feature_blocks %}
        <article class="shopddf-retailstore__feature" {{ block.shopify_attributes }}>
          {% if block.settings.title != blank %}
            <div>
              <h3>{{ block.settings.title }}</h3>
            </div>
          {% endif %}
          <div class="shopddf-retailstore_feature_body">
            <div class="shopddf-retailstore__feature-icon">
              {% if block.settings.icon != blank %}
                <img
                  src="{{ block.settings.icon | image_url: width: 180 }}"
                  alt="{{ block.settings.icon.alt | default: block.settings.title }}"
                  loading="lazy"
                  width="{{ block.settings.icon.width }}"
                  height="{{ block.settings.icon.height }}"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'shopddf-retailstore__feature-placeholder' }}
              {% endif %}
            </div>
            {% if block.settings.text != blank %}
              <p>{{ block.settings.text }}</p>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .shopddf-retailstore_feature_body {
    float: left;
    width: 100%;
    text-align: center;
    background-image: url('{{ "dd-aboutus-bb.png" | asset_url }}');
    background-position: top center;
    min-height: 305px;
    padding-top: 30px;
  }
  .shopddf-page-section {
    padding-left: 45px !important;
    padding-right: 45px !important;
  }

  .shopddf-retailstore {
    padding-top: 10px;
    padding-bottom: 28px;
  }

  .shopddf-retailstore__intro {
    /* max-width: 980px; */
    margin: 0 auto 24px;
  }

  .shopddf-retailstore__heading {
    font-size: 28px;
    font-weight: 500;
    text-transform: uppercase;
    color: #222;
    letter-spacing: 0.04em;
    border-bottom: 1px solid #d6d6d6;
    padding-bottom: 10px;
    margin: 0 0 16px;
  }

  .shopddf-retailstore__text {
    font-size: 14px;
    line-height: 1.6;
    color: #4a4a4a;
  }

  .shopddf-retailstore__text p {
    margin: 0 0 12px;
  }

  .shopddf-retailstore__gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 16px 0 26px;
  }

  .shopddf-retailstore__gallery-item {
    margin: 0;
  }

  .shopddf-retailstore__gallery-item img,
  .shopddf-retailstore__gallery-placeholder {
    display: block;
    width: 100%;
    height: 210px;
    object-fit: cover;
  }

  .shopddf-retailstore__gallery-placeholder {
    background: #f2f2f2;
  }

  .shopddf-retailstore__features {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .shopddf-retailstore__feature {
    border: 1px solid #e6e6e6;
    padding: 18px 14px 20px;
    text-align: center;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    background-color: #f9f9f9;
  }

  .shopddf-retailstore__feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }

  .shopddf-retailstore__feature-icon img,
  .shopddf-retailstore__feature-placeholder {
    width: 56px;
    height: 56px;
    object-fit: contain;
  }

  .shopddf-retailstore__feature h3 {
    font-size: 17px;
    text-align: center;
    font-weight: bold;
    text-transform: uppercase;
    margin-top: 20px;
    margin-bottom: 30px;
  }

  .shopddf-retailstore__feature p {
    font-size: 14px;
    line-height: 25px;
    text-align: justify;
    padding: 0;
  }

  .shopddf-retailstore__feature:hover {
    background: #123b6c;
    border-color: #0f2f56;
    color: #fff;
  }

  .shopddf-retailstore__feature:hover h3,
  .shopddf-retailstore__feature:hover p {
    color: #fff;
  }

  .shopddf-retailstore__feature:hover img {
    filter: brightness(0) invert(1);
  }

  @media (max-width: 990px) {
    .shopddf-retailstore__gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .shopddf-retailstore__features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 768px) {
    .shopddf-page-section {
      padding-left: 24px !important;
      padding-right: 24px !important;
    }

    .shopddf-retailstore__gallery {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 600px) {
    .shopddf-retailstore__features {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

