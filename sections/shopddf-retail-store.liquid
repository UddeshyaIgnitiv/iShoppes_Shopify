<section class="shopddf-retailstore shopddf-page-section">
  <div class="shopddf-retailstore__intro">
    {% if section.settings.heading != blank %}
      <h2 class="shopddf-retailstore__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.body_text != blank %}
      <div class="shopddf-retailstore__text">{{ section.settings.body_text }}</div>
    {% endif %}
  </div>
  {% assign gallery_blocks = section.blocks | where: "type", "gallery_image" %}
  {% if gallery_blocks.size > 0 %}
    <div class="shopddf-retailstore__gallery">
      {% for block in gallery_blocks %}
        <figure class="shopddf-retailstore__gallery-item" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            <img
              src="{{ block.settings.image | image_url: width: 900 }}"
              alt="{{ block.settings.image.alt | default: section.settings.heading }}"
              loading="lazy"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
            >
          {% else %}
            {{ 'image' | placeholder_svg_tag: 'shopddf-retailstore__gallery-placeholder' }}
          {% endif %}
        </figure>
      {% endfor %}
    </div>
  {% endif %}

  {% assign hours_rows_value = section.settings.hours_rows | strip %}
  {% if section.settings.hours_image != blank or section.settings.hours_heading != blank or hours_rows_value != blank or section.settings.hours_text != blank %}
    <div class="shopddf-retailstore__hours">
      <div class="shopddf-retailstore__hours-media">
        {% if section.settings.hours_image != blank %}
          <img
            src="{{ section.settings.hours_image | image_url: width: 800 }}"
            alt="{{ section.settings.hours_image.alt | default: section.settings.hours_heading }}"
            loading="lazy"
            width="{{ section.settings.hours_image.width }}"
            height="{{ section.settings.hours_image.height }}"
          >
          
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'shopddf-retailstore__hours-placeholder' }}
        {% endif %}
        <div class="whPhone">
          <div class="raw-html-embed">
            <p>New York Store Phone #:</p>
            <h3>212.838.9151 Ext 307</h3>
          </div>
        </div>
      </div>
      <div class="shopddf-retailstore__hours-content">
        {% if section.settings.hours_heading != blank %}
          <h3 class="shopddf-retailstore__hours-heading">{{ section.settings.hours_heading }}</h3>
        {% endif %}
        {% if hours_rows_value != blank %}
          <ul class="shopddf-retailstore__hours-list">
            <li class="shopddf-retailstore__hours-row">
              <span class="shopddf-retailstore__hours-day">Monday</span>
              <span class="shopddf-retailstore__hours-time">10:00AM - 5:00PM</span>
            </li>
            <li class="shopddf-retailstore__hours-row">
              <span class="shopddf-retailstore__hours-day">Tuesday</span>
              <span class="shopddf-retailstore__hours-time">10:00AM - 5:00PM</span>
            </li>
            <li class="shopddf-retailstore__hours-row">
              <span class="shopddf-retailstore__hours-day">Wednesday</span>
              <span class="shopddf-retailstore__hours-time">10:00AM - 5:00PM</span>
            </li>
            <li class="shopddf-retailstore__hours-row">
              <span class="shopddf-retailstore__hours-day">Thursday</span>
              <span class="shopddf-retailstore__hours-time">10:00AM - 5:00PM</span>
            </li>
            <li class="shopddf-retailstore__hours-row">
              <span class="shopddf-retailstore__hours-day">Friday</span>
              <span class="shopddf-retailstore__hours-time">10:00AM - 5:00PM</span>
            </li>
            <li class="shopddf-retailstore__hours-row">
              <span class="shopddf-retailstore__hours-day">Saturday & Sunday</span>
              <span class="shopddf-retailstore__hours-time">Closed</span>
            </li>
          </ul>
        {% elsif section.settings.hours_text != blank %}
          <div class="shopddf-retailstore__hours-text">{{ section.settings.hours_text }}</div>
        {% endif %}
      </div>
    </div>
  {% endif %}
  {% assign store_meta_reference = shop.metaobjects.shopddf_retails_stores%}
    {% if store_meta_reference.values %}
      {% for store_meta in store_meta_reference.values %}
        <div class="shopddf-retailstore-meta">
          {% if store_meta.title != blank %}
            <h2 class="shopddf-retailstore-meta__heading">{{ store_meta.title }}</h2>
          {% endif %}

          <div class="shopddf-retailstore__features shopddf-retailstore-meta__features">
            {% if store_meta.address != blank %}
              <div class="shopddf-retailstore__feature retailstore-address shopddf-retailstore-meta__feature">
                <img src="{{ 'address-img.png' | asset_url }}" alt="Address" width="25" height="25" loading="lazy" />
                <h3 class="shopddf-retailstore-meta__feature-label">Address</h3>
                <p class="shopddf-retailstore-meta__feature-value">{{ store_meta.address }}</p>
              </div>
            {% endif %}

            {% if store_meta.phone != blank %}
              {% assign phone_value = store_meta.phone | strip %}
              <div class="shopddf-retailstore__feature retailstore-phone shopddf-retailstore-meta__feature">
                <img src="{{ 'phone-img.png' | asset_url }}" alt="Address" width="25px" height="25px" loading="lazy" />
                <h3 class="shopddf-retailstore-meta__feature-label">Phone</h3>
                <p class="shopddf-retailstore-meta__feature-value">
                  <a href="tel:{{ phone_value | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}">{{ phone_value }}</a>
                </p>
              </div>
            {% endif %}

            {% if store_meta.email != blank %}
              {% assign email_value = store_meta.email | strip %}
              <div class="shopddf-retailstore__feature retailstore-email shopddf-retailstore-meta__feature">
                <img src="{{ 'email-img.png' | asset_url }}" alt="Address" width="25px" height="25px" loading="lazy" />
                <h3 class="shopddf-retailstore-meta__feature-label">Email</h3>
                <p class="shopddf-retailstore-meta__feature-value">
                  <a href="mailto:{{ email_value }}">{{ email_value }}</a>
                </p>
              </div>
            {% endif %}
            {% if store_meta.storehours != blank %}
              <div class="shopddf-retailstore__feature retailstore-hours shopddf-retailstore-meta__feature">
                <img src="{{ 'clock-img.png' | asset_url }}" alt="Address" width="25px" height="25px" loading="lazy" />
                <h3 class="shopddf-retailstore-meta__feature-label">Store Hours</h3>
                <div class="shopddf-retailstore-meta__feature-value">
                  {% assign hours_field = store_meta.storehours %}
                  {% if hours_field.value != blank %}
                    {{ hours_field | metafield_tag }}
                  {% else %}
                    {{ hours_field | newline_to_br }}
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>

          {% if store_meta.map != blank %}
            <div class="shopddf-retailstore-meta__map">
              {% assign map_field = store_meta.map %}
              {% if map_field.value != blank %}
                <iframe src="{{ map_field.value }}" width="100%" frameborder="0" allowfullscreen=""></iframe>
              {% else %}
                {{ map_field }}
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
  {% endif %}

  
</section>

{% stylesheet %}
  .shopddf-retailstore_feature_body {
    float: left;
    width: 100%;
    text-align: center;
    background-image: url('{{ "dd-aboutus-bb.png" | asset_url }}');
    background-position: top center;
    min-height: 305px;
    padding-top: 30px;
  }
  .shopddf-page-section {
    padding-left: 45px !important;
    padding-right: 45px !important;
  }

  .shopddf-retailstore {
    padding-top: 10px;
    padding-bottom: 28px;
  }

  .shopddf-retailstore-meta {
    padding-bottom: 28px;
  }

  .shopddf-retailstore-meta__heading {
    font-weight: 500;
    text-transform: uppercase;
    background-color: rgb(32, 39, 45);
    color: rgb(255, 255, 255);
    font-size: 1.5rem;
    padding-top: 15px;
    padding-left: 30px;
    height: 50px;
  }

  .shopddf-retailstore-meta__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 0 0 18px;
  }

  .shopddf-retailstore-meta__feature {
    text-align: center;
  }

  .shopddf-retailstore-meta__feature-label {
    font-size: 16px;
    letter-spacing: 0.06em;
    margin: 10px 0 12px;
    text-transform: uppercase;
  }

  .shopddf-retailstore-meta__feature-value {
    margin: 20px;;
    font-size: 14px;
    line-height: 1.6;
    text-align: center;
  }

  .shopddf-retailstore-meta__feature-value a {
    color: inherit;
    text-decoration: none;
  }

  .shopddf-retailstore-meta__feature-value a:hover {
    text-decoration: underline;
  }

  .shopddf-retailstore-meta__map {
    border: 1px solid #e1e1e1;
    background: #fff;
    height: 400px;
  }

  .shopddf-retailstore-meta__map iframe,
  .shopddf-retailstore-meta__map img {
    display: block;
    width: 100%;
    min-height: 400px;
    border: 0;
  }
  .whPhone {
    background-color: #0156B1;
    color: #fff;
    text-align: center;
    width: 100%;
  }
  .whPhone p {
    text-align: center;
  }
  .whPhone h3 {
    font-size: 1.5rem;
    font-weight: 400;
    padding-bottom: 10px;
  }
  .shopddf-retailstore__intro {
    /* max-width: 980px; */
    margin: 0 auto 24px;
  }
  .shopddf-retailstore-meta__feature img {
    display: block;
    max-width: 15%;
    height: auto;
    object-fit: contain;
    margin: 30px auto;
  }
  .shopddf-retailstore__heading {
    font-size: 28px;
    font-weight: 500;
    text-transform: uppercase;
    color: #222;
    letter-spacing: 0.04em;
    border-bottom: 1px solid #d6d6d6;
    padding-bottom: 10px;
    margin: 0 0 16px;
  }

  .shopddf-retailstore__text {
    font-size: 14px;
    line-height: 1.6;
    color: #4a4a4a;
  }

  .shopddf-retailstore__text p {
    margin: 0 0 12px;
  }

  .shopddf-retailstore__gallery {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 16px 0 26px;
  }

  .shopddf-retailstore__gallery-item {
    margin: 0;
    overflow: hidden;
  }

  .shopddf-retailstore__gallery-item img,
  .shopddf-retailstore__gallery-placeholder {
    display: block;
    width: 100%;
    height: 210px;
    object-fit: cover;
    transition: transform 0.35s ease, filter 0.35s ease;
  }

  .shopddf-retailstore__gallery-placeholder {
    background: #f2f2f2;
  }

  .shopddf-retailstore__gallery-item:hover img,
  .shopddf-retailstore__gallery-item:focus-within img {
    transform: scale(1.05);
    filter: saturate(1.05);
  }

  .shopddf-retailstore__hours {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 1px;
    align-items: stretch;
    margin: 10px 0 26px;
    /* border: 1px solid #e0e0e0; */
  }

  .shopddf-retailstore__hours-media img,
  .shopddf-retailstore__hours-placeholder {
    display: block;
    width: 100%;
    height: 85%;
    min-height: 240px;
    object-fit: cover;
  }

  .shopddf-retailstore__hours-content {
    padding: 18px 16px 14px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: #f7f7f7;
  }

  .shopddf-retailstore__hours-heading {
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 10px;
    color: #222;
    font-size: 30px;
    line-height: 32px;
    margin: 20px 0 8px;
    font-weight: 500;
  }

  .shopddf-retailstore__hours-list {
    list-style: none;
    padding: 0;
    margin: 0;
    /* border: 1px solid #e1e1e1; */
    background: #fff;
    text-transform: uppercase;
  }

  .shopddf-retailstore__hours-row {
    display: flex;
    align-items: center;
    /* justify-content: space-between; */
    padding: 8px 12px;
    font-size: 14px;
    color: #222;
  }

  .shopddf-retailstore__hours-row:nth-child(odd) {
    background: #ededed;
  }

  .shopddf-retailstore__hours-row:nth-child(even) {
    background: #f7f7f7;
  }

  .shopddf-retailstore__hours-day {
    font-weight: 700;
    font-size: 1.3rem;
    width: 280px;
  }

  .shopddf-retailstore__hours-time {
    font-weight: 500;
    font-size: 16px;
    color: #333;
  }

  .shopddf-retailstore__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    padding: 20px;
  }

  .shopddf-retailstore__feature {
    border: 1px solid #e6e6e6;
    padding: 18px 14px 20px;
    text-align: center;
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    text-align: center;
    background: #1E2E33;
    color: white;
  }

  .shopddf-retailstore__feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
  }

  .shopddf-retailstore__feature-icon img,
  .shopddf-retailstore__feature-placeholder {
    width: 56px;
    height: 56px;
    object-fit: contain;
  }

  .shopddf-retailstore__feature h3 {
    font-size: 17px;
    text-align: center;
    font-weight: 400;
    text-transform: uppercase;
    margin-top: 20px;
    /* margin-bottom: 30px; */
    font-size: 1.125rem;
  }

  .shopddf-retailstore__feature p {
    font-size: 14px;
    line-height: 25px;
    text-align: center;
    padding: 0;
  }



  .shopddf-retailstore__feature:hover img {
    /* filter: brightness(0) invert(1); */
  }

  @media (max-width: 990px) {
    .shopddf-retailstore__gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .shopddf-retailstore__features {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .shopddf-retailstore__hours {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .shopddf-page-section {
      padding-left: 24px !important;
      padding-right: 24px !important;
    }

    .shopddf-retailstore__gallery {
      grid-template-columns: 1fr;
    }
    .shopddf-retailstore__hours-day {
      width: 170px;
    }
    .shopddf-retailstore__hours-heading {
      font-size: 26px;
    }
    .shopddf-retailstore__hours-media img {
      height: 80%;
    }
  }

  @media (max-width: 600px) {
    .shopddf-retailstore__features {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ShopDDF Retails Store",
  "tag": "section",
  "class": "shopddf-retailstore-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Retail Store"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>As Manhattan's sole travel retail boutique, ShopDDF has garnered an international reputation for excellence in quality, creativity, and uniqueness. Situated in the heart of Midtown Manhattan, our emphasis on exclusive products, extensive range of goods, competitive pricing, and dedicated focus have allowed us to build strong relationships with our clientele.</p><p>Whether you are traveling to or from New York City, a visit to our Diplomatic Duty Free Shops is sure to leave a lasting impression as a reflection of Manhattan's incomparable spirit as the world's greatest city. Our shop offers a wide selection of the most sought-after and esteemed brands, including designer skincare, cosmetics, fragrances, and food and gifts.</p><p>Our team of multilingual sales staff is always on hand to provide excellent customer service in any language that you feel most comfortable speaking. Additionally, our shop is conveniently located mere steps from the United Nations, making it a popular destination for members of the diplomatic and UN communities.</p>"
    },
    {
      "type": "image_picker",
      "id": "hours_image",
      "label": "Hours image"
    },
    {
      "type": "text",
      "id": "hours_heading",
      "label": "Hours heading",
      "default": "Hours of Operation"
    },
    {
      "type": "textarea",
      "id": "hours_rows",
      "label": "Hours rows (one per line: Day|Time)",
      "default": "Monday|10:00AM - 5:00PM\nTuesday|10:00AM - 5:00PM\nWednesday|10:00AM - 5:00PM\nThursday|10:00AM - 5:00PM\nFriday|10:00AM - 5:00PM\nSaturday & Sunday|Closed"
    },
    {
      "type": "richtext",
      "id": "hours_text",
      "label": "Hours text",
      "default": "<p><strong>Monday</strong> 10:00AM - 5:00PM</p><p><strong>Tuesday</strong> 10:00AM - 5:00PM</p><p><strong>Wednesday</strong> 10:00AM - 5:00PM</p><p><strong>Thursday</strong> 10:00AM - 5:00PM</p><p><strong>Friday</strong> 10:00AM - 5:00PM</p><p><strong>Saturday &amp; Sunday</strong> CLOSED</p>"
    }
  ],
  "blocks": [
    {
      "type": "gallery_image",
      "name": "Gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Expert Team"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Our multilingual sales staff is there to provide excellent customer service in any language you feel comfortable speaking."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ShopDDF Retails Store",
      "blocks": [
        {
          "type": "gallery_image"
        },
        {
          "type": "gallery_image"
        },
        {
          "type": "gallery_image"
        },
        {
          "type": "feature",
          "settings": {
            "title": "Expert Team",
            "text": "Our multilingual sales staff is there to provide excellent customer service in any language you feel comfortable speaking."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Premium Brands",
            "text": "The store is a merchandising paradise with an extensive array of fragrances, cosmetics, skincare products, and more."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "Quality Standards",
            "text": "With an enduring international reputation for quality, creativity, and uniqueness, we stand apart in Midtown Manhattan."
          }
        },
        {
          "type": "feature",
          "settings": {
            "title": "First Class Experience",
            "text": "Our focus on distinctive products and competitive pricing delivers a first-class experience for every client."
          }
        }
      ]
    }
  ]
}
{% endschema %}
