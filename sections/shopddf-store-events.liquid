<div class="section page-width-normal store-events-section">
  <div class="store-events">
    {% if section.settings.heading != blank %}
      <h2 class="store-events__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    <div class="store-events__divider"></div>

    {% if section.blocks.size > 0 %}
      <div class="store-events__grid">
        {% for block in section.blocks %}
          <article class="store-event-card" {{ block.shopify_attributes }}>
            <div class="store-event-card__media">
              {% if block.settings.image != blank %}
                <img
                  src="{{ block.settings.image | image_url: width: 900 }}"
                  alt="{{ block.settings.image.alt | default: block.settings.title }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'store-event-card__placeholder' }}
              {% endif %}

              {% assign has_date = false %}
              {% if block.settings.start_day != blank or block.settings.start_month != blank %}
                {% assign has_date = true %}
              {% endif %}
              {% if has_date %}
                <div class="store-event-card__date">
                  {% assign day_line = '' %}
                  {% if block.settings.start_day != blank %}
                    {% assign day_line = block.settings.start_day %}
                  {% endif %}
                  {% if block.settings.end_day != blank %}
                    {% if day_line != blank %}
                      {% assign day_line = day_line | append: ' - ' | append: block.settings.end_day %}
                    {% else %}
                      {% assign day_line = block.settings.end_day %}
                    {% endif %}
                  {% endif %}

                  {% assign month_line = '' %}
                  {% if block.settings.start_month != blank %}
                    {% assign month_line = block.settings.start_month %}
                  {% endif %}
                  {% if block.settings.end_month != blank %}
                    {% if month_line != blank %}
                      {% assign month_line = month_line | append: ' - ' | append: block.settings.end_month %}
                    {% else %}
                      {% assign month_line = block.settings.end_month %}
                    {% endif %}
                  {% endif %}

                  {% if day_line != blank %}
                    <span class="store-event-card__date-line store-event-card__date-line--day">{{ day_line }}</span>
                  {% endif %}
                  {% if month_line != blank %}
                    <span class="store-event-card__date-line store-event-card__date-line--month">{{ month_line }}</span>
                  {% endif %}
                </div>
              {% endif %}
            </div>

            <div class="store-event-card__body">
              {% if block.settings.title != blank %}
                <h3 class="store-event-card__title">{{ block.settings.title }}</h3>
              {% endif %}
              {% if block.settings.time != blank %}
                <p class="store-event-card__meta"><strong>Event Time:</strong> {{ block.settings.time }}</p>
              {% endif %}
              {% if block.settings.location != blank %}
                <p class="store-event-card__meta"><strong>Location:</strong> {{ block.settings.location }}</p>
              {% endif %}

              {% if block.settings.link != blank %}
                <a class="store-event-card__link" href="{{ block.settings.link }}">
                  {{ block.settings.link_label | default: 'Learn More' }}
                </a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .store-events-section {
    padding: 32px 0 48px;
  }

  .store-events {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .store-events__heading {
    font-size: clamp(1.8rem, 2.6vw, 2.4rem);
    font-weight: 500;
    margin: 0;
  }

  .store-events__divider {
    height: 1px;
    background: #d9d9d9;
    width: 100%;
  }

  .store-events__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }

  .store-event-card {
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 2px 10px rgba(17, 17, 17, 0.12);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .store-event-card__media {
    position: relative;
    background: #f2f2f2;
  }

  .store-event-card__media img,
  .store-event-card__placeholder {
    display: block;
    width: 100%;
    height: auto;
  }

  .store-event-card__date {
    position: absolute;
    left: 16px;
    bottom: 16px;
    background: #0b5aa4;
    color: #fff;
    padding: 10px 14px;
    border-radius: 6px;
    text-align: center;
    min-width: 88px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.18);
  }

  .store-event-card__date-line {
    display: block;
    line-height: 1.1;
    letter-spacing: 0.02em;
  }

  .store-event-card__date-line--day {
    font-size: 1.15rem;
    font-weight: 600;
  }

  .store-event-card__date-line--month {
    font-size: 0.95rem;
    opacity: 0.9;
  }

  .store-event-card__body {
    padding: 18px 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .store-event-card__title {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
  }

  .store-event-card__meta {
    margin: 0;
    font-size: 0.95rem;
  }

  .store-event-card__link {
    margin-top: auto;
    align-self: flex-end;
    color: #1976c5;
    font-weight: 600;
    text-decoration: none;
  }

  .store-event-card__link:hover {
    text-decoration: underline;
  }

  @media screen and (max-width: 749px) {
    .store-events-section {
      padding: 24px 0 36px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Store events",
  "class": "section-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Store Events"
    }
  ],
  "blocks": [
    {
      "type": "event",
      "name": "Event",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Event title"
        },
        {
          "type": "text",
          "id": "time",
          "label": "Event time",
          "default": "12:00 AM"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location"
        },
        {
          "type": "text",
          "id": "start_day",
          "label": "Start day",
          "default": "7"
        },
        {
          "type": "text",
          "id": "end_day",
          "label": "End day",
          "default": "28"
        },
        {
          "type": "text",
          "id": "start_month",
          "label": "Start month",
          "default": "Feb"
        },
        {
          "type": "text",
          "id": "end_month",
          "label": "End month",
          "default": "Feb"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Learn More"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Store events",
      "blocks": [
        {
          "type": "event"
        },
        {
          "type": "event"
        }
      ]
    }
  ]
}
{% endschema %}
