];

const airportList = document.getElementById("airportList");

airports.forEach((a,i)=>{
airportList.innerHTML+=`
<div class="airport-card">
  <h3>${a.code} - ${a.city}</h3>
  <p>${a.name}</p>
  <button onclick="showTerminals(${i})">View Terminals</button>
</div>`;
});

window.showTerminals=(i)=>{
const a=airports[i];
document.getElementById("terminalAirportTitle").innerText=`${a.code} Terminals`;
document.getElementById("terminalCards").innerHTML=a.terminals.map((t,j)=>`
<div class="terminal-card" onclick="showStores(${i},${j})">
<img src="${t.image}">
<div class="card-name">${t.name}</div>
</div>`).join("");
document.getElementById("terminalDetailSection").style.display="block";
document.getElementById("storeDetailSection").style.display="none";
};

window.showStores=(i,j)=>{
const t=airports[i].terminals[j];
document.getElementById("storeTerminalTitle").innerText=t.name+" Stores";
const wrapClass = t.stores.length>5 ? "carousel" : "";
document.getElementById("storeCards").className="store-card-container "+wrapClass;
document.getElementById("storeCards").innerHTML=t.stores.map(s=>`
<div class="store-card">
<img src="${s.image}">
<div class="card-name">${s.name}</div>
</div>`).join("");
document.getElementById("storeDetailSection").style.display="block";
document.getElementById("storeDetailSection").scrollIntoView({behavior:"smooth"});
};
</script>

