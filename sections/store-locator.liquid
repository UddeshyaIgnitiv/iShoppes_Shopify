<div class="store-locator-section container" style="display:flex;">
  <div id="airportList"></div>
  <div id="airportmap">
    <img src="https://ishoppes.com/usa_map-e7A.png">
  </div>
</div>

<!-- TERMINAL VIEW -->
<div id="terminalDetailSection" class="terminal-section" style="display:none;">
  <h2 id="terminalAirportTitle"></h2>
  <div id="terminalCards" class="terminal-card-container"></div>
</div>

<!-- STORE VIEW -->
<div id="storeDetailSection" class="terminal-section" style="display:none;">
  <h2 id="storeTerminalTitle"></h2>
  <div id="storeCards" class="store-card-container"></div>
</div>

<style>
.container { width:95%; margin:auto; }
#airportList { width:34%; }
#airportmap { width:66%; text-align:center; }
#airportmap img { width:90%; }

.airport-card {
  border:1px solid #000;
  padding:16px;
  border-radius:10px;
  margin-bottom:14px;
}
.airport-card button {
  width:100%;
  background:#000;
  color:#fff;
  padding:10px;
  border-radius:8px;
  border:none;
  cursor:pointer;
}

.terminal-section {
  border:1px solid #ccc;
  padding:20px;
  border-radius:12px;
  margin-top:20px;
}

.terminal-card-container,
.store-card-container {
  display:flex;
  gap:20px;
  margin-top:20px;
}

.terminal-card,
.store-card {
  width:280px;
  height:180px;
  position:relative;
  border-radius:10px;
  overflow:hidden;
  cursor:pointer;
}

.terminal-card img,
.store-card img {
  width:100%;
  height:100%;
  object-fit:cover;
}

.card-name {
  position:absolute;
  bottom:10px;
  left:10px;
  color:#fff;
  font-size:18px;
  font-weight:bold;
  text-shadow:2px 2px 4px #000;
}

/* Carousel when >5 */
.carousel {
  overflow-x:auto;
  flex-wrap:nowrap;
}
</style>

