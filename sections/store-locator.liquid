      stores:[
        { name:"iS Duty Free", image:"https://cdn.shopify.com/s/files/1/0725/3553/9901/files/bradley_site_52_f31b55ff93.jpg?v=1767761196" }
      ]
    }
  ]
},
{
  code:"BWI",
  city:"Baltimore, MD",
  name:"International Thurgood Marshall Airport",
  terminals:[
    {
      name:"Terminal A",
      image:"https://cdn.shopify.com/s/files/1/0725/3553/9901/files/bwi_glam_4890d8af5a.webp?v=1767762974",
      stores:[
        { name:"MAC", image:"https://cdn.shopify.com/s/files/1/0725/3553/9901/files/NEW_2024_9a63ca404c.webp?v=1767762909" }
      ]
    }
  ]
},
{
  code:"IAD",
  city:"Washington DC",
  name:"Washington Dulles International Airport",
  terminals:[
    {
      name:"Terminal B",
      image:"https://cdn.shopify.com/s/files/1/0725/3553/9901/files/thumbnail_4_321af172ac_27b769cd35_1.jpg?v=1767763052",
      stores:[
        { name:"Estee Lauder Companies", image:"https://cdn.shopify.com/s/files/1/0725/3553/9901/files/01_IAD_Washington_dfa2973e8c.jpg?v=1767763094" }
      ]
    }
  ]
},
{
  code: "JFK",
  city: "Queens, NY",
  name: "John F. Kennedy International Airport",
  terminals: [
    {
      name: "Terminal 1",
      image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/T1_Entrance_1_2e337ded94.jpg?v=1767763519",
      stores: [
        { name: "Bvlgari", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/t1_bvlgari_2e9f07688c.webp?v=1767764322" },
        { name: "Coach", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/t1_coach_d52a0bc1f2.webp?v=1767764347" },
        { name: "Estee Lauder", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/estee_lauder_2d4ccdc91c.jpg?v=1767764358" },
        { name: "Hermes", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/t1_hermes_0aa8d4d864.webp?v=1767764371" },
        { name: "iS Beauty", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/t1_beauty_04701dff6d.jpg?v=1767764385" },
        { name: "iS Duty Free", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/t1_duty_free_ee190535d5.webp?v=1767764760" },
        { name: "Longchamp", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/Longchamp_2f3610cac7.jpg?v=1767764770" },
        { name: "Salvatore Ferragamo", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/t1_ferragamo_5131da00f7.webp?v=1767764793" },
        { name: "Chanel", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/T1_CHANEL_new_6aca5767ff.webp?v=1767765016" },
        { name: "Dior", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/t1_dior_c1dcbd56e7_1.jpg?v=1767765182" },
        { name: "Beauty Concept", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/Photo_Jul_31_2024_4_42_32_PM_1_f1a6adc74f_1.jpg?v=1767765249" }
      ]
    },
    {
      name: "Terminal 5",
      image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/t5_entrance_1_505d77df13.jpg?v=1767763531",
      stores: [
        { name: "iS Sun & Time Kiosk", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/sun_096ffa7663.jpg?v=1767764135" },
        { name: "iS Beauty", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/isbeauty_12a6f98914.jpg?v=1767764155" },
        { name: "Duty Free", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/IMG_3258_d5c001a179.webp?v=1767764174" }
      ]
    }
  ]
},
{
  code: "IAH",
  city: "Houston, TX",
  name: "George Bush Intercontinental Airport",
  terminals: [
    {
      name: "Terminal A",
      image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/iah_ta_758fe4090e.jpg?v=1767763609",
      stores: [
        { name: "Terminal A North", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/terminal_a_north_61ba863898.jpg?v=1767763724" },
        { name: "Terminal A South", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/terminal_a_south_42a25da0db.jpg?v=1767763741" }
      ]
    },
    {
      name: "Terminal C",
      image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/new_terminal_c_beauty_ed624f08fb.jpg?v=1767763655",
      stores: [
        { name: "Terminal C Duty Free", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/TERMINAL_C_DUTY_FREE_3dff235153.jpg?v=1767763859" },
        { name: "Terminal C Beauty", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/TERMINAL_C_BEAUTY_9a430c2ebd.jpg?v=1767763872" }
      ]
    },
    {
      name: "Terminal D",
      image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/New_front_store_2025_1_ab51410e37.jpg?v=1767763673",
      stores: [
        { name: "Chanel", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/Chanel_Houston_84c62a48a8.webp?v=1767763959" },
        { name: "Hersheys", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/hersheys_837bcaca73.jpg?v=1767764054" },
        { name: "iS Duty Free", image: "https://cdn.shopify.com/s/files/1/0725/3553/9901/files/D_Storefront_0cec69ab50.webp?v=1767764050" }
      ]
    }
  ]
}
];

const airportList = document.getElementById("airportList");
const locationSelector = document.getElementById('locationSelector')

airports.forEach((a,i)=>{
airportList.innerHTML+=`
<div class="airport-card">
  <h4>${a.code} - ${a.city}</h4>
  <p>${a.name}</p>
  <button onclick="showTerminals(${i})">View Terminals</button>
</div>`;
});

airports.forEach((a, i) => {
  locationSelector.innerHTML += `
    <div class="locationImage locatio${a.code}">
      <img onclick="showTerminals(${i})" data-value="${a.code}" src="https://ishoppes.com/media/catalog/product/placeholder/default/iShoppesLogoFixed_1.png">
      <span class="tooltip">${a.code}</span>
    </div>
  `;
});

window.showTerminals = (i) => {

  const a = airports[i];

  const wrappers = document.querySelectorAll(".locationImage");

  wrappers.forEach(w => {
    w.querySelector("img").classList.remove("active");
    w.querySelector(".tooltip").style.display = "none";
  });

  const target = document.querySelector(`.locationImage.locatio${a.code}`);

  if (target) {
    const img = target.querySelector("img");
    const tooltip = target.querySelector(".tooltip");

    img.classList.add("active");
    tooltip.style.display = "block";
  }

  document.getElementById("terminalAirportTitle").innerText =
    `${a.code} Terminals`;

  document.getElementById("terminalCards").innerHTML =
    a.terminals.map((t, j) => `
      <div class="terminal-card" onclick="showStores(${i},${j})">
        <img src="${t.image}">
        <div class="card-name">${t.name}</div>
      </div>
    `).join("");

  const terminalSection = document.getElementById("terminalDetailSection");
  terminalSection.style.display = "block";

  document.getElementById("storeDetailSection").style.display = "none";
  const offset = -200; 

  const y =
    terminalSection.getBoundingClientRect().top +
    window.pageYOffset +
    offset;

  window.scrollTo({
    top: y,
    behavior: "smooth"
  });
};

window.showStores = (i, j) => {
  const t = airports[i].terminals[j];

  document.getElementById("storeTerminalTitle").innerText =
    t.name + " Stores";

  const storeCards = document.getElementById("storeCards");
  storeCards.innerHTML = "";

  if (t.stores.length > 5) {
    storeCards.className = "store-carousel";

    storeCards.innerHTML = `
      <div class="carousel-track">
        ${t.stores.map(s => `
          <div class="store-card">
            <img src="${s.image}">
            <div class="card-name">${s.name}</div>
          </div>
        `).join("")}
      </div>
     <div>
      <button class="carousel-btn prev">‹</button>
      <button class="carousel-btn next">›</button>
     </div>
    `;

    const track = storeCards.querySelector(".carousel-track");
    const prevBtn = storeCards.querySelector(".prev");
    const nextBtn = storeCards.querySelector(".next");

    const cardWidth = 220; 

    prevBtn.onclick = () => {
      track.scrollBy({ left: -cardWidth, behavior: "smooth" });
    };

    nextBtn.onclick = () => {
      track.scrollBy({ left: cardWidth, behavior: "smooth" });
    };

  } else {
    storeCards.className = "store-card-container";

    storeCards.innerHTML = t.stores.map(s => `
      <div class="store-card">
        <img src="${s.image}">
        <div class="card-name">${s.name}</div>
      </div>
    `).join("");
  }

const storeSection = document.getElementById("storeDetailSection");
storeSection.style.display = "block";

const offset = -200; // keep 100px space on top
const y =
  storeSection.getBoundingClientRect().top +
  window.pageYOffset +
  offset;

window.scrollTo({
  top: y,
  behavior: "smooth"
});
};

</script>

