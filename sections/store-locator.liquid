<div class="store-locator-section container" style="display:flex; padding-bottom:20px;">
  <div id="airportList"></div>
  <div id="airportmap">
    <img src="https://ishoppes.com/usa_map-e7A.png">
    <div id="locationSelector"></div>
  </div>
</div>

<!-- TERMINAL VIEW -->
<div id="terminalDetailSection" class="terminal-section" style="display:none;">
  <h4 id="terminalAirportTitle"></h4>
  <div id="terminalCards" class="terminal-card-container"></div>
</div>

<!-- STORE VIEW -->
<div id="storeDetailSection" class="terminal-section" style="display:none;">
  <h4 id="storeTerminalTitle"></h4>
  <div id="storeCards" class="store-card-container"></div>
</div>

<style>
.container { width:95%; margin:auto; }
#airportList {
    width: 34%;
    height: 550px;
    overflow: auto;
    padding:0 15px;
}
#airportmap {
  width:66%;
  text-align:center;
  display:flex;
  justify-content:center;
  align-items:center;
  position: relative;
  padding: 20px;
 }
#airportmap img { 
  width:100%;
  height: 100%;
  object-fit: contain;
}
.airport-card h4 {
    margin-bottom: 20px;
}
.airport-card {
  border:1px solid #000;
  padding:16px;
  border-radius:10px;
  margin-bottom:14px;
}
.airport-card button {
  width:100%;
  background:#000;
  color:#fff;
  padding:10px;
  border-radius:8px;
  border:none;
  cursor:pointer;
}

.terminal-section {
  border:1px solid #ccc;
  padding:20px;
  border-radius:12px;
  margin-top:20px;
}

.terminal-card-container,
.store-card-container {
  display:flex;
  gap:20px;
  margin-top:20px;
}

.terminal-card,
.store-card {
  width:280px;
  height:180px;
  position:relative;
  border-radius:10px;
  overflow:hidden;
  cursor:pointer;
}

.terminal-card img,
.store-card img {
  width:100%;
  height:100%;
  object-fit:cover;
  border-radius: 5px;
}

.card-name {
  position:absolute;
  bottom:10px;
  left:10px;
  color:#fff;
  font-size:18px;
  font-weight:bold;
  text-shadow:2px 2px 4px #000;
  padding-left:10px;
}

/* Carousel when >5 */
.carousel {
  overflow-x:auto;
  flex-wrap:nowrap;
}
.locationImage img{
 width: 28px !important;
 cursor:pointer;
 border-radius:50%;
}
.locationImage{
position:absolute;
}
.locationImage.locatioBDL {
    top: 27%;
    left: 88%;
}
.locationImage.locatioBWI {
    top: 38%;
    left: 82%;
}
.locationImage.locatioIAD {
    top: 39%;
    left: 87%;
}
.locationImage.locatioJFK {
    top: 31%;
    left: 85%;
}
.locationImage.locatioIAH {
    top: 78%;
    left: 49%;
}
.tooltip{
    position: absolute;
    top: 2px;
    left: 4em;
    background: #000;
    z-index: 111;
    color: #fff;
    font-weight: 600;
    padding: 2px 13px;
    border-radius: 0 3px 3px 0;
    font-size: 12px;
    display:none;
}
span.tooltip:before {
    content: ' ';
    height: 0;
    position: absolute;
    width: 0;
    left: -24px;
    border: 12px solid transparent;
    border-right-color: #000;
    top: 0;
}
.locationImage:hover .tooltip{
  display:block !important;
}
.locationImage:hover img {
    transform: scale(1.2);
    box-shadow: 3px 3px 3px #000;
}
.locationImage img.active {
    transform: scale(1.2);
    box-shadow: 3px 3px 3px #000;
}

.store-carousel {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
}

.carousel-track {
  display: flex;
  gap: 16px;
  overflow-x: hidden;
  scroll-behavior: smooth;
  width: 100%;
}

.store-card {
  min-width: 200px;
  flex-shrink: 0;
  background: #fff;
  border-radius: 8px;
  padding: 10px;
}

.carousel-btn {
  border: none;
  background: #000;
  color: #fff;
  font-size: 22px;
  cursor: pointer;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  margin: 0 10px;
}

.carousel-btn:hover {
  background: #444;
}
@media(max-width:1200px){
.locationImage img{
 width: 22px !important;
}
.locationImage.locatioIAH {
    top: 70%;
}
.locationImage.locatioBDL {
    top: 33%;
}
.locationImage.locatioJFK {
    top: 36%;
}
.locationImage.locatioIAD {
    top: 42%;
}
.locationImage.locatioBWI {
    top: 41%;
}
}
@media(max-width:992px){
  .store-locator-section{
    flex-wrap: wrap;
  }
  #airportList {
    width: 100%;
    height:auto;
}
#airportmap {
  display:none;
 }
}
</style>

<script>
const airports = [
{
