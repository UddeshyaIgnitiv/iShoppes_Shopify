const airportList = document.getElementById("airportList");
const locationSelector = document.getElementById('locationSelector')

airports.forEach((a,i)=>{
airportList.innerHTML+=`
<div class="airport-card">
  <h4>${a.code} - ${a.city}</h4>
  <p class="airportName">${a.name}</p>
  <button onclick="showTerminals(${i})">View Terminals</button>
</div>`;
});

function setAirportListMaxHeight() {
  const list = document.getElementById("airportList");
  if (!list) return;
  const cards = list.querySelectorAll(".airport-card");
  if (!cards.length) return;
  const gap =
    parseFloat(window.getComputedStyle(cards[0]).marginBottom) || 14;
  const visible = Math.min(5, cards.length);
  let total = 0;
  for (let i = 0; i < visible; i++) {
    total += cards[i].offsetHeight;
    if (i < visible - 1) total += gap;
  }
  list.style.maxHeight = total + "px";
}
setAirportListMaxHeight();
window.addEventListener("resize", setAirportListMaxHeight);

airports.forEach((a, i) => {
  locationSelector.innerHTML += `
    <div class="locationImage locatio${a.code}">
      <img onclick="showTerminals(${i})" data-value="${a.code}" src="https://cdn.shopify.com/s/files/1/0725/3553/9901/files/iShoppesLogoFixed_1.png?v=1774289626">
      <span class="tooltip">${a.code}</span>
    </div>
  `;
});

window.showTerminals = (i) => {

  const a = airports[i];

  const wrappers = document.querySelectorAll(".locationImage");

  wrappers.forEach(w => {
    w.querySelector("img").classList.remove("active");
    w.querySelector(".tooltip").style.display = "none";
  });

  const target = document.querySelector(`.locationImage.locatio${a.code}`);

  if (target) {
    const img = target.querySelector("img");
    const tooltip = target.querySelector(".tooltip");

    img.classList.add("active");
    tooltip.style.display = "block";
  }

  document.getElementById("terminalAirportTitle").innerText =
    `${a.code} Terminal Details`;

  document.getElementById("terminalCards").innerHTML =
    a.terminals.map((t, j) => `
      <div class="terminal-card" onclick="showStores(${i},${j})">
        ${t.image ? `<img src="${t.image}" alt="">` : ""}
        <div class="card-name">${t.name}</div>
      </div>
    `).join("");

  const terminalSection = document.getElementById("terminalDetailSection");
  terminalSection.style.display = "block";

  document.getElementById("storeDetailSection").style.display = "none";
  const offset = -200; 

  const y =
    terminalSection.getBoundingClientRect().top +
    window.pageYOffset +
    offset;

  window.scrollTo({
    top: y,
    behavior: "smooth"
  });
};

window.showStores = (i,j) => {
  const t = airports[i].terminals[j];
  const storeCards = document.getElementById("storeCards");
  const isMobile = window.innerWidth <= 600;

  document.getElementById("storeTerminalTitle").innerText =
    t.name + " Store Details";

  if (storeSwiper) {
    storeSwiper.destroy(true,true);
    storeSwiper = null;
  }

  if ((!isMobile && t.stores.length > 5) || (isMobile && t.stores.length > 1)) {

    storeCards.innerHTML = `
      <div class="swiper store-swiper">
        <div class="swiper-wrapper">
          ${t.stores.map(s=>`
            <div class="swiper-slide">
              <div class="store-card">
                ${s.image ? `<img src="${s.image}" alt="">` : ""}
                <div class="card-name">${s.name}</div>
              </div>
            </div>
          `).join("")}
        </div>

       <div class="swiper_navbtn">
        <div class="swiper-button-prev"></div>
        <div class="swiper-button-next"></div>
       </div>
      </div>
    `;

    storeSwiper = new Swiper(".store-swiper", {
      slidesPerView: "auto",
      spaceBetween: 20,
      grabCursor: true,
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      }
    });

  } else {
    storeCards.innerHTML = t.stores.map(s=>`
      <div class="store-card">
        ${s.image ? `<img src="${s.image}" alt="">` : ""}
        <div class="card-name">${s.name}</div>
      </div>
    `).join("");
  }

  document.getElementById("storeDetailSection").style.display="block";
};
</script>

{% schema %}
{
  "name": "Store Locator",
  "settings": [],
  "presets": [{ "name": "Store Locator" }]
}
{% endschema %}
