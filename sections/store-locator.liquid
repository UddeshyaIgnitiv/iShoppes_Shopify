<div class="store-locator-section container" style="display: flex;">
<div id="airportList"></div>
<div id="airportmap"><img src="https://ishoppes.com/usa_map-e7A.png" width="90%" height="auto"></div>
</div>
<!-- Terminal Details Section -->
<div id="terminalDetailSection" class="terminal-section" style="display:none;">
  <h2 id="terminalAirportTitle"></h2>
  <div id="terminalCards" class="terminal-card-container"></div>
</div>

<style>
  /* Airport Card List */
  .airport-card {
    border: 1px solid #000;
    padding: 16px!important;
    border-radius: 10px;
    margin-bottom: 14px;
    font-family: Arial, sans-serif;
  }

  .container {
    width: 95%;
    margin: auto;
  }

  .store-locator-section div {
    padding: 10px 5px;
  }

  #airportList {
    width: 34%;
  }
  
  #airportmap {
    width: 66%;
  }

  #airportmap img {
    width: 90%;
    margin: auto;
  }

  .airport-card h3 {
    margin-bottom: 4px;
    font-size: 18px;
  }

  .airport-card p {
    margin-bottom: 12px;
    font-size: 1rem;
    font-family: "Montserrat", sans-serif;
    color: #444;
  }

  h1 {
    margin-bottom: 50px;
    border-bottom: 2px solid #c5caca;
    padding: 50px 0;
    position: relative;
    font-family: "Montserrat", sans-serif!important;
    font-weight: 500!important;
  }

  .airport-card button {
    background: black;
    color: white;
    padding: 10px 0;
    width: 100%;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    font-size: 15px;
  }

  /* Terminal Section */
  .terminal-section {
    border: 1px solid #ccc;
    padding: 20px;
    border-radius: 12px;
    margin-top: 20px;
    font-family: Arial, sans-serif;
  }

  .terminal-section h2 {
    margin-bottom: 20px;
    font-size: 22px;
  }

  .terminal-card-container {
    display: flex;
    flex-wrap: wrap;
    margin-top: 10px;
  }

  .terminal-card {
    width: 300px;
    height: 180px;
    margin-right: 20px;
    margin-bottom: 20px;
    border-radius: 10px;
    overflow: hidden;
    position: relative;
    background: #f5f5f5;
  }

  .terminal-card img {
    width: 100%;
    height: 180px;
    object-fit: cover;
  }

  .terminal-name {
    position: absolute;
    bottom: 10px;
    left: 10px;
    color: white;
    font-size: 18px;
    font-weight: bold;
    text-shadow: 2px 2px 4px black;
  }

  @media(max-width: 768px) {
    .terminal-card {
      width: 100%;
      height: 200px;
    }
    .terminal-card img {
      height: 200px;
    }
  }
</style>

<script>
document.addEventListener("DOMContentLoaded", function () {

  // will replace this with Airport detail API fetch later
  const airports = [
    {
      code: "BDL",
      city: "Hartford, CT",
      name: "Bradley International Airport",
      terminals: [
        {
          name: "Terminal A",
          image: "https://images.unsplash.com/photo-1504196606672-aef5c9cefc92"
        }
      ]
    },
    {
      code: "BWI",
      city: "Baltimore, MD",
      name: "International Thurgood Marshall Airport",
      terminals: [
        {
          name: "Terminal A",
          image: "https://images.unsplash.com/photo-1526779259212-939e64788e3c"
        },
        {
          name: "Terminal B",
          image: "https://images.unsplash.com/photo-1485313261925-22ede2e4863a"
        }
      ]
    },
    {
      code: "JFK",
      city: "Queens, NY",
      name: "John F. Kennedy International Airport",
      terminals: [
        {
          name: "Terminal 1",
          image: "https://images.unsplash.com/photo-1473187983305-f615310e7daa"
        }
      ]
    }
  ];

  const airportList = document.getElementById("airportList");

  // Render Airport Cards
  airports.forEach((airport, i) => {
    const html = `
      <div class="airport-card">
        <h3>${airport.code} - ${airport.city}</h3>
        <p>${airport.name}</p>
        <button onclick="showTerminalDetails(${i})">View Terminals</button>
      </div>
    `;
    airportList.innerHTML += html;
  });

  // Show Terminal Detail Section
  window.showTerminalDetails = function(index) {
    const airport = airports[index];

    // Update title
    document.getElementById("terminalAirportTitle").innerText =
      `${airport.code} Terminal Details`;

    // Render terminal images + names
    let terminalsHTML = "";
    airport.terminals.forEach(t => {
      terminalsHTML += `
        <div class="terminal-card">
          <img src="${t.image}" alt="${t.name}">
          <div class="terminal-name">${t.name}</div>
        </div>
      `;
    });

    document.getElementById("terminalCards").innerHTML = terminalsHTML;

    // Show the section
    document.getElementById("terminalDetailSection").style.display = "block";

    // Scroll into view smoothly
    document.getElementById("terminalDetailSection").scrollIntoView({
      behavior: "smooth"
    });
  };

});
</script>

{% schema %}
{
  "name": "Store Locator",
  "settings": [],
  "presets": [
    {
      "name": "Store Locator"
    }
  ]
}
{% endschema %}