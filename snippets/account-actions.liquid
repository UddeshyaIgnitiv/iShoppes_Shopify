<div class="account-actions">
  <div class="account-actions__main-menu">
    <header class="account-actions__header">
      <span class="account-actions__title h5" id="AccountHeaderTitle">
        {% if customer and customer.first_name != blank %}
          {{ 'content.account_title_personalized' | t: first_name: customer.first_name }}
        {% else %}
          {{ 'content.account_title' | t }}
        {% endif %}
      </span>
    </header>

    {% if customer.email %}
      <nav class="account-actions__nav">
        <ul class="account-actions__list">
          <li class="account-actions__list-item">
            <a
              href="{{ routes.account_url }}"
              class="account-actions__links button-secondarys"
              {% if autofocus_enabled and customer %}
                autofocus
              {% endif %}
            >
              <span class="account-actions__icons" aria-hidden="true"></span>
              {{ 'content.account_orders' | t }}
            </a>
          </li>

          <li class="account-actions__list-item">
            <a
              href="{{ routes.root_url }}apps/page/wishlist"
              class="account-actions__links button-secondarys"
            >
              <span class="account-actions__icon" aria-hidden="true"></span>
              {{ 'content.account_favorites' | t }}
            </a>
          </li>

          <li class="account-actions__list-item">
            <a
              href="{{ routes.account_addresses_url }}"
              class="account-actions__links button-secondarys"
            >
              <span class="account-actions__icon" aria-hidden="true"></span>
              {{ 'content.account_profile' | t }}
            </a>
          </li>

          <li class="account-actions__list-item">
            <a
              href="{{ routes.account_logout_url }}"
              class="account-actions__links button-secondarys"
            >
              <span class="account-actions__icon" aria-hidden="true"></span>
              {{ 'actions.log_out' | t }}
            </a>
          </li>
        </ul>
      </nav>
    {% endif %}

    <!-- Global login flag for JS (works everywhere) -->
    <script>
      window.__CUSTOMER_LOGGED_IN__ = {{ customer.id | default: 0 | json }} != 0;
    </script>

    {% unless customer %}
      <!-- ================= LOGIN BLOCK ================= -->
      <div class="account-actions__sign-ins" data-skip-subtree-update="true" id="LoginBlock">
        {% form 'customer_login', id: 'ClassicLoginForm' %}
          {% if form.errors %}
            <div class="form-errors" role="alert" aria-live="polite">
              <ul class="errors">
                {% for field in form.errors %}
                  <li>{{ form.errors.messages[field] }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          <div class="form-field">
            <label for="LoginEmail">Email address*</label>
            <input
              id="LoginEmail"
              class="input"
              type="email"
              name="customer[email]"
              value="{{ form.email | escape }}"
              autocomplete="email"
              required
              aria-required="true"
            >
          </div>

          <div class="form-field">
            <label for="LoginPassword">Password*</label>
            <input
              id="LoginPassword"
              class="input"
              type="password"
              name="customer[password]"
              autocomplete="current-password"
              required
              aria-required="true"
            >
          </div>

          <a href="#" id="ShowRecoverBtn" class="link" style="margin-inline-start:auto;">Forgot password?</a>

          <div class="form-actions">
            <button type="submit" class="account-actions__link button">SIGN IN</button>
            <button type="button" id="ShowRegisterBtn" class="account-actions__link button-secondary">CREATE AN ACCOUNT</button>
          </div>
        {% endform %}
      </div>

      <!-- ================= RECOVER BLOCK (CAPTCHA SAFE) ================= -->
      <div class="account-actions__sign-ins is-hidden" data-skip-subtree-update="true" id="RecoverBlock">
        {% form 'recover_customer_password', id: 'RecoverPasswordForm' %}

          <div class="form-field" id="RecoverEmailField">
            <label for="RecoverEmail">Email*</label>
            <input
              id="RecoverEmail"
              class="input"
              type="email"
              name="email"
              autocomplete="email"
              required
              aria-required="true"
            >
          </div>

          <!-- ✅ Shopify success (works with CAPTCHA because this is a real submit) -->
          {% if form.posted_successfully? %}
            <div id="RecoverAjaxSuccess" class="form-success" role="status" aria-live="polite">
              If an account exists for that email, you’ll receive a password reset email shortly.
            </div>
          {% else %}
            <div id="RecoverAjaxSuccess" class="form-success is-hidden" role="status" aria-live="polite">
              If an account exists for that email, you’ll receive a password reset email shortly.
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="form-errors" role="alert" aria-live="polite">
              <ul class="errors">
                {% for field in form.errors %}
                  <li>{{ form.errors.messages[field] }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          <div class="form-actions">
            <!-- ✅ MUST be submit so Shopify can attach CAPTCHA token -->
            <button type="submit" class="button" id="RecoverSubmitBtn">SEND RESET LINK</button>
            <button type="button" id="BackToLoginBtn" class="button-secondary">BACK TO LOGIN</button>
          </div>
        {% endform %}
      </div>

      <!-- ================= REGISTER BLOCK (HIDDEN) ================= -->
      <div class="account-actions__sign-ins is-hidden" data-skip-subtree-update="true" id="RegisterBlock">
        {% form 'create_customer', id: 'ClassicRegisterForm' %}
          {% if form.errors %}
            <div class="form-errors" role="alert" aria-live="polite">
              <ul class="errors">
                {% for field in form.errors %}
                  <li>{{ form.errors.messages[field] }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          <div class="form-field">
            <label for="RegFirst">First Name*</label>
            <input id="RegFirst" class="input" type="text" name="customer[first_name]" required aria-required="true">
          </div>

          <div class="form-field">
            <label for="RegLast">Last Name*</label>
            <input id="RegLast" class="input" type="text" name="customer[last_name]" required aria-required="true">
          </div>

          <div class="form-field">
            <label for="RegEmail">Email*</label>
            <input id="RegEmail" class="input" type="email" name="customer[email]" required aria-required="true" autocomplete="email">
          </div>

          <div class="form-field">
            <label for="RegCountry">Country of Origin or Residence*</label>
            <select id="RegCountry" class="input" required aria-required="true">
              <option value="" selected disabled>Select country</option>
              {{ all_country_option_tags }}
            </select>
          </div>

          <div class="form-field">
            <label for="RegMobile">Mobile Number*</label>
            <input
              id="RegMobile"
              class="input"
              type="text"
              name="reg_mobile"
              required
              aria-required="true"
              inputmode="numeric"
              autocomplete="tel"
              minlength="7"
              maxlength="15"
            >
            <p id="RegMobileError" class="field-error is-hidden" role="alert" aria-live="polite">
              Mobile Number is not valid
            </p>
          </div>

          <div class="form-field">
            <label for="RegPassword">Password*</label>
            <input id="RegPassword" class="input" type="password" name="customer[password]" required aria-required="true" autocomplete="new-password">
            <p id="RegPasswordError" class="field-error is-hidden" role="alert" aria-live="polite">
              Password must contain atleast 1 lowercase and 1 uppercase letter, 1 digit and a special character.
            </p>
          </div>

          <div class="form-field">
            <label for="RegTerminal">Terminal Number*</label>
            <select id="RegTerminal" class="input" required aria-required="true"></select>
          </div>

          <div class="form-field" style="gap:10px;">
            <label style="display:flex;align-items:center;gap:10px;">
              <input type="checkbox" id="RegMarketing" name="customer[accepts_marketing]" value="true">
              <span>Subscribe to news and updates</span>
            </label>
          </div>

          <input type="hidden" id="RegNote" name="customer[note]" value="">

          <div class="form-actions">
            <button type="button" id="RegisterSubmitBtn" class="button">CREATE AN ACCOUNT</button>
            <button type="button" id="CancelRegisterBtn" class="button-secondary">CANCEL</button>
          </div>
        {% endform %}
      </div>

      <script>
        async function loadAirports() {
          const res = await fetch('https://ishoppes.axiomconsulting.in/airports');
          const airlines = await res.json();

          const RegTerminal = document.getElementById('RegTerminal');
          RegTerminal.innerHTML = '';

          airlines.forEach(item => {
            const option = document.createElement('option');
            option.value = item.name;
            option.textContent = item.name;
            RegTerminal.appendChild(option);
          });
        }
        loadAirports();
      </script>

      <script>
        (function () {
          // ================= HEADER =================
          const headerTitleEl = document.getElementById('AccountHeaderTitle');
          const HEADER_DEFAULT = 'Sign-in or Create an Account';
          const HEADER_FORGOT  = 'Forgot password';

          function setHeader(text) {
            if (headerTitleEl) headerTitleEl.textContent = text;
          }

          // ================= BLOCKS =================
          const loginBlock = document.getElementById('LoginBlock');
          const registerBlock = document.getElementById('RegisterBlock');
          const recoverBlock = document.getElementById('RecoverBlock');

          const showRegisterBtn = document.getElementById('ShowRegisterBtn');
          const cancelRegisterBtn = document.getElementById('CancelRegisterBtn');
          const showRecoverBtn = document.getElementById('ShowRecoverBtn');
          const backToLoginBtn = document.getElementById('BackToLoginBtn');

          function showOnly(block) {
            [loginBlock, registerBlock, recoverBlock].forEach(el => el?.classList.add('is-hidden'));
            block?.classList.remove('is-hidden');
            block?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }

          // Initial header
          setHeader(HEADER_DEFAULT);

          // LOGIN -> REGISTER
          showRegisterBtn?.addEventListener('click', (e) => {
            e.preventDefault();
            setHeader(HEADER_DEFAULT);
            showOnly(registerBlock);
            document.getElementById('RegFirst')?.focus();
          });

          // REGISTER -> LOGIN
          cancelRegisterBtn?.addEventListener('click', (e) => {
            e.preventDefault();
            setHeader(HEADER_DEFAULT);
            showOnly(loginBlock);
            document.getElementById('LoginEmail')?.focus();
          });

          // LOGIN -> RECOVER
          showRecoverBtn?.addEventListener('click', (e) => {
            e.preventDefault();
            setHeader(HEADER_FORGOT);
            showOnly(recoverBlock);
            document.getElementById('RecoverEmail')?.focus();
          });

          // RECOVER -> LOGIN
          backToLoginBtn?.addEventListener('click', (e) => {
            e.preventDefault();
            setHeader(HEADER_DEFAULT);
            showOnly(loginBlock);

            // reset recover UI
            const success = document.getElementById('RecoverAjaxSuccess');
            success?.classList.add('is-hidden');

            const f = document.getElementById('RecoverEmailField');
            if (f) f.style.display = '';

            const btn = document.getElementById('RecoverSubmitBtn');
            if (btn) { btn.disabled = false; btn.textContent = 'SEND RESET LINK'; }

            document.getElementById('RecoverPasswordForm')?.reset();
            document.getElementById('LoginEmail')?.focus();
          });

          // ================= REGISTER VALIDATION + CONTROLLED SUBMIT =================
          const form = document.getElementById('ClassicRegisterForm');
          const submitBtn = document.getElementById('RegisterSubmitBtn');

          const RegCountry = document.getElementById('RegCountry');
          const RegTerminal = document.getElementById('RegTerminal');
          const RegMobile = document.getElementById('RegMobile');
          const RegPassword = document.getElementById('RegPassword');
          const RegNote = document.getElementById('RegNote');

          const RegMobileError = document.getElementById('RegMobileError');
          const RegPasswordError = document.getElementById('RegPasswordError');

          function showInlineError(input, errorEl) {
            if (errorEl) errorEl.classList.remove('is-hidden');
            input?.setAttribute('aria-invalid', 'true');
          }
          function hideInlineError(input, errorEl) {
            if (errorEl) errorEl.classList.add('is-hidden');
            input?.removeAttribute('aria-invalid');
          }

          RegCountry?.addEventListener('invalid', () => RegCountry.setCustomValidity('Please select a country.'));
          RegCountry?.addEventListener('change', () => RegCountry.setCustomValidity(''));

          RegTerminal?.addEventListener('invalid', () => RegTerminal.setCustomValidity('Please select a terminal.'));
          RegTerminal?.addEventListener('change', () => RegTerminal.setCustomValidity(''));

          RegMobile?.addEventListener('input', () => {
            RegMobile.value = RegMobile.value.replace(/[^0-9]/g, '');
            hideInlineError(RegMobile, RegMobileError);
          });

          RegPassword?.addEventListener('input', () => hideInlineError(RegPassword, RegPasswordError));

          function isValidMobile(v) { return /^[0-9]{7,15}$/.test(v); }
          function isValidPassword(v) {
            return /[a-z]/.test(v) && /[A-Z]/.test(v) && /[0-9]/.test(v) && /[^A-Za-z0-9]/.test(v);
          }

          function validateRegisterForm() {
            let ok = true;

            hideInlineError(RegMobile, RegMobileError);
            hideInlineError(RegPassword, RegPasswordError);

            if (form && !form.checkValidity()) {
              form.reportValidity();
              ok = false;
            }

            const mobile = (RegMobile?.value || '').trim();
            if (!isValidMobile(mobile)) { showInlineError(RegMobile, RegMobileError); ok = false; }

            const pw = (RegPassword?.value || '');
            if (!isValidPassword(pw)) { showInlineError(RegPassword, RegPasswordError); ok = false; }

            if (!ok) {
              if (RegMobile && !isValidMobile(mobile)) RegMobile.focus();
              else if (RegPassword && !isValidPassword(pw)) RegPassword.focus();
            }
            return ok;
          }

          function packNote() {
            const first = (document.getElementById('RegFirst')?.value || '').trim();
            const last  = (document.getElementById('RegLast')?.value || '').trim();
            const country = RegCountry?.value || '';
            const terminal = RegTerminal?.value || '';
            const mobile = (RegMobile?.value || '').trim();

            const parts = [
              `Country: ${country}`,
              `Mobile: ${mobile}`,
              `Terminal: ${terminal}`,
              `Name: ${first} ${last}`.trim()
            ];
            if (RegNote) RegNote.value = parts.filter(Boolean).join(' | ');
          }

          form?.addEventListener('submit', (e) => { e.preventDefault(); return false; });

          form?.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') { e.preventDefault(); submitBtn?.click(); }
          });

          submitBtn?.addEventListener('click', () => {
            const ok = validateRegisterForm();
            if (!ok) return;
            packNote();
            submitBtn.disabled = true;
            submitBtn.textContent = 'PLEASE WAIT...';
            form.submit();
          });

          /* ====================== RECOVER UX (CAPTCHA SAFE) ======================
             - MUST use real form submit (Shopify CAPTCHA requires token)
             - We only improve UX: disable button / show wait
             - If posted_successfully? message is present, we auto-reset after 4s
          ======================================================================= */
          (function recoverCaptchaSafe() {
            if (window.__RECOVER_CAPTCHA_SAFE_BIND__) return;
            window.__RECOVER_CAPTCHA_SAFE_BIND__ = true;

            const recoverForm  = document.getElementById('RecoverPasswordForm');
            const recoverBtn   = document.getElementById('RecoverSubmitBtn');
            const recoverEmail = document.getElementById('RecoverEmail');
            const ajaxSuccess  = document.getElementById('RecoverAjaxSuccess');
            const emailField   = document.getElementById('RecoverEmailField');

            if (!recoverForm || !recoverBtn) return;

            // If Shopify already shows success (posted_successfully?), hide email and auto reset
            const successVisible = ajaxSuccess && !ajaxSuccess.classList.contains('is-hidden');
            if (successVisible) {
              if (emailField) emailField.style.display = 'none';
              setTimeout(() => {
                recoverForm.reset();
                if (emailField) emailField.style.display = '';
                ajaxSuccess?.classList.add('is-hidden');
                recoverBtn.disabled = false;
                recoverBtn.textContent = 'SEND RESET LINK';
              }, 4000);
            }

            // Allow CAPTCHA submit: DO NOT preventDefault
            recoverForm.addEventListener('submit', function () {
              recoverBtn.disabled = true;
              recoverBtn.textContent = 'PLEASE WAIT...';
            });

            // On typing, restore button
            recoverEmail?.addEventListener('input', function () {
              recoverBtn.disabled = false;
              recoverBtn.textContent = 'SEND RESET LINK';
              if (ajaxSuccess) ajaxSuccess.classList.add('is-hidden');
              if (emailField) emailField.style.display = '';
            });
          })();

          // ====================== WISHLIST AUTH GUARD (APP INJECTED) ======================
          (function wishlistAuthGuard() {
            if (window.__CUSTOMER_LOGGED_IN__) return;

            const MSG = 'Please sign in to your account to see saved items.';

            function isWishlistUrl(href) {
              if (!href) return false;
              try {
                const url = new URL(href, window.location.origin);
                return url.pathname.replace(/\/+$/, '') === '/apps/page/wishlist';
              } catch (e) {
                return href.indexOf('/apps/page/wishlist') !== -1;
              }
            }

            function getToast() {
              let toast = document.getElementById('WishlistAuthToast');
              if (toast) return toast;

              toast = document.createElement('div');
              toast.id = 'WishlistAuthToast';
              toast.setAttribute('role', 'status');
              toast.setAttribute('aria-live', 'polite');
              toast.className = 'wishlist-auth-toast';
              document.body.appendChild(toast);
              return toast;
            }

            function showToast(msg) {
              const toast = getToast();
              toast.textContent = msg;
              toast.classList.add('is-visible');
              clearTimeout(toast._t);
              toast._t = setTimeout(() => toast.classList.remove('is-visible'), 3500);
            }

            function hideCounters() {
              document
                .querySelectorAll('.Vtl-WishlistHeader__HeartCounter')
                .forEach(el => el.style.display = 'none');
            }

            hideCounters();
            const mo = new MutationObserver(hideCounters);
            mo.observe(document.documentElement, { childList: true, subtree: true });

            document.addEventListener('click', function (e) {
              const t = e.target;

              const a = t?.closest?.('a');
              if (a && isWishlistUrl(a.getAttribute('href') || '')) {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation?.();
                showToast(MSG);
                return;
              }

              const plpBtn = t?.closest?.(
                '.Vtl-WishlistButton__WishlistIconButton, [class*="Vtl-WishlistIcon__Wrapper--Id-"]'
              );
              if (plpBtn) {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation?.();
                showToast(MSG);
                return;
              }

              const pdpBtn = t?.closest?.('.Vtl-WishlistButton__AddToWishlist, .Vtl-WishlistButtonWrapper');
              if (pdpBtn) {
                e.preventDefault();
                e.stopPropagation();
                e.stopImmediatePropagation?.();
                showToast(MSG);
                return;
              }
            }, true);
          })();

        })();
      </script>
    {% endunless %}
  </div>
</div>

{% stylesheet %}
  .form-errors.is-hidden { display: none !important; }

  /* Toast for wishlist auth */
  .wishlist-auth-toast{
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 999999;

    max-width: 340px;
    padding: 12px 14px;
    border-radius: 8px;

    background: #111;
    color: #fff;
    font-size: 13px;
    line-height: 1.4;

    box-shadow: 0 10px 30px rgba(0,0,0,.35);

    opacity: 0;
    transform: translateY(8px);
    pointer-events: none;

    transition: opacity .25s ease, transform .25s ease;
  }
  .wishlist-auth-toast.is-visible{
    opacity: 1;
    transform: translateY(0);
  }

  .form-success.is-hidden { display: none !important; }

  #account-popover{ width: 25%; }
  .account-actions { background-color: var(--color-background); display: flex; flex-direction: column; position: relative; transition: height var(--animation-values); &:has([data-active]) .account-actions__main-menu { visibility: hidden; } }
  .account-actions__header { padding: var(--padding-xl); display: flex; flex-direction: column; gap: var(--gap-2xs); }
  .account-actions__title { --font-h5--size: var(--font-size--lg); margin: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

  .account-actions__sign-ins {
    padding: var(--padding-xl);
    padding-block-start: 0;
    padding-block-end: var(--padding-md);
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    max-width: min(640px, 100%);
    width: 100%;
    box-sizing: border-box;
    margin-inline: auto;
    max-height: 75vh;
    overflow-y: auto;
    transition: opacity .25s ease;
    scrollbar-gutter: stable;
  }

  .account-actions__sign-ins.is-hidden { display: none !important; opacity: 0; pointer-events: none; }
  .account-actions__nav { padding: var(--padding-xl); padding-block-start: 0; }

  .account-actions__list { display: block; grid-template-columns: 1fr 1fr; gap: var(--gap-sm); width: 100%; list-style: none; margin: 0; padding: 0; }
  .account-actions__link { width: auto; display: flex; justify-content: center; align-items: center; gap: var(--gap-2xs); }
  .account-actions__icon { display: flex; width: var(--icon-size-sm); height: var(--icon-size-sm); margin-block: -4px; }

  .form-field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 1rem; }
  .form-field label { font-weight: 600; font-size: 0.9rem; }

  .form-field .input { padding: 0.6rem 0.8rem; border: 1px solid rgb(var(--color-foreground-rgb) / 0.3); border-radius: var(--style-border-radius-buttons-secondary); background: var(--color-background); width: 100%; box-sizing: border-box; }

  .form-errors { background: rgb(255 0 0 / 0.1); border: 1px solid red; color: red; padding: 0.5rem 1rem; border-radius: 4px; margin-bottom: 1rem; }

  .form-success { background: rgb(0 128 0 / 0.10); border: 1px solid rgb(0 128 0 / 0.35); color: rgb(0 80 0); padding: 0.5rem 1rem; border-radius: 4px; margin-bottom: 1rem; }

  .form-actions { display: flex; flex-direction: column; gap: 10px; margin-top: 1rem; align-items: stretch; }

  .form-actions .button,
  .form-actions .button-secondary { width: 100%; text-align: center; padding: 0.75rem 1rem; font-weight: 600; border-radius: var(--style-border-radius-buttons-primary); transition: all 0.2s ease-in-out; }

  .form-actions .button { background: #ffffff; color: #000000; border: 1px solid #000000; }
  .form-actions .button:hover { background: #f3f3f3; }

  .form-actions .button-secondary { background: #000000; color: #ffffff; border: 1px solid #000000; }
  .form-actions .button-secondary:hover { background: #222222; }

  .link { font-size: 0.9rem; text-decoration: underline; text-align: center; margin-top: .25rem; }

  .field-error { margin: 6px 0 0; font-size: 0.85rem; line-height: 1.2; color: #d10000; }
  .field-error.is-hidden { display: none !important; }

  .input[aria-invalid="true"] { border-color: #d10000; }

  .Vtl-WishlistProduct__AddToCart{ display: none; }
  .Vtl-WishlistPage .Vtl-WishlistPage__Title{ font-size: 30px; }
{% endstylesheet %}
