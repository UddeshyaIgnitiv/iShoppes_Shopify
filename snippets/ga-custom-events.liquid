{% comment %}
  GA4 ecommerce events for AB Google Analytics.
  view_category / view_item_list (collection), view_item (product), search, add_to_cart,
  begin_checkout (checkout button), purchase (when config.purchase is set).
  Purchase on Shopify Checkout is usually tracked by the AB Google Analytics app pixel.
{% endcomment %}

{% liquid
  assign ga_page_event = nil
  assign ga_search_term = nil
  assign ga_item_list_id = nil
  assign ga_item_list_name = nil
%}

{% if template.name == 'product' and product != blank %}
  {% assign ga_page_event = 'view_item' %}
  {% assign ga_variant = product.selected_or_first_available_variant %}
{% elsif template.name == 'collection' and collection != blank %}
  {% assign ga_page_event = 'view_item_list' %}
  {% assign ga_item_list_id = collection.id %}
  {% assign ga_item_list_name = collection.title %}
{% elsif template.name == 'search' %}
  {% assign ga_page_event = 'search' %}
  {% if search.performed %}
    {% assign ga_search_term = search.terms | escape %}
  {% endif %}
{% endif %}

{% liquid
  assign ga_is_home_page = false
  if template.name == 'index' or template.suffix == 'shopddf-home-page'
    assign ga_is_home_page = true
  endif
%}

<script>
  window.__gaCustomEventsConfig = {
    // This theme uses custom page templates with suffixes (e.g. `shopddf-home-page`)
    // so rely on either the default `index` template or our known home suffix.
    isHomePage: {{ ga_is_home_page | json }},
    pageType: {{ request.page_type | json }},
    templateName: {{ template.name | json }},
    templateSuffix: {{ template.suffix | json }},
    currency: {{ cart.currency.iso_code | default: shop.currency | json }},
    pageEvent: {{ ga_page_event | json }},
    searchTerm: {{ ga_search_term | json }},
    itemListId: {{ ga_item_list_id | json }},
    itemListName: {{ ga_item_list_name | json }},
    {% if template.name == 'product' and product != blank %}
    product: {
      id: {{ product.id | json }},
      title: {{ product.title | json }},
      vendor: {{ product.vendor | json }},
      type: {{ product.type | json }},
      url: {{ product.url | json }},
      variantId: {{ ga_variant.id | json }},
      variantTitle: {{ ga_variant.title | json }},
      sku: {{ ga_variant.sku | json }},
      price: {{ ga_variant.price | divided_by: 100.0 }},
      available: {{ ga_variant.available | json }}
    },
    {% endif %}
    {% if template.name == 'collection' and collection != blank %}
    collection: {
      id: {{ collection.id | json }},
      title: {{ collection.title | json }},
      handle: {{ collection.handle | json }}
    },
    listItems: [
      {% for item in collection.products limit: 30 %}
        {% assign v = item.selected_or_first_available_variant %}
        {
          item_id: {{ v.id | json }},
          item_name: {{ item.title | json }},
          item_brand: {{ item.vendor | json }},
          item_category: {{ item.type | json }},
          item_variant: {{ v.title | json }},
          price: {{ v.price | divided_by: 100.0 }},
          quantity: 1,
          index: {{ forloop.index0 }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ],
    {% endif %}
    {% if template.name == 'search' and search.performed %}
    searchItems: [
      {% assign ga_search_products = search.results | where: 'object_type', 'product' %}
      {% for item in ga_search_products limit: 30 %}
        {% assign v = item.selected_or_first_available_variant | default: item.variants.first %}
        {
          item_id: {{ v.id | json }},
          item_name: {{ item.title | json }},
          item_brand: {{ item.vendor | json }},
          item_category: {{ item.type | json }},
          price: {{ v.price | divided_by: 100.0 }},
          quantity: 1,
          index: {{ forloop.index0 }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ],
    {% endif %}
    cart: {
      total: {{ cart.total_price | divided_by: 100.0 }},
      itemCount: {{ cart.item_count | json }},
      items: [
        {% for item in cart.items %}
        {
          item_id: {{ item.variant_id | json }},
          item_name: {{ item.product.title | json }},
          item_brand: {{ item.vendor | json }},
          item_variant: {{ item.variant.title | json }},
          price: {{ item.final_price | divided_by: 100.0 }},
          quantity: {{ item.quantity | json }}
        }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  };
</script>
<script src="{{ 'ga-custom-events.js' | asset_url }}" defer></script>

{% comment %}
  Enhanced Ecommerce (UA/GTM-style) add_to_cart dataLayer push.
  This theme adds to cart over AJAX through the `product-form-component` web
  component (it calls event.preventDefault() on the form), so a classic
  `form[action="/cart/add"]` submit listener never fires. Instead we listen for
  the theme's `cart:update` success event and push the add_to_cart payload then.
  Only runs on the product template, where `product.handle` is available.
{% endcomment %}
{% if template.name == 'product' and product != blank %}
  <script>
    (function () {
      'use strict';
      function pushAddToCart(productData, quantity) {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: 'add_to_cart',
          ecommerce: {
            currencyCode: {{ shop.currency | json }},
            add: {
              products: [
                {
                  name: productData.name,
                  id: productData.sku || productData.id,
                  price: productData.price,
                  brand: productData.brand,
                  category: productData.category,
                  variant: productData.variant,
                  quantity: quantity,
                },
              ],
            },
          },
        });
      }
      var PRODUCT_HANDLE = {{ product.handle | json }};
      var PRODUCT_ID = {{ product.id | json }};
      document.addEventListener('cart:update', function (event) {
        var detail = (event && event.detail) || {};
        var data = detail.data || {};
        // Ignore failed adds and updates that did not originate from a product form.
        if (data.didError) return;
        if (data.source !== 'product-form-component') return;
        // Ignore quick-adds of other products that may exist on this page.
        if (data.productId && String(data.productId) !== String(PRODUCT_ID)) return;
        var variantId = String(detail.sourceId || data.variantId || '');
        var quantity = parseInt(data.itemCount, 10) || 1;
        fetch('/products/' + PRODUCT_HANDLE + '.js', { credentials: 'same-origin' })
          .then(function (res) {
            return res.json();
          })
          .then(function (product) {
            var variants = product.variants || [];
            var variant =
              variants.find(function (v) {
                return String(v.id) === variantId;
              }) || {};
            pushAddToCart(
              {
                name: product.title,
                sku: variant.sku,
                id: variant.id,
                price: (variant.price || 0) / 100,
                brand: product.vendor,
                // `/products/<handle>.js` does not expose collections, so use product type as the category.
                category: product.type || '',
                variant: variant.title,
              },
              quantity
            );
          })
          .catch(function () {
            /* network/parse failure - skip the push */
          });
      });
    })();
  </script>
{% endif %}

{% comment %}
  Enhanced Ecommerce (UA/GTM-style) remove_from_cart dataLayer push.
  Item removals and quantity decreases happen over AJAX through the
  `cart-items-component` web component (remove button + quantity selector going
  down), which fires a `cart:update` event that does not say which line changed.
  To know what was removed we keep a snapshot of the cart and, on every cart
  update, diff it against a fresh `/cart.js`. Any line whose quantity dropped is
  reported as remove_from_cart with the removed quantity. Runs on all pages so
  it also covers removals from the cart drawer.
{% endcomment %}
<script>
  (function () {
    'use strict';

    var CURRENCY = {{ shop.currency | json }};
    var snapshot = {};

    function mapLine(line) {
      return {
        name: line.product_title || line.title || '',
        id: line.sku || String(line.variant_id || line.id),
        price: (line.final_price != null ? line.final_price : line.price || 0) / 100,
        brand: line.vendor || '',
        category: line.product_type || '',
        variant: line.variant_title || '',
        quantity: Number(line.quantity) || 0,
      };
    }

    function buildSnapshot(cart) {
      var next = {};
      (cart.items || []).forEach(function (line) {
        next[line.key] = mapLine(line);
      });
      return next;
    }

    function pushRemoveFromCart(products) {
      if (!products.length) return;
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'remove_from_cart',
        ecommerce: {
          currencyCode: CURRENCY,
          remove: {
            products: products,
          },
        },
      });
    }

    function fetchCart() {
      return fetch('/cart.js', { credentials: 'same-origin' }).then(function (res) {
        return res.json();
      });
    }

    function reconcile(cart) {
      var next = buildSnapshot(cart);
      var removed = [];

      Object.keys(snapshot).forEach(function (key) {
        var before = snapshot[key];
        var after = next[key];
        var beforeQty = before.quantity;
        var afterQty = after ? after.quantity : 0;

        if (afterQty < beforeQty) {
          var product = {};
          for (var prop in before) {
            if (Object.prototype.hasOwnProperty.call(before, prop)) {
              product[prop] = before[prop];
            }
          }
          product.quantity = beforeQty - afterQty;
          removed.push(product);
        }
      });

      pushRemoveFromCart(removed);
      snapshot = next;
    }

    fetchCart()
      .then(function (cart) {
        snapshot = buildSnapshot(cart);
      })
      .catch(function () {
        /* ignore - snapshot stays empty */
      });

    document.addEventListener('cart:update', function (event) {
      var detail = (event && event.detail) || {};
      var data = detail.data || {};
      if (data.didError) return;

      fetchCart()
        .then(reconcile)
        .catch(function () {
          /* network/parse failure - skip */
        });
    });
  })();
</script>

{% comment %}
  Enhanced Ecommerce (UA/GTM-style) view_cart dataLayer push.
  Fires on the cart page load (server-rendered items so category can use the
  product's collection) and when the cart drawer is opened from the header cart
  icon (fetched from /cart.js). Matches the add_to_cart / remove_from_cart
  pushes so a single GTM trigger can map all cart events.
{% endcomment %}
<script>
  (function () {
    'use strict';

    var CURRENCY = {{ shop.currency | json }};

    function pushViewCart(products) {
      if (!products.length) return;
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: 'view_cart',
        ecommerce: {
          currencyCode: CURRENCY,
          detail: {
            products: products,
          },
        },
      });
    }

    function mapLine(line) {
      return {
        name: line.product_title || line.title || '',
        id: line.sku || String(line.variant_id || line.id),
        price: (line.final_price != null ? line.final_price : line.price || 0) / 100,
        brand: line.vendor || '',
        category: line.product_type || '',
        variant: line.variant_title || '',
        quantity: Number(line.quantity) || 0,
      };
    }

    {% if template.name == 'cart' %}
      pushViewCart([
        {% for item in cart.items %}
          {
            name: {{ item.product.title | json }},
            id: {{ item.sku | default: item.variant_id | json }},
            price: {{ item.final_price | divided_by: 100.0 }},
            brand: {{ item.product.vendor | json }},
            category: {{ item.product.collections.first.title | json }},
            variant: {{ item.variant.title | json }},
            quantity: {{ item.quantity }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]);
    {% endif %}

    document.addEventListener(
      'click',
      function (event) {
        var target = event.target;
        if (!(target instanceof Element)) return;

        var cartIcon = target.closest('.header-actions__cart-icon--has-cart');
        if (!cartIcon) return;

        // When the icon links to /cart it navigates there and the page-load
        // push above fires; only handle the drawer-open (no navigation) case.
        if (cartIcon.closest('a[href]')) return;

        fetch('/cart.js', { credentials: 'same-origin' })
          .then(function (res) {
            return res.json();
          })
          .then(function (cart) {
            pushViewCart((cart.items || []).map(mapLine));
          })
          .catch(function () {
            /* network/parse failure - skip */
          });
      },
      true
    );
  })();
</script>