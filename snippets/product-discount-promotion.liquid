{%- doc -%}
  Automatic discounts (amount off, Buy X Get Y, etc.) are not exposed on the product in Liquid or
  via cart.js until this variant exists as a cart line. This block uses read-only GET /cart.js to
  show live discount titles only when the current variant is already in the cart. For all other
  visitors (empty cart or product not yet added), set copy on the product metafield
  custom.discount_promotion_text, and optionally shop metafields.custom.discount_promotion_fallback
  for a store-wide default when the product metafield is empty. Match the wording to your automatic
  discount in Admin so the PDP matches checkout.
{%- enddoc -%}
{% comment %} {%- if closest.product.metafields.custom.active_discount_label != blank -%}
<product-discount-promotion
  class="product-discount-promotion"
  data-product-id="{{ product_for_promo.id }}"
  data-variant-id="{{ variant_for_promo.id }}"
  data-promo-prefix="{{ promo_prefix | escape }}"
>

    <div class="offer-text offer-text--placeholder" data-offer-source="metafield">
      <div class="offer-text__line">
          <span class="offer-text__prefix">Limited Time offers: {{ closest.product.metafields.custom.active_discount_label }}</span>
      </div>
    </div>
</product-discount-promotion>
{%-  endif -%} {% endcomment %}
{%- if closest.product.metafields.custom.active_discount_labels != blank -%}
<product-discount-promotion
  class="product-discount-promotion"
  data-product-id="{{ product_for_promo.id }}"
  data-variant-id="{{ variant_for_promo.id }}"
  data-promo-prefix="{{ promo_prefix | escape }}"
  data-discounts="{{ closest.product.metafields.custom.active_discount_labels | escape }}"
>
    {%- assign is_employee = false -%}
    {%- if customer -%}
      {%- if customer.tags contains 'Employee' or customer.tags contains 'employee' -%}
        {%- assign is_employee = true -%}
      {%- endif -%}
    {%- endif -%}
    {%- unless is_employee -%}
    <div class="offer-text offer-text--placeholder" data-offer-source="metafield">
      <div class="offer-text__discounts-container"></div>
    </div>
    {%- endunless -%}
    
</product-discount-promotion>

<script>
  (function() {
    const element = document.querySelector('product-discount-promotion');
    if (!element) return;
    
    const discountsData = element.dataset.discounts;
    if (!discountsData) return;
    
    try {
      // Parse the JSON data
      const discounts = JSON.parse(discountsData);
      
      const container = element.querySelector('.offer-text__discounts-container');
      if (!container) return;
      
      if (Array.isArray(discounts) && discounts.length > 0) {
        // Create HTML for each discount as a separate line
        let html = '';
        discounts.forEach(discount => {
          if(discount == 'BUY1SAVE17'){
            html += `
            <div class="offer-text__line">
              <span class="offer-text__prefix">Limited Time offer:</span>
              <span class="offer-text__discount">Buy 1 Save 17%. Use coupon code ${escapeHtml(discount)}</span>
            </div>
          `;
          }
          else if(discount == 'BUY1SAVE18'){
            html += `
            <div class="offer-text__line">
              <span class="offer-text__prefix">Limited Time offer:</span>
              <span class="offer-text__discount">Buy 1 Save 18%. Use coupon code ${escapeHtml(discount)}</span>
            </div>
          `;
          }
          else if(discount == 'BUY1 SAVE24'){
            html += `
            <div class="offer-text__line">
              <span class="offer-text__prefix">Limited Time offer:</span>
              <span class="offer-text__discount">Buy 1 Save 24%. Use coupon code ${escapeHtml(discount)}</span>
