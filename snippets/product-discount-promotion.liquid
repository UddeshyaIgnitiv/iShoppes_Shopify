            </div>
          `;
          }
          else if(discount == 'BUY3SAVE17'){
            html += `
            <div class="offer-text__line">
              <span class="offer-text__prefix">Limited Time offer:</span>
              <span class="offer-text__discount">Buy 3 Save 17%. Use coupon code ${escapeHtml(discount)}</span>
            </div>
          `;
          }
          else if(discount == 'BUY3SAVE18'){
            html += `
            <div class="offer-text__line">
              <span class="offer-text__prefix">Limited Time offer:</span>
              <span class="offer-text__discount">Buy 3 Save 18%. Use coupon code ${escapeHtml(discount)}</span>
            </div>
          `;
          }
          else if(discount == 'B3DEWARS25P' || discount == 'Buy6GET30'){
            html += ``;
          }
          else {
            html += `
              <div class="offer-text__line">
                <span class="offer-text__prefix">Limited Time offer:</span>
                <span class="offer-text__discount">${escapeHtml(discount)}</span>
              </div>
            `;
          }
        });
        container.innerHTML = html;
      }
      
      // Helper function to escape HTML
      function escapeHtml(str) {
        return str.replace(/[&<>]/g, function(m) {
          if (m === '&') return '&amp;';
          if (m === '<') return '&lt;';
          if (m === '>') return '&gt;';
          return m;
        });
      }
      
    } catch(e) {
      console.error('Failed to parse discounts:', e);
      // Fallback: show raw value
      const container = element.querySelector('.offer-text__discounts-container');
      if (container) {
        container.textContent = discountsData;
      }
    }
  })();
</script>
{%-  endif -%}