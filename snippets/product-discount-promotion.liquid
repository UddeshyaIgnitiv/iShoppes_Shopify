{%- doc -%}
  Automatic discounts (amount off, Buy X Get Y, etc.) are not exposed on the product in Liquid or
  via cart.js until this variant exists as a cart line. This block uses read-only GET /cart.js to
  show live discount titles only when the current variant is already in the cart. For all other
  visitors (empty cart or product not yet added), set copy on the product metafield
  custom.discount_promotion_text, and optionally shop metafields.custom.discount_promotion_fallback
  for a store-wide default when the product metafield is empty. Match the wording to your automatic
  discount in Admin so the PDP matches checkout.
{%- enddoc -%}
{{ closest.product }}
{%- liquid
  assign promo_prefix = promo_prefix | default: ''
  assign product_for_promo = product_for_promo | default: closest.product
  assign variant_for_promo = variant_for_promo | default: product_for_promo.selected_or_first_available_variant

  assign fallback_attr = ''
  assign mf_promo = product_for_promo.metafields.custom.discount_promotion_text
  if mf_promo != blank
    assign fallback_attr = mf_promo.value | default: mf_promo | strip
  endif
  if fallback_attr == blank
    assign mf_shop = shop.metafields.custom.discount_promotion_fallback
    if mf_shop != blank
      assign fallback_attr = mf_shop.value | default: mf_shop | strip
    endif
  endif
-%}

<product-discount-promotion
  class="product-discount-promotion"
  data-product-id="{{ product_for_promo.id }}"
  data-variant-id="{{ variant_for_promo.id }}"
  data-promo-prefix="{{ promo_prefix | escape }}"
  data-cart-js-url="{{ routes.cart_url | append: '.js' }}"
  {% if fallback_attr != blank %}
    data-fallback-text="{{ fallback_attr | escape }}"
  {% endif %}
  role="region"
  aria-live="polite"
>

  {{ product.metafields.custom.active_discount_label }}
  {%- if fallback_attr != blank -%}
    <div class="offer-text offer-text--placeholder" data-offer-source="metafield">
      <div class="offer-text__line">
        {%- if promo_prefix != blank -%}
          <span class="offer-text__prefix">{{ promo_prefix | escape }}</span>
        {%- endif -%}
        <span class="offer-text__body">{{ fallback_attr | escape }}</span>
      </div>
    </div>
  {%- endif -%}
</product-discount-promotion>
