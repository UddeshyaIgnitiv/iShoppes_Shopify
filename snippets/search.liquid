{%- doc -%}
  Renders the search action button.

  @param {string} [style] - The style of the search action.
  @param {string} [class] - Additional classes for the search action.

  @example
  {% render 'search', style: 'default', class: 'custom-class' %}
{%- enddoc -%}
<div>
{% unless style == 'none' %}
  <search-button class="search-action{% if class != blank %} {{ class | strip }}{% endif %}">
    <button
      on:click="#search-modal/showDialog"
      class="button button-unstyled search-modal__button header-actions__action"
      aria-label="{{ 'accessibility.open_search_modal' | t }}"
    >
      <span
        aria-hidden="true"
        class="svg-wrapper search-wrapper"
      >
        {{ 'icon-search.svg' | inline_asset_content }}
      </span>
    </button>
    {%- assign is_employee = false -%}
    {%- if customer -%}
      {%- if customer.tags contains 'Employee' or customer.tags contains 'employee' -%}
        {%- assign is_employee = true -%}
      {%- endif -%}
    {%- endif -%}
    {% if cart.attributes.Airport and cart.attributes.Airport != blank %}
    <div class="header-terminalInfo text-white terminal-update-btn font-medium js-terminal-info-display">
      <span class="js-terminal-info-text">
        {{ cart.attributes.Airport }}
      </span>
    </div>
  {%-  elsif is_employee -%}
    <div class="header-terminalInfo text-white terminal-update-btn font-medium js-terminal-info-display">
      <span class="js-terminal-info-text">
        {{ 'ShopDDF' }}
      </span>
    </div>
    {% else %}
    <div class="header-terminalInfoDefault terminal-select-btn js-terminal-info-default">
      <span>
        <img src="{{ 'plan.png' | asset_url }}" alt="Flight" class="flight-icon" width="25px" height="25px">
      </span>
    </div>
    {% endif %}
  </search-button>
  <script>
    {% comment %} (function() {
      function getCookie(name) {
        var value = "; " + document.cookie;
        var parts = value.split("; " + name + "=");
        if (parts.length == 2) return parts.pop().split(";").shift();
      }

      function updateTerminalInfo() {
        var airport = getCookie("Airport");
        // alert(airport);
        
        // Find all instances of the terminal info components
        var displays = document.querySelectorAll('.js-terminal-info-display');
        var defaults = document.querySelectorAll('.js-terminal-info-default');
        var texts = document.querySelectorAll('.js-terminal-info-text');

        if (airport) {
          var decodedAirport = decodeURIComponent(airport);
          // Hide defaults immediately
          defaults.forEach(function(el) { el.style.display = 'none'; });
          
          texts.forEach(function(el) { el.innerHTML = decodedAirport; });
          displays.forEach(function(el) { el.style.display = 'block'; });
        } else {
          displays.forEach(function(el) { el.style.display = 'none'; });
          defaults.forEach(function(el) { el.style.display = 'block'; });
        }
      }

      // Run immediately
      updateTerminalInfo();

      // Run periodically to handle hydration overwrites
      var checkCount = 0;
      var interval = setInterval(function() {
        updateTerminalInfo();
        checkCount++;
        if (checkCount > 20) clearInterval(interval); // Stop checking after 10 seconds
      }, 500);
      
      // Also run on DOM content loaded
      document.addEventListener('DOMContentLoaded', updateTerminalInfo);
    })(); {% endcomment %}
  </script>
{% endunless %}

            
</div>
{% stylesheet %}
  .header-terminalInfoDefault {
    background: #005eb8 !important;
    color: #fff !important;
    border-radius: 10px 0px 0px 10px !important;
    justify-self: end;
    padding: 12px 10px !important;
    text-transform: uppercase;
    font-weight: 300 !important;
    letter-spacing: normal !important;
    cursor: pointer;
    grid-area: 2 / 8 / 2 / 8 !important;
  }
  .search-wrapper > svg{
    width: 90% !important;
    height: 90% !important;
  }
  .header-terminalInfoDefault span {
    font-size: 11px;
    white-space: nowrap;
  }
  .flight-icon {
    height: 25px;
    width: 25px;
    max-width: 25px;
    transform: rotate(-90deg);
}
  .header-terminalInfo {
    background: #005eb8;
    color: #fff;
    border-radius: 10px 0px 0px 10px;
    justify-self: end;
    padding: 12px 10px;
    text-transform: uppercase;
    font-weight: 300;
    letter-spacing: normal;
    cursor: pointer;
  }
  .header-terminalInfo span {
    font-size: 11px;
    white-space: nowrap;
    font-weight: 500;
  }
  .search-action {
    gap: 3rem;
    --search-border-radius: var(--style-border-radius-inputs);
    --search-border-width: var(--style-border-width-inputs);

    display: flex;
    /* padding-right: 10px; */
  }

  .header__column--center .search-action {
    width: auto;
    flex-grow: 1;
  }

  :is(.header__column--left, .header__column--center) .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--padding-lg) * -1);
    }
  }

  .header__column--right .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--gap-md) * -1) calc(var(--gap-xs) * -1);
    }
  }
  @media (max-width: 768px) {
    .search-action {
      gap: 0rem;
      padding-right: 0px;
    }
  }
{% endstylesheet %}
