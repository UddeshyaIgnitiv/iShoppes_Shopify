{%- doc -%}
  Renders the search action button.

  @param {string} [style] - The style of the search action.
  @param {string} [class] - Additional classes for the search action.

  @example
  {% render 'search', style: 'default', class: 'custom-class' %}
{%- enddoc -%}
<div>
{% unless style == 'none' %}
  <search-button class="search-action{% if class != blank %} {{ class | strip }}{% endif %}">
    <button
      on:click="#search-modal/showDialog"
      class="button button-unstyled search-modal__button header-actions__action"
      aria-label="{{ 'accessibility.open_search_modal' | t }}"
    >
      <span
        aria-hidden="true"
        class="svg-wrapper search-wrapper"
      >
        {{ 'icon-search.svg' | inline_asset_content }}
      </span>
    </button>
    <div id="terminal-info-display" class="header-terminalInfo text-white font-medium">
      <span id="terminal-info-text">{{ decodeURIComponent(getCookie("Airport")) }}</span>
    </div>
    <div id="terminal-info-default" class="header-terminalInfoDefault terminal-select-btn" >
      <span>
        <img src="{{ 'plan.png' | asset_url }}" alt="Flight" class="flight-icon" width="25px" height="25px">
      </span>
    </div>
    <script>
      (function() {
        function getCookie(name) {
          var value = "; " + document.cookie;
          var parts = value.split("; " + name + "=");
          if (parts.length == 2) return parts.pop().split(";").shift();
        }
        var airport = getCookie("Airport");
        var displayDiv = document.getElementById("terminal-info-display");
        var defaultDiv = document.getElementById("terminal-info-default");
        var textSpan = document.getElementById("terminal-info-text");

        if (airport) {
        alert(airport);
          textSpan.textContent = decodeURIComponent(airport);
          displayDiv.style.display = "block";
          defaultDiv.style.display = "none";
        } else {
          displayDiv.style.display = "none";
          defaultDiv.style.display = "block";
        }
      })();
    </script>
  </search-button>
{% endunless %}

            
</div>
{% stylesheet %}
  .header-terminalInfoDefault {
    background: #005eb8;
    color: #fff;
    border-radius: 10px 0px 0px 10px;
    justify-self: end;
    padding: 12px 10px;
    text-transform: uppercase;
    font-weight: 300;
    letter-spacing: normal;
    cursor: pointer;
    grid-area: 2 / 8 / 2 / 8;
  }
  .search-wrapper > svg{
    width: 90% !important;
    height: 90% !important;
  }
  .header-terminalInfoDefault span {
    font-size: 11px;
    white-space: nowrap;
  }
  .flight-icon {
    height: 25px;
    width: 25px;
    max-width: 25px;
    transform: rotate(-90deg);
}
  .header-terminalInfo {
    background: #005eb8;
    color: #fff;
    border-radius: 10px 0px 0px 10px;
    justify-self: end;
    padding: 12px 10px;
    text-transform: uppercase;
    font-weight: 300;
    letter-spacing: normal;
    cursor: pointer;
  }
  .header-terminalInfo span {
    font-size: 11px;
    white-space: nowrap;
  }
  .search-action {
    gap: 3rem;
    --search-border-radius: var(--style-border-radius-inputs);
    --search-border-width: var(--style-border-width-inputs);

    display: flex;
    padding-right: 10px;
  }

  .header__column--center .search-action {
    width: auto;
    flex-grow: 1;
  }

  :is(.header__column--left, .header__column--center) .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--padding-lg) * -1);
    }
  }

  .header__column--right .search-action {
    @media screen and (min-width: 750px) {
      margin-inline: calc(var(--gap-md) * -1) calc(var(--gap-xs) * -1);
    }
  }
  @media (max-width: 768px) {
    .search-action {
      gap: 0rem;
      padding-right: 0px;
    }
  }
{% endstylesheet %}
