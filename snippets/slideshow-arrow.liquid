{%- doc -%}
  Custom slideshow arrow control
  Uses real angle-left/right icons (not chevrons) with white rounded background
{%- enddoc -%}

{%- liquid
  assign style = icon_style | default: 'arrow'
  assign shape = icon_shape | default: 'none'
  assign size = icon_size | default: 'medium'
  assign direction = action
-%}

<style>
/* --- Custom White Rounded Slideshow Arrows (Angle Icons) --- */
.custom-slideshow-arrow {
  background-color: #e0e0e0 !important; /* grey background */
  border-radius: 50%;
  width: 24px!important;
  height: 24px!important;
  min-width: 0 !important;
  min-height: 0 !important;
  padding: 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
  transition: all 0.25s ease;
  color: #000000 !important; /* black icon */
  border: none;
  cursor: pointer;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
}

/* Position arrows 10px from edges */
.custom-slideshow-arrow.slideshow-control--previous {
  left: 20px !important;
}

.custom-slideshow-arrow.slideshow-control--next {
  right: 20px !important;
}


.custom-slideshow-arrow:hover {
  background-color: #d0d0d0 !important;
  color: #000!important; /* icon turns black */
  transform: translateY(-50%) scale(1.05);
}

.custom-slideshow-arrow svg {
  width: 16px;
  height: 16px;
  fill: currentColor;
}
</style>

<button
  class="
    slideshow-control slideshow-control--{{ action }}
    slideshow-control--{{ size }}
    custom-slideshow-arrow
    button button-unstyled
  "
  style="background-color: #e0e0e0 !important; color: #000000 !important;"
  aria-label="{{ 'accessibility.slideshow_' | append: action | t }}"
  on:click="/{{ action }}"
  ref="{{ action }}"
>
  {% if action == 'previous' %}
    <span class="svg-wrapper icon-angle-left">
      <!-- True Angle Left Icon -->
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 512" aria-hidden="true">
        <path d="M192 448c-8.188 0-16.38-3.125-22.62-9.375l-160-160c-12.5-12.5-12.5-32.75 0-45.25l160-160c12.5-12.5 32.75-12.5 45.25 0s12.5 32.75 0 45.25L77.25 256l137.4 137.4c12.5 12.5 12.5 32.75 0 45.25C208.4 444.9 200.2 448 192 448z"/>
      </svg>
    </span>
  {% else %}
    <span class="svg-wrapper icon-angle-right">
      <!-- True Angle Right Icon -->
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 256 512" aria-hidden="true">
        <path d="M64 64c8.188 0 16.38 3.125 22.62 9.375l160 160c12.5 12.5 12.5 32.75 0 45.25l-160 160c-12.5 12.5-32.75 12.5-45.25 0s-12.5-32.75 0-45.25L178.8 256 41.37 118.6c-12.5-12.5-12.5-32.75 0-45.25C47.63 67.13 55.82 64 64 64z"/>
      </svg>
    </span>
  {% endif %}
</button>
