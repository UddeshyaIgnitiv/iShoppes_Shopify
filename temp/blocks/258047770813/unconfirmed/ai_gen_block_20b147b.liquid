{% doc %}
  @prompt
    i want yo create section. in a section I want two column with 1fr 3fr(width) . in first column we can add the slider and second column we can add slider
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-two-column-slider-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-two-column-slider__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: {{ block.settings.column_gap }}px;
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-two-column-slider__column-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-two-column-slider__slider-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.slider_height }}px;
  }

  .ai-two-column-slider__slides-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease;
    height: 100%;
  }

  .ai-two-column-slider__slide-{{ ai_gen_id }} {
    min-width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.slide_background }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-two-column-slider__slide-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-two-column-slider__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-two-column-slider__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-two-column-slider__controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 2;
  }

  .ai-two-column-slider__button-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ block.settings.button_color }};
    color: {{ block.settings.button_icon_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s ease;
  }

  .ai-two-column-slider__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
  }

  .ai-two-column-slider__button-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-two-column-slider__dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    z-index: 2;
  }

  .ai-two-column-slider__dot-{{ ai_gen_id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    cursor: pointer;
    transition: opacity 0.3s ease;
  }

  .ai-two-column-slider__dot-{{ ai_gen_id }}.active {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-two-column-slider__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.column_gap | times: 0.5 }}px;
    }

    .ai-two-column-slider__slider-{{ ai_gen_id }} {
      height: {{ block.settings.slider_height | times: 0.7 }}px;
    }
  }
{% endstyle %}

<two-column-slider-{{ ai_gen_id }} class="ai-two-column-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-two-column-slider__container-{{ ai_gen_id }}">
    <div class="ai-two-column-slider__column-{{ ai_gen_id }}">
      <div class="ai-two-column-slider__slider-{{ ai_gen_id }}" data-slider="left">
        <div class="ai-two-column-slider__slides-{{ ai_gen_id }}" data-slides>
          {% for i in (1..5) %}
            {% liquid
              assign image_key = 'left_image_' | append: i
              assign image = block.settings[image_key]
            %}
            {% if image != blank %}
              <div class="ai-two-column-slider__slide-{{ ai_gen_id }}">
                <img
                  src="{{ image | image_url: width: 800 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  class="ai-two-column-slider__slide-image-{{ ai_gen_id }}"
                >
              </div>
            {% endif %}
          {% endfor %}
          {% if block.settings.left_image_1 == blank and block.settings.left_image_2 == blank and block.settings.left_image_3 == blank and block.settings.left_image_4 == blank and block.settings.left_image_5 == blank %}
            <div class="ai-two-column-slider__slide-{{ ai_gen_id }}">
              <div class="ai-two-column-slider__placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            </div>
          {% endif %}
        </div>
        {% if block.settings.show_controls %}
          <div class="ai-two-column-slider__controls-{{ ai_gen_id }}">
            <button class="ai-two-column-slider__button-{{ ai_gen_id }}" data-prev aria-label="Previous slide">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button class="ai-two-column-slider__button-{{ ai_gen_id }}" data-next aria-label="Next slide">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        {% endif %}
        {% if block.settings.show_dots %}
          <div class="ai-two-column-slider__dots-{{ ai_gen_id }}" data-dots></div>
        {% endif %}
      </div>
    </div>

    <div class="ai-two-column-slider__column-{{ ai_gen_id }}">
      <div class="ai-two-column-slider__slider-{{ ai_gen_id }}" data-slider="right">
        <div class="ai-two-column-slider__slides-{{ ai_gen_id }}" data-slides>
          {% for i in (1..5) %}
            {% liquid
              assign image_key = 'right_image_' | append: i
              assign image = block.settings[image_key]
            %}
            {% if image != blank %}
              <div class="ai-two-column-slider__slide-{{ ai_gen_id }}">
                <img
                  src="{{ image | image_url: width: 1600 }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  class="ai-two-column-slider__slide-image-{{ ai_gen_id }}"
                >
              </div>
            {% endif %}
          {% endfor %}
          {% if block.settings.right_image_1 == blank and block.settings.right_image_2 == blank and block.settings.right_image_3 == blank and block.settings.right_image_4 == blank and block.settings.right_image_5 == blank %}
            <div class="ai-two-column-slider__slide-{{ ai_gen_id }}">
              <div class="ai-two-column-slider__placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            </div>
          {% endif %}
        </div>
        {% if block.settings.show_controls %}
          <div class="ai-two-column-slider__controls-{{ ai_gen_id }}">
            <button class="ai-two-column-slider__button-{{ ai_gen_id }}" data-prev aria-label="Previous slide">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6"></polyline>
              </svg>
            </button>
            <button class="ai-two-column-slider__button-{{ ai_gen_id }}" data-next aria-label="Next slide">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="9 18 15 12 9 6"></polyline>
              </svg>
            </button>
          </div>
        {% endif %}
        {% if block.settings.show_dots %}
          <div class="ai-two-column-slider__dots-{{ ai_gen_id }}" data-dots></div>
        {% endif %}
      </div>
    </div>
  </div>
</two-column-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class TwoColumnSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.sliders = [];
      }

      connectedCallback() {
        const sliderElements = this.querySelectorAll('[data-slider]');
        
        sliderElements.forEach((sliderEl) => {
          const slidesContainer = sliderEl.querySelector('[data-slides]');
          const slides = slidesContainer.querySelectorAll('.ai-two-column-slider__slide-{{ ai_gen_id }}');
          const prevButton = sliderEl.querySelector('[data-prev]');
          const nextButton = sliderEl.querySelector('[data-next]');
          const dotsContainer = sliderEl.querySelector('[data-dots]');
          
          if (slides.length === 0) return;

          const slider = {
            currentIndex: 0,
            slidesContainer: slidesContainer,
            slides: slides,
            totalSlides: slides.length,
            prevButton: prevButton,
            nextButton: nextButton,
            dotsContainer: dotsContainer,
            dots: []
          };

          if (dotsContainer) {
            for (let i = 0; i < slider.totalSlides; i++) {
              const dot = document.createElement('div');
              dot.classList.add('ai-two-column-slider__dot-{{ ai_gen_id }}');
              if (i === 0) dot.classList.add('active');
              dot.addEventListener('click', () => this.goToSlide(slider, i));
              dotsContainer.appendChild(dot);
              slider.dots.push(dot);
            }
          }

          if (prevButton) {
            prevButton.addEventListener('click', () => this.prevSlide(slider));
          }

          if (nextButton) {
            nextButton.addEventListener('click', () => this.nextSlide(slider));
          }

          this.sliders.push(slider);
        });

        {% if block.settings.autoplay %}
          this.startAutoplay();
        {% endif %}
      }

      goToSlide(slider, index) {
        slider.currentIndex = index;
        const offset = -index * 100;
        slider.slidesContainer.style.transform = `translateX(${offset}%)`;

        slider.dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      nextSlide(slider) {
        slider.currentIndex = (slider.currentIndex + 1) % slider.totalSlides;
        this.goToSlide(slider, slider.currentIndex);
      }

      prevSlide(slider) {
        slider.currentIndex = (slider.currentIndex - 1 + slider.totalSlides) % slider.totalSlides;
        this.goToSlide(slider, slider.currentIndex);
      }

      startAutoplay() {
        setInterval(() => {
          this.sliders.forEach((slider) => {
            this.nextSlide(slider);
          });
        }, {{ block.settings.autoplay_speed }} * 1000);
      }
    }

    customElements.define('two-column-slider-{{ ai_gen_id }}', TwoColumnSlider{{ ai_gen_id }});
  })();
</script>

