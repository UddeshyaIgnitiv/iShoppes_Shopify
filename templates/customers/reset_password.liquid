<section class="customer-reset">
  <div class="customer-reset__wrapper">
    <h1 class="customer-reset__title">Reset your password</h1>
    <p class="customer-reset__subtitle">Enter your new password below.</p>

    {% form 'reset_customer_password' %}
      {% if form.errors %}
        <div class="form-errors" role="alert" aria-live="polite">
          <ul class="errors">
            {% for field in form.errors %}
              <li>{{ form.errors.messages[field] }}</li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      <div class="form-field">
        <label for="ResetPassword">New Password*</label>
        <input
          id="ResetPassword"
          class="input"
          type="password"
          name="customer[password]"
          required
          autocomplete="new-password"
          aria-required="true"
          placeholder="Enter new password"
        >
      </div>

      <div class="form-field">
        <label for="ResetPasswordConfirm">Confirm Password*</label>
        <input
          id="ResetPasswordConfirm"
          class="input"
          type="password"
          name="customer[password_confirmation]"
          required
          autocomplete="new-password"
          aria-required="true"
          placeholder="Confirm new password"
        >
      </div>

      <div class="form-actions">
        <button type="submit" class="button-color-black">RESET PASSWORD</button>
        <a href="/account/login" class="button-secondary">CANCEL</a>
      </div>
    {% endform %}
  </div>
</section>

<style>
.customer-reset {
  display: flex;
  justify-content: center;
  padding: 4rem 1rem;
}

.customer-reset__wrapper {
  max-width: 420px;
  width: 100%;
  display: flex;
  flex-direction: column;
}

.customer-reset__title {
  text-align: center;
  margin-bottom: 0.25rem;
  font-size: 1.75rem;
  font-weight: 700;
}

.customer-reset__subtitle {
  text-align: center;
  color: #666;
  margin-bottom: 2rem;
}

.customer-reset .form-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-bottom: 1rem;
}

.customer-reset .form-field label {
  font-weight: 600;
  font-size: 0.9rem;
}

.customer-reset .input {
  padding: 0.6rem 0.8rem;
  border: 1px solid #ccc;
  border-radius: 8px;
  background: #fff;
}
.button-color-black {
  background: #fff;
  color: #000;
  border: 1px solid #000;
  padding: 0.75rem;
  font-weight: 600;
  border-radius: 8px;
  text-align: center;
  width: 100%;
  transition: all 0.2s ease-in-out;
}
.customer-reset .form-errors {
  background: rgba(255, 0, 0, 0.1);
  border: 1px solid red;
  color: red;
  padding: 0.5rem 1rem;
  border-radius: 4px;
  margin-bottom: 1rem;
}

.customer-reset .form-actions {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 1rem;
}

.customer-reset .button {
  {% comment %} background: #fff; {% endcomment %}
  color: #FFFFFF;
  border: 1px solid #000;
  padding: 0.75rem;
  font-weight: 600;
  border-radius: 8px;
  text-align: center;
  width: 100%;
  transition: all 0.2s ease-in-out;
}

.customer-reset .button:hover {
  background: #f3f3f3;
}

.customer-reset .button-secondary {
  background: #000;
  color: #fff;
  border: 1px solid #000;
  padding: 0.75rem;
  font-weight: 600;
  border-radius: 8px;
  text-align: center;
  width: 100%;
  transition: all 0.2s ease-in-out;
}

.customer-reset .button-secondary:hover {
  background: #222;
}
</style>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const form = document.querySelector('form[action*="reset"]');
  if (!form) return;

  const pass = document.getElementById('ResetPassword');
  const confirm = document.getElementById('ResetPasswordConfirm');

  form.addEventListener('submit', (e) => {
    if (pass.value !== confirm.value) {
      e.preventDefault();
      confirm.setCustomValidity('Passwords do not match');
      confirm.reportValidity();
    } else {
      confirm.setCustomValidity('');
    }
  });

  confirm.addEventListener('input', () => confirm.setCustomValidity(''));
});
</script>