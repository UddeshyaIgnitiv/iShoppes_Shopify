    "custom_liquid_4rc4RD": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "<script>\n  window.__PRODUCT_CONTEXT__ = {\n    sku: {{ product.selected_or_first_available_variant.sku | json }},\n    productId: {{ product.id | json }},\n    hasVariants: {{ product.variants.size | json }}\n  };\n\n  window.__PRODUCT_VARIANTS__ = {{ product.variants | json }};\n</script>\n\n<script>\n(function () {\n  document.addEventListener('DOMContentLoaded', function () {\n    console.log('running');\n    const API_URL = 'https://ishoppes.axiomconsulting.in/checkavailability';\n\n    function getProductSKU() {\n      if (window.__PRODUCT_VARIANTS__ && window.__PRODUCT_VARIANTS__.length) {\n        const variantId = document.querySelector('[name=\"id\"]')?.value;\n        const variant = window.__PRODUCT_VARIANTS__.find(\n          v => String(v.id) === String(variantId)\n        );\n        if (variant?.sku) return variant.sku;\n      }\n\n      if (window.__PRODUCT_CONTEXT__?.sku) {\n        return window.__PRODUCT_CONTEXT__.sku;\n      }\n\n      return null;\n    }\n\n    function hide(el) {\n      if (el) el.style.display = 'none';\n    }\n\n    function show(el) {\n      if (el) el.style.display = '';\n    }\n\n    const addToCartBtn = document.querySelector('.add-to-cart-button');\n    const terminalBtn  = document.querySelector('.terminal-select-btn');\n    if (!addToCartBtn || !terminalBtn) return;\n    hide(addToCartBtn);\n\n    fetch('/cart.js', { credentials: 'same-origin' })\n      .then(res => {\n        if (!res.ok) throw new Error('Failed to fetch cart');\n        return res.json();\n      })\n      .then(cart => {\n        const airport = cart?.attributes?.Airport;\n        console.log('Detected airport from cart:', airport);\n\n        if (!airport) {\n          terminalBtn.textContent = 'Select Terminal';\n          return;\n        }\n\n        const sku = getProductSKU();\n        console.log('SKU detected:', sku);\n\n        if (!sku) {\n          terminalBtn.textContent = 'Out of Stock';\n          return;\n        }\n\n        const url =\n          API_URL +\n          '?sku=' + encodeURIComponent(sku) +\n          '&airport=' + encodeURIComponent(airport);\n\n        console.log('Calling availability API:', url);\n\n        return fetch(url, {\n          method: 'GET',\n          credentials: 'omit'\n        });\n      })\n      .then(res => {\n        if (!res) return;\n        if (!res.ok) throw new Error('Availability API error');\n        return res.json();\n      })\n      .then(data => {\n        if (!data) return;\n\n        const inStock = data?.stock === true || data?.stock === 1;\n\n        if (inStock) {\n          show(addToCartBtn);\n          terminalBtn.textContent = 'In Stock';\n          terminalBtn.setAttribute('disabled', 'disabled');\n          terminalBtn.style.cursor = 'default';\n          terminalBtn.onclick = null;\n        } else {\n          hide(addToCartBtn);\n          terminalBtn.textContent = 'Out of Stock';\n        }\n      })\n      .catch(err => {\n        console.error('Availability check failed:', err);\n        hide(addToCartBtn);\n        terminalBtn.textContent = 'Out of Stock';\n      });\n  });\n})();\n</script>",
        "color_scheme": "",
        "section_width": "page-width",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    }
