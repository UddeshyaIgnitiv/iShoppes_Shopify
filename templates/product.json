    "vendor_description_section": {
      "type": "custom-liquid",
      "name": "Vendor Description",
      "settings": {
        "custom_liquid": "{% liquid\n  assign vendor_handle = product.vendor | handleize\n  assign vendor_collection = collections[vendor_handle]\n  assign vendor_description = product.metafields.custom.vendor_description | default: vendor_collection.description\n%}\n{% if vendor_description != blank %}\n  <div class=\"vendor-description\">\n    <h3 class=\"vendor-description__heading\">About This Brand</h3>\n    <div class=\"vendor-description__content rte\">\n      {{ vendor_description }}\n    </div>\n  </div>\n  {% if vendor_handle == 'dior' %}\n    <div class=\"dior-auth-retailer-pdp\">\n      <div class=\"dior-logo-box-pdp\">\n        <h3 class=\"dior-logo-title-pdp\">DIOR</h3>\n        <p class=\"dior-logo-subtitle-pdp\">AUTHORIZED RETAILER</p>\n      </div>\n    </div>\n  {% endif %}\n{% endif %}",
        "color_scheme": "",
